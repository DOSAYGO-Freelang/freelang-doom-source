credits: <../games/doom-wad.flx> <f/files> <f/bytes> <f/arrays>;

op doom_test_expect [condition, label] (
  if (condition == 1) () else (
    print "failed: ^{label}";
    fall "doom wad expectation failed";
  )
)

op doom_test_put_u16 [b, offset, value] (
  bytes_set[b, offset, value % 256];
  bytes_set[b, offset + 1, (value / 256) % 256];
  => 0;
)

op doom_test_put_u32 [b, offset, value] (
  bytes_set[b, offset, value % 256];
  bytes_set[b, offset + 1, (value / 256) % 256];
  bytes_set[b, offset + 2, (value / 65536) % 256];
  bytes_set[b, offset + 3, (value / 16777216) % 256];
  => 0;
)

op doom_test_put_name [b, offset, name] (
  let i = 0;
  while (i < 8) (
    let c = 0;
    if (i < str_len[name]) ( c = name\@i; )
    bytes_set[b, offset + i, c];
    i = i + 1;
  )
  => 0;
)

op doom_test_put_mus [b, offset] (
  bytes_set[b, offset, 77];
  bytes_set[b, offset + 1, 85];
  bytes_set[b, offset + 2, 83];
  bytes_set[b, offset + 3, 26];
  doom_test_put_u16[b, offset + 4, 0];
  doom_test_put_u16[b, offset + 6, 16];
  doom_test_put_u16[b, offset + 8, 1];
  doom_test_put_u16[b, offset + 10, 0];
  doom_test_put_u16[b, offset + 12, 0];
  doom_test_put_u16[b, offset + 14, 0];
  => 0;
)

let fixture = "doom-wad-fixture.tmp";
let data = bytes_new[92];
bytes_set[data, 0, 80]; bytes_set[data, 1, 87];
bytes_set[data, 2, 65]; bytes_set[data, 3, 68];
doom_test_put_u32[data, 4, 3];
doom_test_put_u32[data, 8, 44];
doom_test_put_mus[data, 12];
doom_test_put_mus[data, 28];
doom_test_put_u32[data, 44, 12]; doom_test_put_u32[data, 48, 16];
doom_test_put_name[data, 52, "D_TEST"];
doom_test_put_u32[data, 60, 28]; doom_test_put_u32[data, 64, 16];
doom_test_put_name[data, 68, "D_TEST"];
doom_test_put_u32[data, 76, 44]; doom_test_put_u32[data, 80, 0];
doom_test_put_name[data, 84, "E1M1"];
write_bytes[fixture, data];

let wad = doom_wad_inspect[fixture];
let loaded = doom_wad_load_named[fixture, wad, "D_TEST"];
let absent = doom_wad_load_named[fixture, wad, "GENMIDI"];
remove[fixture];
doom_test_expect[wad\ok == 1, "valid PWAD"];
doom_test_expect[wad\lump_count == 3, "lump count"];
doom_test_expect[wad\map_count == 1, "map marker"];
doom_test_expect[wad\zero_lumps == 1, "zero-size marker"];
doom_test_expect[wad\mus_lumps == 2, "physical MUS lumps"];
doom_test_expect[wad\music_overrides == 1, "last lump wins"];
doom_test_expect[arr_len[wad\music_tracks] == 1, "effective music count"];
doom_test_expect[wad\music_tracks\0\index == 1, "later music selected"];
doom_test_expect[wad\music_tracks\0\lump_offset == 28, "later music offset"];
doom_test_expect[wad\music_tracks\0\score_offset == 16, "MUS header"];
doom_test_expect[loaded\ok == 1, "named lump load"];
doom_test_expect[bytes_len[loaded\data] == 16, "named lump bytes"];
doom_test_expect[bytes_get[loaded\data, 0] == 77, "last named lump wins"];
doom_test_expect[absent\ok == 0, "absent named lump rejection"];

let oversized = "doom-wad-oversized.tmp";
let bad = bytes_new[12];
bytes_set[bad, 0, 73]; bytes_set[bad, 1, 87];
bytes_set[bad, 2, 65]; bytes_set[bad, 3, 68];
doom_test_put_u32[bad, 4, 65537];
doom_test_put_u32[bad, 8, 12];
write_bytes[oversized, bad];
let rejected = doom_wad_inspect[oversized];
remove[oversized];
doom_test_expect[rejected\ok == 0, "bounded directory rejection"];

print "doom wad parser ok";
