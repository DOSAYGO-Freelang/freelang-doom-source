// Pure menu transitions plus a one-pixel-per-slot atlas prove that Doom UI
// state and WAD patch composition remain deterministic without a window.

credits: <../games/doom-ui.flx> <f/buffers> <f/bytes> <f/gui>;

op doom_ui_test_expect [condition, label] (
  if (condition == 1) () else (
    print "failed: ^{label}";
    fall "doom UI expectation failed";
  )
)

op doom_ui_test_event [key] (
  => { kind: gui_ev_key_down[], a: key, b: 0, mods: 0 };
)

let ui = doom_ui_new_for_map["E1M1"];
ui = doom_ui_next[ui, [doom_ui_test_event[gui_key_esc[]]]];
doom_ui_test_expect[(ui\open == 1) and (ui\cursor == 0), "Escape opens menu"];
ui = doom_ui_next[ui, [doom_ui_test_event[gui_key_down[]]]];
ui = doom_ui_next[ui, [doom_ui_test_event[gui_key_return[]]]];
doom_ui_test_expect[
  (ui\open == 0) and (ui\selection == 2),
  "episode menu selects E1M2 without another page"
];
doom_ui_test_expect[
  string_eq[doom_ui_episode_selector[ui\selection], "E1M2"] == 1,
  "episode selection has one explicit map selector"
];
ui = doom_ui_next[ui, []];
doom_ui_test_expect[ui\selection == 0, "episode request lasts one frame"];

let wrap_ui = doom_ui_new_for_map["E1M2"];
wrap_ui = doom_ui_next[wrap_ui, [doom_ui_test_event[gui_key_esc[]]]];
wrap_ui = doom_ui_next[wrap_ui, [doom_ui_test_event[gui_key_down[]]]];
doom_ui_test_expect[
  wrap_ui\cursor == 0,
  "episode-only cursor wraps across exactly two playable maps"
];

let all_maps = [
  "E1M1", "E1M2", "E1M3", "E1M4", "E1M5", "E1M6", "E1M7", "E1M8", "E1M9",
  "E2M1", "E2M2", "E2M3"
];
let all_ui = doom_ui_new_for_maps[all_maps, "E1M1"];
all_ui = doom_ui_next[all_ui, [doom_ui_test_event[gui_key_esc[]]]];
let step = 0;
while (step < 8) (
  all_ui = doom_ui_next[all_ui, [doom_ui_test_event[gui_key_down[]]]];
  step = step + 1;
)
doom_ui_test_expect[
  (all_ui\cursor == 8) and (all_ui\top == 2),
  "checked map menu scrolls a seven-row window"
];
all_ui = doom_ui_next[all_ui, [doom_ui_test_event[gui_key_return[]]]];
doom_ui_test_expect[
  string_eq[doom_ui_map_selector[all_maps, all_ui\selection], "E1M9"] == 1,
  "checked map menu selects beyond the first episode"
];

let slots = doom_texture_ui_slots[];
let meta = buf_new[32, slots * 5];
let pixels = bytes_new[slots];
let opaque = bytes_new[slots];
let colours = buf_new[32, 8192];
let rgbx_colours = buf_new[32, 8192];
let i = 0;
while (i < slots) (
  buf_set[meta, i * 5, 1];
  buf_set[meta, i * 5 + 1, 1];
  buf_set[meta, i * 5 + 2, i];
  bytes_set[pixels, i, i % 256];
  bytes_set[opaque, i, 1];
  buf_set[colours, i % 256, 200 * 65536 + 100 * 256 + 50];
  buf_set[rgbx_colours, i % 256, 200 + 100 * 256 + 50 * 65536];
  i = i + 1;
)
let bank = {
  ui_ready: 1, ui_slots: slots, ui_meta: meta,
  ui_pixels: pixels, ui_opaque: opaque,
  colours: colours, rgbx_colours: rgbx_colours
};
let buf = gui_buffer[320, 200];
let loading = gui_buffer[320, 200];
doom_ui_test_expect[
  doom_ui_draw_loading[loading, 320, 200, gui_font[], "E1M9"] == 1,
  "asset-independent loading frame is drawable before WAD UI assets"
];
let background_pixels = 0;
let heading_pixels = 0;
let loading_pixels = 0;
let pi = 0;
while (pi < 320 * 200) (
  let po = pi * 4;
  let r = bytes_get[loading, po];
  let g = bytes_get[loading, po + 1];
  let b = bytes_get[loading, po + 2];
  if ((r == 14) and (g == 10) and (b == 12)) (
    background_pixels = background_pixels + 1;
  )
  if ((r == 190) and (g == 32) and (b == 24)) (
    heading_pixels = heading_pixels + 1;
  )
  if ((r == 218) and (g == 206) and (b == 172)) (
    loading_pixels = loading_pixels + 1;
  )
  pi = pi + 1;
)
doom_ui_test_expect[
  (background_pixels > 60000) and
  (heading_pixels > 0) and (loading_pixels > 0),
  "loading frame has bounded background, heading and selected map text"
];
doom_ui_test_expect[
  doom_ui_draw_patch[
    buf, 320, 200, bank, doom_texture_ui_logo_slot[], 10, 10
  ] == 1,
  "bounded WAD UI patch reaches the framebuffer"
];
let off = (10 * 320 + 10) * 4;
doom_ui_test_expect[
  (bytes_get[buf, off] == 200) and
  (bytes_get[buf, off + 1] == 100) and
  (bytes_get[buf, off + 2] == 50),
  "palette-indexed UI patch uses the shared colour table"
];
let large_buf = gui_buffer[640, 400];
let status_combat = {
  weapons: bytes_new[8], selected_weapon: 2,
  ammo: 50, shells: 0, rockets: 0, cells: 0,
  max_ammo: 200, max_shells: 50, max_rockets: 50, max_cells: 300,
  health: 100, armor: 0,
  tick: 0, player_pain_tick: 0 - 1000
};
bytes_set[status_combat\weapons, 2, 1];
let status_world = {
  pickup_tick: 0, pickup_message: "",
  blue_key: 1, yellow_key: 1, red_key: 1,
  blue_skull: 0, yellow_skull: 0, red_skull: 0
};
doom_ui_test_expect[
  doom_ui_face_slot[status_combat] ==
    doom_texture_ui_face_straight_slot[0, 0],
  "healthy status face begins in the first live idle frame"
];
status_combat\tick = 30;
doom_ui_test_expect[
  doom_ui_face_slot[status_combat] ==
    doom_texture_ui_face_straight_slot[0, 1],
  "status face idles independently of cached artwork"
];
status_combat\health = 55;
status_combat\player_pain_tick = 30;
doom_ui_test_expect[
  doom_ui_face_slot[status_combat] == doom_texture_ui_face_ouch_slot[2],
  "status face reacts in the current health tier"
];
status_combat\health = 0;
doom_ui_test_expect[
  doom_ui_face_slot[status_combat] == doom_texture_ui_face_dead_slot[],
  "status face has an explicit death frame"
];
status_combat\health = 100;
status_combat\tick = 0;
status_combat\player_pain_tick = 0 - 1000;
doom_ui_test_expect[
  doom_ui_draw_status[
    large_buf, 640, 400, bank, status_combat, status_world
  ] == 1,
  "status composition accepts the 640x400 logical raster"
];
let large_status = (336 * 640) * 4;
let large_status_diagonal = ((337 * 640) + 1) * 4;
doom_ui_test_expect[
  (bytes_get[large_buf, large_status] == 200) and
  (bytes_get[large_buf, large_status_diagonal] == 200),
  "canonical status pixels scale two by two from the lower-left edge"
];
let cached_large_buf = gui_buffer[640, 400];
let status_cache = doom_ui_status_cache_new[640, 400, bank];
doom_ui_test_expect[
  doom_ui_draw_status_cached[
    cached_large_buf, 640, 400, bank, status_cache,
    status_combat, status_world
  ] == 1,
  "cached status composition accepts the canonical raster"
];
let status_byte = large_status;
let status_equal = 1;
while (status_byte < bytes_len[large_buf]) (
  if (bytes_get[cached_large_buf, status_byte] ==
      bytes_get[large_buf, status_byte]) () else (
    status_equal = 0;
  )
  status_byte = status_byte + 1;
)
doom_ui_test_expect[
  status_equal == 1,
  "cached static strip plus live overlays matches direct composition"
];
let stable_redraws = status_cache\redraws;
doom_ui_draw_status_cached[
  cached_large_buf, 640, 400, bank, status_cache,
  status_combat, status_world
];
doom_ui_test_expect[
  status_cache\redraws == stable_redraws,
  "unchanged status presentation retains its persistent framebuffer suffix"
];
status_combat\ammo = status_combat\ammo - 1;
doom_ui_draw_status_cached[
  cached_large_buf, 640, 400, bank, status_cache,
  status_combat, status_world
];
doom_ui_test_expect[
  status_cache\redraws == stable_redraws + 1,
  "changed status authority reconstructs its cached strip exactly once"
];
status_combat\ammo = status_combat\ammo + 1;
ui = doom_ui_next[ui, [doom_ui_test_event[gui_key_esc[]]]];
doom_ui_test_expect[
  doom_ui_draw_menu[buf, 320, 200, bank, ui] == 1,
  "open menu composes entirely in Freelang"
];
// Reuse the already-measured 640x400 owner: this test intentionally runs on
// the small default heap and must not retain a third full-frame fixture merely
// to prove menu scaling.
gui_fill[large_buf, 0];
doom_ui_test_expect[
  (doom_ui_draw_menu[large_buf, 640, 400, bank, ui] == 1) and
  (doom_ui_text_width_scaled[bank, "E1M1", 2, 1] ==
   doom_ui_text_width[bank, "E1M1"] * 2),
  "menu glyph geometry follows the logical-raster scale"
];
let large_logo_top_left = (20 * 640 + 319) * 4;
let large_logo_bottom_right = (21 * 640 + 320) * 4;
doom_ui_test_expect[
  (bytes_get[large_buf, large_logo_top_left] == 200) and
  (bytes_get[large_buf, large_logo_bottom_right] == 200),
  "scaled menu patch covers the complete two-by-two logical block"
];

print "doom UI state ok";
