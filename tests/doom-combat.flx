// The combat fold is deterministic and filesystem/window independent. This
// fixture pins every admitted enemy phase, player resources and atlas mapping.

credits: <../games/doom-combat.flx> <f/bytes> <f/trig> <f/strings>;

op doom_combat_test_expect [condition, label] (
  if (condition == 1) () else (
    print "failed: ^{label}";
    fall "doom combat expectation failed";
  )
)

op doom_combat_test_u16 [b, offset, value] (
  let stored = value;
  if (stored < 0) ( stored = stored + 65536; )
  bytes_set[b, offset, stored % 256];
  bytes_set[b, offset + 1, (stored / 256) % 256];
  => 0;
)

let vertices = bytes_new[16];
doom_combat_test_u16[vertices, 0, 0];
doom_combat_test_u16[vertices, 2, 0];
doom_combat_test_u16[vertices, 4, 200];
doom_combat_test_u16[vertices, 6, 0];
doom_combat_test_u16[vertices, 8, 200];
doom_combat_test_u16[vertices, 10, 200];
doom_combat_test_u16[vertices, 12, 0];
doom_combat_test_u16[vertices, 14, 200];

let lines = bytes_new[56];
let i = 0;
while (i < 4) (
  let off = i * 14;
  doom_combat_test_u16[lines, off, i];
  doom_combat_test_u16[lines, off + 2, (i + 1) % 4];
  doom_combat_test_u16[lines, off + 10, 0];
  doom_combat_test_u16[lines, off + 12, 65535];
  i = i + 1;
)

let things = bytes_new[40];
doom_combat_test_u16[things, 0, 50];
doom_combat_test_u16[things, 2, 50];
doom_combat_test_u16[things, 4, 0];
doom_combat_test_u16[things, 6, 1];
doom_combat_test_u16[things, 8, 7];
doom_combat_test_u16[things, 10, 150];
doom_combat_test_u16[things, 12, 50];
doom_combat_test_u16[things, 14, 180];
doom_combat_test_u16[things, 16, 3004];
doom_combat_test_u16[things, 18, 7];
doom_combat_test_u16[things, 20, 100];
doom_combat_test_u16[things, 22, 150];
doom_combat_test_u16[things, 24, 0];
doom_combat_test_u16[things, 26, 2035];
doom_combat_test_u16[things, 28, 7];
doom_combat_test_u16[things, 30, 170];
doom_combat_test_u16[things, 32, 150];
doom_combat_test_u16[things, 34, 0];
doom_combat_test_u16[things, 36, 84];
doom_combat_test_u16[things, 38, 7];

let base = doom_map_parse["COMBAT", vertices, lines, things];
doom_combat_test_expect[base\ok == 1, "base map"];
// One leaf/sector is sufficient for collision-aware movement inside the
// already validated solid square.
let map = base + {
  bsp_ready: 1, node_count: 0, nodes: %32[],
  subsector_count: 1, subsectors: %32[0, 0, 0],
  sectors: %32[0, 128, 160, 0, 0],
  line_sides: buf_new[32, base\line_count * 4]
};

let combat = doom_combat_new[map];
doom_combat_test_expect[
  (doom_combat_actor_move_blocked[map, 180, 50, 182, 50] == 0) and
  (doom_combat_actor_move_blocked[map, 182, 50, 184, 50] == 1),
  "actor radius stops before its billboard anchor reaches a wall"
];
doom_combat_test_expect[
  (combat\enemy_count == 1) and (combat\health == 100) and
  (combat\unsupported_enemies == 1) and
  (arr_len[combat\barrels] == 1) and
  (combat\ammo == 50) and (combat\armor == 0) and
  (combat\max_ammo == 200) and (combat\kills == 0),
  "explicit player resources"
];

let prior_inventory = doom_combat_new[map];
prior_inventory\health = 147;
prior_inventory\armor = 83;
prior_inventory\backpack = 1;
prior_inventory\max_ammo = 400;
prior_inventory\max_shells = 100;
prior_inventory\max_rockets = 100;
prior_inventory\max_cells = 600;
prior_inventory\ammo = 311;
prior_inventory\shells = 71;
prior_inventory\rockets = 29;
prior_inventory\cells = 407;
bytes_set[prior_inventory\weapons, 3, 1];
bytes_set[prior_inventory\weapons, 5, 1];
bytes_set[prior_inventory\weapons, 7, 1];
prior_inventory\selected_weapon = 5;
prior_inventory\berserk = 1;
prior_inventory\invulnerability_tick = 90;
prior_inventory\invisibility_tick = 120;
prior_inventory\radiation_tick = 150;
prior_inventory\light_tick = 180;
prior_inventory\shot_cooldown = 4;
prior_inventory\shots = 9;
prior_inventory\dry_fires = 2;
prior_inventory\weapon_switches = 3;
prior_inventory\tick = 17;
doom_combat_validate[map, prior_inventory];

let carried = doom_combat_carry_inventory[
  map, doom_combat_new[map], map, prior_inventory
];
doom_combat_test_expect[
  (carried\health == 147) and (carried\armor == 83) and
  (carried\backpack == 1) and
  (carried\max_ammo == 400) and (carried\max_shells == 100) and
  (carried\max_rockets == 100) and (carried\max_cells == 600) and
  (carried\ammo == 311) and (carried\shells == 71) and
  (carried\rockets == 29) and (carried\cells == 407) and
  (doom_combat_weapon_owned[carried, 3] == 1) and
  (doom_combat_weapon_owned[carried, 5] == 1) and
  (doom_combat_weapon_owned[carried, 7] == 1) and
  (carried\selected_weapon == 5),
  "session map change carries durable player inventory"
];
doom_combat_test_expect[
  (carried\berserk == 0) and (carried\invulnerability_tick == 0) and
  (carried\invisibility_tick == 0) and
  (carried\radiation_tick == 0) and (carried\light_tick == 0) and
  (carried\shot_cooldown == 0) and (carried\shots == 0) and
  (carried\dry_fires == 0) and (carried\weapon_switches == 0) and
  (carried\tick == 0) and (arr_len[carried\projectiles] == 0) and
  (carried\kills == 0) and (carried\damage_taken == 0),
  "session map change resets temporary and map-local combat state"
];
bytes_set[carried\weapons, 3, 0];
doom_combat_test_expect[
  bytes_get[prior_inventory\weapons, 3] == 1,
  "carried weapon ownership has a fresh measured owner"
];

// These pure presenter checks pin the ordering and tic boundaries from
// linuxdoom's S_PISTOL*, S_SGUN*, S_CHAIN*, S_MISSILE*, S_PLASMA* and
// S_BFG* state tables. Gameplay cooldowns stay bounded, but a flash may not
// precede its vanilla wind-up or overlap a later recoil/pump state.
let psprite = doom_combat_new[map];
psprite\shots = 1;
psprite\selected_weapon = 2;
psprite\shot_cooldown = 10;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 625) and
  (doom_combat_muzzle_slot[psprite] == 0 - 1),
  "pistol holds PISGA dark for its four-tic wind-up"
];
psprite\shot_cooldown = 6;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 626) and
  (doom_combat_muzzle_slot[psprite] == 974),
  "pistol flash begins with its firing body frame"
];

psprite\selected_weapon = 3;
psprite\shot_cooldown = 24;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 630) and
  (doom_combat_muzzle_slot[psprite] == 0 - 1),
  "shotgun begins with the three-tic dark SHTGA wind-up"
];
psprite\shot_cooldown = 21;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 630) and
  (doom_combat_muzzle_slot[psprite] == 975),
  "shotgun first flash remains on SHTGA"
];
psprite\shot_cooldown = 17;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 630) and
  (doom_combat_muzzle_slot[psprite] == 976),
  "shotgun second flash still precedes recoil"
];
psprite\shot_cooldown = 14;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 631) and
  (doom_combat_muzzle_slot[psprite] == 0 - 1),
  "shotgun recoil begins only after both flash states"
];
psprite\shot_cooldown = 9;
doom_combat_test_expect[
  doom_combat_weapon_slot[psprite] == 632,
  "shotgun pump reaches SHTGC"
];
psprite\shot_cooldown = 4;
doom_combat_test_expect[
  doom_combat_weapon_slot[psprite] == 633,
  "shotgun pump reaches SHTGD"
];

psprite\selected_weapon = 4;
psprite\shot_cooldown = 4;
psprite\shots = 1;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 634) and
  (doom_combat_muzzle_slot[psprite] == 977),
  "first chaingun shot begins on body and flash A"
];
psprite\shots = 2;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 635) and
  (doom_combat_muzzle_slot[psprite] == 978),
  "second chaingun shot advances body and flash together"
];

psprite\selected_weapon = 5;
psprite\shot_cooldown = 30;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 637) and
  (doom_combat_muzzle_slot[psprite] == 979),
  "rocket firing body and MISFA begin together"
];
psprite\shot_cooldown = 27;
doom_combat_test_expect[
  doom_combat_muzzle_slot[psprite] == 980,
  "rocket flash advances to MISFB after three tics"
];
psprite\shot_cooldown = 23;
doom_combat_test_expect[
  doom_combat_muzzle_slot[psprite] == 981,
  "rocket flash advances to MISFC after four more tics"
];
psprite\shot_cooldown = 19;
doom_combat_test_expect[
  doom_combat_muzzle_slot[psprite] == 982,
  "rocket flash advances to MISFD after four more tics"
];
psprite\shot_cooldown = 15;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 637) and
  (doom_combat_muzzle_slot[psprite] == 0 - 1),
  "rocket body persists after the complete flash sequence"
];

psprite\selected_weapon = 6;
psprite\shots = 1;
psprite\shot_cooldown = 4;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 638) and
  (doom_combat_muzzle_slot[psprite] == 983),
  "first plasma shot begins on PLSGA and flash A"
];
psprite\shot_cooldown = 1;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 639) and
  (doom_combat_muzzle_slot[psprite] == 983),
  "plasma body enters refire without changing its flash phase"
];
psprite\shots = 2;
psprite\shot_cooldown = 4;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 638) and
  (doom_combat_muzzle_slot[psprite] == 984),
  "next plasma shot restarts PLSGA with the alternate bounded flash"
];

psprite\selected_weapon = 7;
psprite\shot_cooldown = 30;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 640) and
  (doom_combat_muzzle_slot[psprite] == 0 - 1),
  "BFG begins with its twenty-tic dark charge"
];
psprite\shot_cooldown = 11;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 640) and
  (doom_combat_muzzle_slot[psprite] == 0 - 1),
  "BFG remains dark through the last charge tic"
];
psprite\shot_cooldown = 10;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 641) and
  (doom_combat_muzzle_slot[psprite] == 985),
  "BFG flash begins only after the charge"
];
psprite\shot_cooldown = 3;
doom_combat_test_expect[
  (doom_combat_weapon_slot[psprite] == 641) and
  (doom_combat_muzzle_slot[psprite] == 986),
  "BFG completes on its second flash frame"
];

let actor = combat\actors\\0;
doom_combat_test_expect[
  actor\phase == DoomEnemyPhase\Dormant,
  "enemy begins dormant"
];
doom_combat_test_expect[
  (doom_combat_actor_position_blocked[
     map, combat, actor, 81, 50, 50, 50, 0
   ] == 1) and
  (doom_combat_actor_position_blocked[
     map, combat, actor, 82, 50, 50, 50, 0
   ] == 0),
  "monster and player radii may touch but never overlap"
];
doom_combat_test_expect[
  (doom_combat_vertical_overlap[0, 56, 55, 56] == 1) and
  (doom_combat_vertical_overlap[0, 56, 56, 56] == 0),
  "body collision requires vertical overlap rather than only XY overlap"
];
let other = actor + { thing: 99, x: 120, y: 50 };
let pair = combat + {
  actors: combat\actors + [other], enemy_count: 2
};
doom_combat_test_expect[
  doom_combat_actor_position_blocked[
    map, pair, actor, 89, 50, 0, 0, 0
  ] == 1,
  "live monsters are solid to one another"
];

combat = doom_combat_tick[map, combat, 50, 50];
doom_combat_test_expect[
  (actor\phase == DoomEnemyPhase\Chase) and
  (combat\monster_alert_serial == 1) and
  (combat\monster_alert_kind == 3004) and
  (string_eq[doom_combat_actor_phase_name[actor], "chase"] == 1),
  "bounded sight wakes enemy and reports its sound event"
];
actor\attack_cooldown = 4;
i = 0;
while (i < 3) (
  combat = doom_combat_tick[map, combat, 50, 50];
  i = i + 1;
)
doom_combat_test_expect[
  (actor\x == 148) and (actor\angle == 180),
  "chase step is collision checked and faces the player"
];

actor\x = 80;
actor\attack_cooldown = 0;
combat = doom_combat_tick[map, combat, 50, 50];
doom_combat_test_expect[
  actor\phase == DoomEnemyPhase\Attack,
  "nearby awake enemy enters attack"
];
i = 0;
while (i < 8) (
  combat = doom_combat_tick[map, combat, 50, 50];
  i = i + 1;
)
doom_combat_test_expect[
  (combat\health == 88) and (combat\damage_taken == 12) and
  (combat\monster_attack_serial == 1) and
  (combat\monster_attack_kind == 3004) and
  (combat\player_pain_serial == 1) and
  (combat\player_pain_tick >= 0) and
  (combat\tick - combat\player_pain_tick < 18),
  "former-human hitscan damage and both sound events are explicit and bounded"
];

combat = doom_combat_fire[
  map, combat, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (actor\phase == DoomEnemyPhase\Pain) and (actor\health == 10) and
  (combat\monster_pain_serial == 1) and
  (combat\monster_pain_kind == 3004) and
  (combat\ammo == 49) and (combat\shot_cooldown == 10) and
  (doom_combat_actor_sprite_slot[actor, 5] == 52) and
  (doom_combat_weapon_slot[combat] == 625) and
  (doom_combat_muzzle_slot[combat] == 0 - 1),
  "first shot consumes ammo and begins the pistol wind-up"
];
combat = doom_combat_fire[
  map, combat, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (combat\ammo == 49) and (combat\shots == 1),
  "cooldown rejects repeated fire without hidden consumption"
];

i = 0;
while (i < 10) (
  combat = doom_combat_tick[map, combat, 50, 50];
  i = i + 1;
)
doom_combat_test_expect[
  (combat\shot_cooldown == 0) and
  (actor\phase == DoomEnemyPhase\Chase),
  "pain and shot cooldown resolve independently"
];
combat = doom_combat_fire[
  map, combat, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (actor\phase == DoomEnemyPhase\Death) and (actor\health == 0) and
  (combat\monster_death_serial == 1) and
  (combat\monster_death_kind == 3004) and
  (combat\kills == 1) and (combat\ammo == 48) and
  (arr_len[combat\drops] == 1) and
  (combat\drops\0\kind == 2007) and (combat\drops\0\alive == 1) and
  (bytes_get[combat\alive, actor\thing] == 0) and
  (doom_combat_actor_sprite_slot[actor, 5] == 64),
  "second shot enters death and retires target authority"
];
i = 0;
while (i < 35) (
  combat = doom_combat_tick[map, combat, 50, 50];
  i = i + 1;
)
doom_combat_test_expect[
  (actor\phase_tick == 25) and
  (doom_combat_actor_sprite_slot[actor, 1] == 68) and
  (doom_combat_weapon_slot[combat] == 625) and
  (doom_combat_validate[map, combat] == 1),
  "death animation terminates on the regular corpse frame"
];

let barrel_combat = doom_combat_new[map];
let barrel_target = doom_combat_hitscan[
  map, barrel_combat, 50, 150, trig_from_degrees[0], 1024
];
doom_combat_test_expect[
  (barrel_target\kind == 2) and (barrel_target\index == 0) and
  (barrel_target\distance == 50),
  "hitscan admits the nearest live toxic barrel as an explicit target"
];
barrel_combat\barrels\0\health = 10;
barrel_combat = doom_combat_fire[
  map, barrel_combat, 50, 150, trig_from_degrees[0]
];
doom_combat_test_expect[
  (barrel_combat\barrels\0\health == 0) and
  (barrel_combat\barrels\0\state == 2) and
  (barrel_combat\barrels\0\phase_tick == 1) and
  (barrel_combat\explosion_serial == 1) and
  (barrel_combat\actors\0\health == 0) and
  (barrel_combat\kills == 1) and
  (barrel_combat\misses == 0),
  "one lethal pistol shot destroys a barrel and applies its bounded visible blast"
];
i = 0;
while (i < 44) (
  barrel_combat = doom_combat_tick[map, barrel_combat, 50, 150];
  i = i + 1;
)
doom_combat_test_expect[
  (barrel_combat\barrels\0\state == 0) and
  (barrel_combat\barrels\0\phase_tick == 45),
  "barrel blast retires after its bounded animation"
];

let arsenal = doom_combat_new[map];
bytes_set[arsenal\weapons, 3, 1];
bytes_set[arsenal\weapons, 5, 1];
arsenal\shells = 4;
arsenal\rockets = 2;
arsenal = doom_combat_select_weapon[arsenal, 3];
doom_combat_test_expect[
  (arsenal\selected_weapon == 3) and
  (doom_combat_current_ammo[arsenal] == 4) and
  (doom_combat_weapon_slot[arsenal] ==
   doom_texture_weapon_slot_for[3, 0]),
  "owned shotgun selection changes ammo and view authority together"
];
arsenal = doom_combat_fire[
  map, arsenal, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (arsenal\shells == 3) and (arsenal\shot_cooldown == 24) and
  (arsenal\kills == 1) and
  (doom_combat_weapon_slot[arsenal] == 630) and
  (doom_combat_muzzle_slot[arsenal] == 0 - 1),
  "shotgun consumes shells and begins its explicit dark wind-up"
];
arsenal = doom_combat_cycle_weapon[arsenal, 1];
doom_combat_test_expect[
  arsenal\selected_weapon == 5,
  "weapon cycling skips inventory slots the player does not own"
];
arsenal = doom_combat_fire[
  map, arsenal, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (arsenal\rockets == 1) and (arr_len[arsenal\projectiles] == 1) and
  (arsenal\projectiles\0\state == 1) and
  (arsenal\projectiles\0\kind == 1) and
  (arsenal\projectiles\0\angle == 0) and
  (doom_combat_muzzle_slot[arsenal] == 979) and
  (arsenal\projectile_impacts == 0),
  "rocket fire creates a travelling bounded projectile instead of hitscan"
];
i = 0;
while (i < 10) (
  arsenal = doom_combat_tick[map, arsenal, 50, 50];
  i = i + 1;
)
doom_combat_test_expect[
  (arsenal\projectiles\0\state == 2) and
  (arsenal\projectile_impacts == 1) and (arsenal\misses == 0) and
  (arsenal\barrels\0\state == 2),
  "rocket impact destroys a nearby barrel and enters visible explosion state"
];

let plasma_combat = doom_combat_new[map];
bytes_set[plasma_combat\weapons, 6, 1];
plasma_combat\cells = 2;
plasma_combat = doom_combat_select_weapon[plasma_combat, 6];
plasma_combat = doom_combat_fire[
  map, plasma_combat, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (plasma_combat\cells == 1) and
  (plasma_combat\shot_cooldown == 4) and
  (arr_len[plasma_combat\projectiles] == 1) and
  (plasma_combat\projectiles\0\kind == 6) and
  (plasma_combat\projectiles\0\state == 1) and
  (doom_combat_weapon_slot[plasma_combat] == 638) and
  (doom_combat_muzzle_slot[plasma_combat] == 983),
  "plasma fire consumes one cell and publishes its psprite and bolt authority"
];
i = 0;
while (i < 3) (
  plasma_combat = doom_combat_tick[map, plasma_combat, 50, 50];
  i = i + 1;
)
doom_combat_test_expect[
  (plasma_combat\projectiles\0\state == 2) and
  (plasma_combat\projectiles\0\hits == 1) and
  (plasma_combat\kills == 1) and
  (plasma_combat\projectile_impacts == 1),
  "plasma bolt travels, damages one visible body and enters its impact sequence"
];

let bfg_combat = doom_combat_new[map];
bytes_set[bfg_combat\weapons, 7, 1];
bfg_combat\cells = 39;
bfg_combat = doom_combat_select_weapon[bfg_combat, 7];
bfg_combat = doom_combat_fire[
  map, bfg_combat, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (bfg_combat\dry_fires == 1) and (bfg_combat\cells == 39) and
  (arr_len[bfg_combat\projectiles] == 0),
  "BFG refuses a partial forty-cell charge without consuming it"
];
bfg_combat\cells = 40;
bfg_combat = doom_combat_fire[
  map, bfg_combat, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (bfg_combat\cells == 0) and
  (bfg_combat\projectiles\0\kind == 7) and
  (bfg_combat\projectiles\0\state == 1) and
  (doom_combat_weapon_slot[bfg_combat] == 640) and
  (doom_combat_muzzle_slot[bfg_combat] == 0 - 1),
  "BFG charge publishes its projectile while the psprite remains dark"
];
i = 0;
while (i < 4) (
  bfg_combat = doom_combat_tick[map, bfg_combat, 50, 50];
  i = i + 1;
)
doom_combat_test_expect[
  (bfg_combat\projectiles\0\state == 2) and
  (bfg_combat\projectiles\0\hits >= 1) and
  (bfg_combat\kills == 1) and
  (bfg_combat\projectile_impacts == 1),
  "BFG projectile resolves a bounded visible-area impact"
];

buf_set[map\things, 6, 3003];
let berserk_combat = doom_combat_new[map];
bytes_set[berserk_combat\weapons, 1, 1];
berserk_combat\berserk = 1;
berserk_combat = doom_combat_select_weapon[berserk_combat, 1];
berserk_combat = doom_combat_fire[
  map, berserk_combat, 50, 50, trig_from_degrees[0]
];
doom_combat_test_expect[
  (berserk_combat\actors\0\health == 940) and
  (berserk_combat\selected_weapon == 1),
  "berserk power strengthens the admitted close-weapon profile"
];
buf_set[map\things, 6, 3004];

// Reuse the checked square with an imp in the admitted enemy slot. Its attack
// must create a hostile travelling record; damage is applied only when that
// record reaches the player's body rather than at the attack-frame edge.
buf_set[map\things, 6, 3001];
let imp_combat = doom_combat_new[map];
let imp = imp_combat\actors\\0;
imp\phase = DoomEnemyPhase\Attack;
imp\phase_tick = 7;
imp\angle = 180;
imp_combat = doom_combat_tick_at[map, imp_combat, 50, 50, 0];
doom_combat_test_expect[
  (imp\max_health == 60) and
  (arr_len[imp_combat\projectiles] == 1) and
  (imp_combat\projectiles\0\kind == 2) and
  (imp_combat\projectiles\0\state == 1) and
  (imp_combat\health == 100),
  "imp ranged attack creates one explicit hostile fireball"
];
i = 0;
while (i < 8) (
  imp_combat = doom_combat_tick_at[map, imp_combat, 50, 50, 0];
  i = i + 1;
)
doom_combat_test_expect[
  (imp_combat\projectiles\0\state == 2) and
  (imp_combat\projectiles\0\hits == 1) and
  (imp_combat\monster_projectile_impacts == 1) and
  (imp_combat\health == 94) and
  (imp_combat\damage_taken == 6),
  "imp fireball collision owns damage and enters its WAD impact sequence"
];
buf_set[map\things, 6, 3004];

// Demon and spectre share the native SARG atlas and melee authority. Keep the
// spectre's future translucency as a renderer concern, not a second actor kind.
buf_set[map\things, 6, 3002];
let demon_combat = doom_combat_new[map];
let demon = demon_combat\actors\\0;
demon\x = 80;
demon\phase = DoomEnemyPhase\Attack;
demon\phase_tick = 7;
demon_combat = doom_combat_tick_at[map, demon_combat, 50, 50, 0];
doom_combat_test_expect[
  (demon\family == 3) and (demon\max_health == 150) and
  (demon_combat\health == 92) and
  (demon_combat\damage_taken == 8) and
  (demon_combat\monster_attack_kind == 3002),
  "demon uses the shared SARG family and its bounded melee profile"
];
buf_set[map\things, 6, 3004];

buf_set[map\things, 6, 3005];
let caco_combat = doom_combat_new[map];
let caco = caco_combat\actors\\0;
caco\phase = DoomEnemyPhase\Attack;
caco\phase_tick = 7;
caco_combat = doom_combat_tick_at[map, caco_combat, 50, 50, 0];
doom_combat_test_expect[
  (caco\family == 4) and (caco\max_health == 400) and
  (caco_combat\projectiles\0\kind == 3) and
  (caco_combat\projectiles\0\damage == 10),
  "cacodemon launches its bounded BAL2 projectile profile"
];

buf_set[map\things, 6, 3003];
let baron_combat = doom_combat_new[map];
let baron = baron_combat\actors\\0;
baron\phase = DoomEnemyPhase\Attack;
baron\phase_tick = 7;
baron_combat = doom_combat_tick_at[map, baron_combat, 50, 50, 0];
doom_combat_test_expect[
  (baron\family == 6) and (baron\max_health == 1000) and
  (baron_combat\projectiles\0\kind == 4) and
  (baron_combat\projectiles\0\damage == 16),
  "baron launches its stronger bounded BAL7 projectile profile"
];

buf_set[map\things, 6, 16];
let cyber_combat = doom_combat_new[map];
let cyber = cyber_combat\actors\\0;
cyber\phase = DoomEnemyPhase\Attack;
cyber\phase_tick = 7;
cyber_combat = doom_combat_tick_at[map, cyber_combat, 50, 50, 0];
doom_combat_test_expect[
  (cyber\family == 7) and (cyber\max_health == 4000) and
  (cyber_combat\projectiles\0\kind == 5) and
  (cyber_combat\projectiles\0\damage == 40),
  "cyberdemon launches an enemy-owned rocket profile"
];

buf_set[map\things, 6, 3006];
let soul_combat = doom_combat_new[map];
let soul = soul_combat\actors\\0;
soul\x = 100;
soul\phase = DoomEnemyPhase\Attack;
soul\phase_tick = 7;
soul_combat = doom_combat_tick_at[map, soul_combat, 50, 50, 0];
doom_combat_test_expect[
  (soul\family == 5) and (soul\max_health == 100) and
  (soul\x == 92) and (soul_combat\health == 94),
  "lost soul charge advances before applying contact damage"
];
soul\health = 0;
soul\phase = DoomEnemyPhase\Death;
soul\phase_tick = 30;
soul_combat\kills = 1;
bytes_set[soul_combat\alive, soul\thing, 0];
doom_combat_test_expect[
  (doom_combat_actor_renderable[soul] == 1) and
  (doom_combat_actor_sprite_slot[soul, 1] ==
    doom_texture_lost_soul_terminal_slot[]),
  "lost soul renders its sixth vanilla death frame before removal"
];
i = 0;
while (i < 6) (
  soul_combat = doom_combat_tick_at[map, soul_combat, 50, 50, 0];
  i = i + 1;
)
doom_combat_test_expect[
  (soul\phase_tick == 36) and
  (doom_combat_actor_targetable[soul] == 0) and
  (doom_combat_actor_renderable[soul] == 0) and
  (doom_combat_validate[map, soul_combat] == 1),
  "lost soul reaches S_NULL instead of retaining a terminal halo"
];

buf_set[map\things, 6, 7];
let spider_combat = doom_combat_new[map];
let spider = spider_combat\actors\\0;
spider\phase = DoomEnemyPhase\Attack;
spider\phase_tick = 7;
spider_combat = doom_combat_tick_at[map, spider_combat, 50, 50, 0];
doom_combat_test_expect[
  (spider\family == 8) and (spider\max_health == 3000) and
  (spider_combat\health == 64) and
  (spider_combat\monster_attack_kind == 7),
  "spider mastermind owns a deterministic hitscan burst"
];
buf_set[map\things, 6, 3004];

print "doom combat state ok";
