// Freelang Doom Engine orchestration over the checked Doom modules. This file
// owns executable policy and the frame transaction; WAD interpretation,
// simulation, rendering and synthesis remain independently testable in their
// own modules. The only native-facing values are a pixel buffer, presenter
// records and bounded canonical WAV clips passed through f/gui and f/audio's
// process-isolated contracts.

credits: <../games/doom-view.flx> <../games/doom-input.flx>
         <../games/doom-input-trace.flx>
         <../games/doom-world.flx> <../games/doom-ui.flx>
         <../games/doom-demo.flx> <../games/doom-audio.flx>
         <f/gui> <f/audio> <f/process> <f/time> <f/trig> <f/strings>;

op doom_play_note_compatibility [map_name, world, combat] (
  let actions = world\unsupported_actions;
  let enemies = combat\unsupported_enemies;
  if ((actions > 0) or (enemies > 0)) (
    let detail = "^{actions} ACTIONS, ^{enemies} ENEMIES INERT";
    eprint["doom-play: ^{map_name}: limited compatibility: ^{detail}"];
    world\pickup_message = "LIMITED MAP: ^{detail}";
    world\pickup_tick = 300;
  )
  => world;
)

op doom_play_run [map, demo_mode, texture_mode] (
  => doom_play_run_mode[map, demo_mode, texture_mode, 1];
)

op doom_play_run_mode [map, demo_mode, texture_mode, combat_mode] (
  => doom_play_run_mode_sized[
    map, demo_mode, texture_mode, combat_mode, 320, 200
  ];
)

op doom_play_run_mode_sized [map, demo_mode, texture_mode,
                             combat_mode, w, h] (
  => doom_play_run_session[
    map, demo_mode, texture_mode, combat_mode, w, h, 0, 0,
    ["E1M1", "E1M2"], ""
  ];
)

op doom_play_validate_dimensions [w, h] (
  if ((w >= 320) and (w <= 1280) and
      (h >= 200) and (h <= 800) and
      (w * 5 == h * 8) and (w * h <= 1024000)) () else (
    fall "doom_play_run_mode_sized: unsupported logical resolution";
  )
  => 0;
)

op doom_play_open_window [map_name, demo_mode, w, h] (
  doom_play_validate_dimensions[w, h];
  let session = 0;
  if (demo_mode == 1) (
    session = gui_open_fps_named[
      w, h, "Freelang Doom Engine — ^{map_name}", 60,
      "Freelang Doom Engine"
    ]
      with chaos { _ => 0 };
  ) else (
    session = gui_open_captured_resizable_fps_named[
      w, h, "Freelang Doom Engine — ^{map_name}", 60,
      "Freelang Doom Engine"
    ] with chaos { _ => 0 };
  )
  => session;
)

// Put a real first frame in the level's own window before WAD textures and
// derived music are loaded. `closed` distinguishes a user's early close from
// presenter birth failure; the latter retains the old post-load retry path.
op doom_play_loading_window [map_name, demo_mode, w, h] (
  let session = doom_play_open_window[map_name, demo_mode, w, h];
  if (is_object[session]) () else (
    => { session: 0, closed: 0, events: [] };
  )
  let buf = gui_buffer[w, h];
  let font = gui_font[];
  doom_ui_draw_loading[buf, w, h, font, map_name];
  let events = gui_present[session, buf] with chaos {
    _ => [{ kind: gui_ev_close[], a: 0, b: 0, mods: 0 }]
  };
  if (gui_has_close[events] == 1) (
    gui_close[session];
    => { session: 0, closed: 1, events: [] };
  )
  => { session: session, closed: 0, events: events };
)

op doom_play_run_session [map, demo_mode, texture_mode,
                          combat_mode, w, h, diag_mode, start_menu,
                          menu_maps, input_log_path] (
  let session = doom_play_open_window[map\name, demo_mode, w, h];
  if (is_object[session]) () else ( => 1; )
  => doom_play_run_session_on[
    session, [], map, demo_mode, texture_mode, combat_mode, w, h,
    diag_mode, start_menu, menu_maps, input_log_path
  ];
)

// A session without mixer authority remains a fully playable silent session.
// Keeping that value explicit makes sound failure unable to affect simulation.
op doom_play_run_session_on [session, initial_events, map, demo_mode,
                             texture_mode, combat_mode, w, h, diag_mode,
                             start_menu, menu_maps, input_log_path] (
  => doom_play_run_session_audio_on[
    session, initial_events, map, demo_mode, texture_mode, combat_mode,
    w, h, diag_mode, start_menu, menu_maps, input_log_path, 0
  ];
)

private op doom_play_sound [audio_session, voice, clip, gain] (
  if (is_object[audio_session]) (
    => audio_mixer_play[audio_session, voice, clip, 0, gain];
  )
  => 0;
)

private op doom_play_weapon_clip [weapon] (
  if (weapon == 1) ( => 1; )
  if ((weapon == 2) or (weapon == 4)) ( => 2; )
  if (weapon == 3) ( => 3; )
  if (weapon == 5) ( => 4; )
  => 2;
)

private op doom_play_world_sound_clip [kind] (
  if (kind == 1) ( => 7; )
  if (kind == 2) ( => 8; )
  if (kind == 3) ( => 9; )
  if (kind == 4) ( => 10; )
  if (kind == 5) ( => 11; )
  => 0;
)

private op doom_play_monster_alert_clip [kind] (
  if (kind == 3004) ( => 14; )
  if (kind == 9) ( => 15; )
  if (kind == 3001) ( => 16; )
  => 0;
)

private op doom_play_monster_attack_clip [kind] (
  if (kind == 3004) ( => 2; )
  if (kind == 9) ( => 17; )
  if (kind == 3001) ( => 18; )
  => 0;
)

private op doom_play_monster_pain_clip [kind] (
  if ((kind == 3004) or (kind == 9)) ( => 19; )
  if (kind == 3001) ( => 20; )
  => 0;
)

private op doom_play_monster_death_clip [kind] (
  if (kind == 3004) ( => 21; )
  if (kind == 9) ( => 22; )
  if (kind == 3001) ( => 23; )
  => 0;
)

// Keep one frame as one visible transaction rather than distributing game
// state across callbacks: render the current world, present and receive the
// complete input snapshot, fold UI/control intent, resolve movement, update
// combat/world state, then retain optional evidence. The operation is long,
// but its order makes ownership and frame-to-frame causality inspectable.
op doom_play_run_session_audio_on [session, initial_events, map, demo_mode,
                                   texture_mode, combat_mode, w, h, diag_mode,
                                   start_menu, menu_maps, input_log_path,
                                   audio_session] (
  let buf = gui_buffer[w, h];
  let font = gui_font[];
  let world = doom_world_new[map];
  let play_map = doom_world_map[map, world];
  let work = doom_view_work_sized[play_map, w, h];
  let controls = doom_input_new[];
  // The loading frame receives the presenter's initial capture transition.
  // Fold it here so handing the live session into gameplay cannot discard
  // capture state (or a key edge delivered while assets were loading).
  controls = doom_input_next[controls, initial_events];
  let input_trace = doom_input_trace_new[input_log_path, map\name];
  if (str_len[input_trace\error] > 0) (
    eprint["doom-play: ^{input_trace\error}"];
  )
  let ui = doom_ui_new_for_maps[menu_maps, map\name];
  if ((demo_mode == 0) and (start_menu == 1)) ( ui\open = 1; )
  let demo = doom_demo_idle_new_mode[map, combat_mode];
  if (demo_mode == 1) ( demo = doom_demo_new_mode[map, combat_mode]; )
  let demo_phase_seen = 0 - 1;
  let player_x = map\player_x;
  let player_y = map\player_y;
  let angle = trig_from_degrees[map\player_angle];
  let pitch = 0;
  let steps = 0;
  let blocked = 0;
  let kills = 0;
  let misses = 0;
  let enemies = 0;
  let alive = bytes_new[map\thing_count];
  let i = 0;
  while (i < map\thing_count) (
    let kind = buf_get[map\things, i * 4 + 2];
    if (doom_map_thing_is_enemy[kind] == 1) (
      bytes_set[alive, i, 1];
      enemies = enemies + 1;
    )
    i = i + 1;
  )
  let combat = doom_combat_new[play_map];
  if (combat_mode == 1) (
    alive = combat\alive;
    enemies = combat\enemy_count;
  )
  world = doom_play_note_compatibility[map\name, world, combat];
  let world_sound_seen = world\sound_serial;
  let explosion_sound_seen = combat\explosion_serial;
  let projectile_impact_seen = combat\projectile_impacts;
  let monster_alert_seen = combat\monster_alert_serial;
  let monster_attack_seen = combat\monster_attack_serial;
  let monster_pain_seen = combat\monster_pain_serial;
  let monster_death_seen = combat\monster_death_serial;
  let player_pain_seen = combat\player_pain_serial;

  let running = 1;
  let requested_episode = 0;
  let frame_index = 0;
  let blocked_streak = 0;
  let contact_streak = 0;
  while (running == 1) (
    let frame_started = now[];
    if (texture_mode == 1) (
      if (combat_mode == 1) (
        doom_view_draw_world_pitched[
          buf, w, h, font, play_map, work,
          player_x, player_y, angle, pitch, combat, world, steps, blocked
        ];
      ) else (
        doom_view_draw_pitched[
          buf, w, h, font, play_map, work, player_x, player_y, angle, pitch,
          alive, kills, enemies, misses, steps, blocked
        ];
      )
    ) else (
      if (combat_mode == 1) (
        doom_view_draw_world_flat_pitched[
          buf, w, h, font, play_map, work,
          player_x, player_y, angle, pitch, combat, world, steps, blocked
        ];
      ) else (
        doom_view_draw_flat_pitched[
          buf, w, h, font, play_map, work, player_x, player_y, angle, pitch,
          alive, kills, enemies, misses, steps, blocked
        ];
      )
    )
    if ((combat_mode == 1) and (texture_mode == 1)) (
      doom_ui_draw_status[buf, w, h, play_map\texture_bank, combat, world];
    )
    if (demo_mode == 1) (
      gui_text[buf, w, h, font, 10, 34,
        "DETERMINISTIC ^{map\name} DEMO", gui_rgb[80, 220, 210]];
    ) else if ((controls\captured == 0) and (ui\open == 0)) (
      gui_text[buf, w, h, font, 10, 34,
        "CLICK TO CAPTURE — ESC AGAIN FOR MENU", gui_rgb[255, 200, 80]];
    )
    if ((combat_mode == 1) and (texture_mode == 1)) (
      doom_ui_draw_menu[buf, w, h, play_map\texture_bank, ui];
    )
    let render_done = now[];
    let events = gui_present[session, buf] with chaos {
      _ => [{ kind: gui_ev_close[], a: 0, b: 0, mods: 0 }]
    };
    let present_done = now[];
    if (gui_has_close[events] == 1) ( running = 0; )
    if (demo_mode == 0) ( ui = doom_ui_next[ui, events]; )
    if (ui\selection > 0) (
      requested_episode = ui\selection;
      running = 0;
    )
    let input_before = "";
    if (input_trace\enabled == 1) (
      input_before = doom_input_trace_snapshot[controls];
    )
    controls = doom_input_next[controls, events];
    input_trace = doom_input_trace_frame[
      input_trace, frame_index, events, input_before, controls, ui\open
    ];

    if (gui_key_pressed[events, 114] == 1) (
      player_x = map\player_x;
      player_y = map\player_y;
      angle = trig_from_degrees[map\player_angle];
      pitch = 0;
      steps = 0;
      blocked = 0;
      kills = 0;
      misses = 0;
      i = 0;
      while (i < map\thing_count) (
        let kind = buf_get[map\things, i * 4 + 2];
        bytes_set[alive, i, doom_map_thing_is_enemy[kind]];
        i = i + 1;
      )
      world = doom_world_new[map];
      play_map = doom_world_map[map, world];
      if (combat_mode == 1) (
        combat = doom_combat_new[play_map];
        alive = combat\alive;
        enemies = combat\enemy_count;
      )
      world = doom_play_note_compatibility[map\name, world, combat];
      world_sound_seen = world\sound_serial;
      explosion_sound_seen = combat\explosion_serial;
      projectile_impact_seen = combat\projectile_impacts;
      monster_alert_seen = combat\monster_alert_serial;
      monster_attack_seen = combat\monster_attack_serial;
      monster_pain_seen = combat\monster_pain_serial;
      monster_death_seen = combat\monster_death_serial;
      player_pain_seen = combat\player_pain_serial;
      demo = doom_demo_idle_new_mode[map, combat_mode];
      if (demo_mode == 1) ( demo = doom_demo_new_mode[map, combat_mode]; )
      demo_phase_seen = 0 - 1;
    )

    let turn = 0;
    let forward = 0;
    let strafe = 0;
    let fire = doom_input_fire_held[controls];
    let jump_requested = 0;
    let jump_result = 0 - 1;
    if (demo_mode == 1) (
      if (demo\phase != demo_phase_seen) (
        if (demo\phase == 2) (
          demo\aim_heading = demo\first_aim;
          if (combat_mode == 1) (
            demo\aim_heading = doom_combat_demo_heading[
              play_map, combat, player_x, player_y, demo\first_aim
            ];
          )
        )
        if (demo\phase == 5) (
          demo\aim_heading = demo\second_aim;
          if (combat_mode == 1) (
            demo\aim_heading = doom_combat_demo_heading[
              play_map, combat, player_x, player_y, demo\second_aim
            ];
          )
        )
        demo_phase_seen = demo\phase;
      )
      let command = doom_demo_next[demo, player_x, player_y];
      demo = command\state;
      angle = trig_from_degrees[command\heading];
      pitch = command\pitch;
      forward = command\forward;
      if (command\fire == 1) ( fire = 1; )
      if (command\finished == 1) ( running = 0; )
    ) else if (ui\open == 0) (
      if (doom_input_held[controls, gui_key_left[]] == 1) ( turn = turn + 2; )
      if (doom_input_held[controls, gui_key_right[]] == 1) ( turn = turn - 2; )
      if (turn != 0) ( angle = angle + trig_from_degrees[turn]; )
      if (controls\mouse_dx != 0) (
        angle = angle - trig_from_degrees[
          controls\mouse_dx * ui\look_speed
        ];
      )
      if (controls\mouse_dy != 0) (
        pitch = doom_input_pitch[
          pitch, controls\mouse_dy * ui\look_speed
        ];
      )
      forward = doom_input_forward_axis[controls] * 8;
      strafe = doom_input_strafe_axis[controls] * 6;
      if (gui_key_pressed[events, 32] == 1) (
        jump_requested = 1;
        jump_result = doom_world_jump[
          play_map, world, player_x, player_y
        ];
      )
      if ((gui_key_pressed[events, 101] == 1) or
          (gui_key_pressed[events, 69] == 1)) (
        doom_world_use[play_map, world, player_x, player_y, angle];
      )
      if (combat_mode == 1) (
        let weapon_key = 1;
        while (weapon_key <= 5) (
          if (gui_key_pressed[events, 48 + weapon_key] == 1) (
            combat = doom_combat_select_weapon[combat, weapon_key];
          )
          weapon_key = weapon_key + 1;
        )
        if (controls\scroll_y > 0) (
          combat = doom_combat_cycle_weapon[combat, 0 - 1];
        )
        if (controls\scroll_y < 0) (
          combat = doom_combat_cycle_weapon[combat, 1];
        )
        if (gui_key_pressed[events, 91] == 1) (
          combat = doom_combat_cycle_weapon[combat, 0 - 1];
        )
        if (gui_key_pressed[events, 93] == 1) (
          combat = doom_combat_cycle_weapon[combat, 1];
        )
      )
    )
    if (ui\open == 1) ( fire = 0; forward = 0; strafe = 0; )
    if ((combat_mode == 1) and
        ((combat\health == 0) or (world\exited == 1))) (
      fire = 0;
      forward = 0;
      strafe = 0;
    )
    if (fire == 1) (
      if (combat_mode == 1) (
        let shots_before = combat\shots;
        let misses_before = combat\misses;
        let kills_before = combat\kills;
        let shot_target_kind = 0;
        let shot_target_index = 0 - 1;
        let shot_target_distance = 0;
        if ((diag_mode == 1) and (combat\shot_cooldown == 0) and
            (doom_combat_current_ammo[combat] > 0) and
            (combat\selected_weapon != 5)) (
          let shot_target = doom_combat_hitscan[
            play_map, combat, player_x, player_y, angle, 1024
          ];
          shot_target_kind = shot_target\kind;
          shot_target_index = shot_target\index;
          shot_target_distance = shot_target\distance;
        )
        combat = doom_combat_fire[
          play_map, combat, player_x, player_y, angle
        ];
        if (combat\shots > shots_before) (
          doom_play_sound[
            audio_session, 1,
            doom_play_weapon_clip[combat\selected_weapon], 256
          ];
          doom_world_shoot[play_map, world, player_x, player_y, angle];
          if (diag_mode == 1) (
            eprint[
              "doom-diag shot frame=^{frame_index} weapon=^{combat\selected_weapon} target_kind=^{shot_target_kind} target_index=^{shot_target_index} distance=^{shot_target_distance} misses_delta=^{combat\misses - misses_before} kills_delta=^{combat\kills - kills_before}"
            ];
            if (shot_target_kind == 1) (
              let shot_actor = combat\actors\\shot_target_index;
              eprint[
                "doom-diag shot actor kind=^{shot_actor\kind} health=^{shot_actor\health} phase=^{doom_combat_actor_phase_name[shot_actor]}"
              ];
            ) else if (shot_target_kind == 2) (
              let shot_barrel = combat\barrels\\shot_target_index;
              eprint[
                "doom-diag shot barrel health=^{shot_barrel\health} state=^{shot_barrel\state} phase_tick=^{shot_barrel\phase_tick}"
              ];
            )
          )
        )
      ) else (
        let target = doom_view_hitscan_target[
          play_map, alive, player_x, player_y, angle, 1024
        ];
        if (target >= 0) (
          bytes_set[alive, target, 0];
          kills = kills + 1;
        ) else (
          misses = misses + 1;
        )
      )
    )
    let move_dx = 0;
    let move_dy = 0;
    let move_from_x = player_x;
    let move_from_y = player_y;
    let move_player_z = world\player_z;
    let move_moved = 0;
    let move_blocked = 0;
    let move_result = {
      x: player_x, y: player_y, moved: 0, blocked: 0,
      blocker_kind: 0, blocker_index: 0 - 1,
      teleported: 0, teleport_angle: 0
    };
    if ((forward != 0) or (strafe != 0)) (
      let direction = trig_sincos[angle];
      let motion = doom_input_motion[
        direction\sin, direction\cos, forward, strafe
      ];
      let dx = motion\dx;
      let dy = motion\dy;
      move_dx = dx;
      move_dy = dy;
      move_result = doom_world_slide_move[
        play_map, world, player_x, player_y, dx, dy
      ];
      if (combat_mode == 1) (
        move_result = doom_world_slide_move_combat[
          play_map, world, combat, player_x, player_y, dx, dy
        ];
      )
      blocked = blocked + move_result\blocked;
      move_moved = move_result\moved;
      move_blocked = move_result\blocked;
      if (move_result\moved == 1) (
        player_x = move_result\x;
        player_y = move_result\y;
        if (move_result\teleported == 1) (
          angle = trig_from_degrees[move_result\teleport_angle];
        )
        steps = steps + 1;
      )
    )
    let previous_contact_streak = contact_streak;
    if (((forward != 0) or (strafe != 0)) and
        (move_blocked == 1) and (move_moved == 0)) (
      blocked_streak = blocked_streak + 1;
    ) else (
      blocked_streak = 0;
    )
    if (((forward != 0) or (strafe != 0)) and (move_blocked == 1)) (
      contact_streak = contact_streak + 1;
    ) else (
      contact_streak = 0;
    )
    input_trace = doom_input_trace_movement[
      input_trace, frame_index, move_from_x, move_from_y, move_player_z,
      move_dx, move_dy, move_result, blocked_streak, contact_streak
    ];
    if ((input_trace\enabled == 1) and (blocked_streak > 0) and
        ((blocked_streak == 1) or (blocked_streak % 30 == 0))) (
      let stall_probe = doom_world_stall_probe[
        play_map, world, move_from_x, move_from_y, move_dx, move_dy
      ];
      if (combat_mode == 1) (
        stall_probe = doom_world_stall_probe_combat[
          play_map, world, combat,
          move_from_x, move_from_y, move_dx, move_dy
        ];
      )
      input_trace = doom_input_trace_stall[
        input_trace, frame_index,
        move_from_x, move_from_y, move_player_z,
        move_dx, move_dy, angle, controls, stall_probe, blocked_streak
      ];
    )
    if ((input_trace\enabled == 1) and (move_blocked == 1) and
        (move_moved == 1) and
        ((contact_streak == 1) or (contact_streak % 15 == 0))) (
      let contact_probe = doom_world_stall_probe[
        play_map, world, move_from_x, move_from_y, move_dx, move_dy
      ];
      if (combat_mode == 1) (
        contact_probe = doom_world_stall_probe_combat[
          play_map, world, combat,
          move_from_x, move_from_y, move_dx, move_dy
        ];
      )
      input_trace = doom_input_trace_contact[
        input_trace, frame_index,
        move_from_x, move_from_y, move_player_z,
        move_dx, move_dy, angle, controls, move_result, contact_probe,
        contact_streak
      ];
    )
    if ((input_trace\enabled == 1) and (previous_contact_streak > 0) and
        (contact_streak == 0)) (
      input_trace = doom_input_trace_resume[
        input_trace, frame_index,
        move_from_x, move_from_y, move_player_z,
        move_dx, move_dy, angle, controls, move_result,
        previous_contact_streak
      ];
    )
    if ((demo_mode == 1) or (ui\open == 0)) (
      if (combat_mode == 1) (
        let collected = doom_world_collect[
          play_map, world, combat, player_x, player_y
        ];
        if (collected > 0) (
          let pickup_clip = 5;
          if (doom_world_pickup_is_weapon[world\pickup_kind] == 1) (
            pickup_clip = 6;
          )
          doom_play_sound[audio_session, 2, pickup_clip, 256];
        )
        if (world\exited == 0) (
          combat = doom_combat_tick_at[
            play_map, combat, player_x, player_y, world\player_z
          ];
        )
      )
      world = doom_world_tick[play_map, world, player_x, player_y];
      if (combat_mode == 1) (
        combat = doom_world_apply_hazard[
          play_map, world, combat, player_x, player_y
        ];
      )
    )
    if (world\sound_serial != world_sound_seen) (
      let world_clip = doom_play_world_sound_clip[world\sound_kind];
      if (world_clip > 0) (
        let world_voice = 3;
        if (world\sound_kind == 5) ( world_voice = 4; )
        doom_play_sound[audio_session, world_voice, world_clip, 256];
      )
      world_sound_seen = world\sound_serial;
    )
    if ((combat_mode == 1) and
        (combat\explosion_serial != explosion_sound_seen)) (
      doom_play_sound[audio_session, 5, 12, 256];
      explosion_sound_seen = combat\explosion_serial;
    )
    if ((combat_mode == 1) and
        (combat\projectile_impacts != projectile_impact_seen)) (
      doom_play_sound[audio_session, 5, 24, 256];
      projectile_impact_seen = combat\projectile_impacts;
    )
    if ((combat_mode == 1) and
        (combat\monster_alert_serial != monster_alert_seen)) (
      let clip = doom_play_monster_alert_clip[combat\monster_alert_kind];
      if (clip > 0) ( doom_play_sound[audio_session, 6, clip, 224]; )
      monster_alert_seen = combat\monster_alert_serial;
    )
    if ((combat_mode == 1) and
        (combat\monster_attack_serial != monster_attack_seen)) (
      let clip = doom_play_monster_attack_clip[combat\monster_attack_kind];
      if (clip > 0) ( doom_play_sound[audio_session, 7, clip, 240]; )
      monster_attack_seen = combat\monster_attack_serial;
    )
    if ((combat_mode == 1) and
        (combat\monster_pain_serial != monster_pain_seen)) (
      let clip = doom_play_monster_pain_clip[combat\monster_pain_kind];
      if (clip > 0) ( doom_play_sound[audio_session, 8, clip, 224]; )
      monster_pain_seen = combat\monster_pain_serial;
    )
    if ((combat_mode == 1) and
        (combat\monster_death_serial != monster_death_seen)) (
      let clip = doom_play_monster_death_clip[combat\monster_death_kind];
      if (clip > 0) ( doom_play_sound[audio_session, 9, clip, 240]; )
      monster_death_seen = combat\monster_death_serial;
    )
    if ((combat_mode == 1) and
        (combat\player_pain_serial != player_pain_seen)) (
      doom_play_sound[audio_session, 10, 13, 256];
      player_pain_seen = combat\player_pain_serial;
    )
    let frame_done = now[];
    if (diag_mode == 1) (
      if ((blocked_streak == 1) or
          ((blocked_streak > 0) and (blocked_streak % 30 == 0))) (
        eprint[
          "doom-diag blocked frame=^{frame_index} streak=^{blocked_streak} pos=^{player_x},^{player_y},^{world\player_z} forward=^{forward} strafe=^{strafe} focused=^{controls\focused} held_w=^{doom_input_held[controls, 119]} held_up=^{doom_input_held[controls, gui_key_up[]]} blocker=^{doom_world_blocker_name[move_result\blocker_kind]},^{move_result\blocker_index}"
        ];
      )
      if (jump_requested == 1) (
        eprint[
          "doom-diag jump frame=^{frame_index} result=^{jump_result} pos=^{player_x},^{player_y},^{world\player_z} grounded=^{world\grounded} motion=^{move_dx},^{move_dy} moved=^{move_moved} blocked=^{move_blocked}"
        ];
      )
      if (frame_done - frame_started > 50000000) (
        eprint[
          "doom-diag slow frame=^{frame_index} total_ms=^{(frame_done - frame_started) / 1000000} render_ms=^{(render_done - frame_started) / 1000000} present_ms=^{(present_done - render_done) / 1000000} sim_ms=^{(frame_done - present_done) / 1000000} pos=^{player_x},^{player_y},^{world\player_z} grounded=^{world\grounded} motion=^{move_dx},^{move_dy} moved=^{move_moved} blocked=^{move_blocked}"
        ];
      )
      if (frame_index % 120 == 0) (
        eprint[
          "doom-diag heartbeat frame=^{frame_index} total_ms=^{(frame_done - frame_started) / 1000000} pos=^{player_x},^{player_y},^{world\player_z} grounded=^{world\grounded}"
        ];
      )
    )
    frame_index = frame_index + 1;
  )
  doom_input_trace_finish[input_trace, frame_index];
  gui_close[session];
  if (demo_mode == 1) (
    print "demo state: point ^{demo\point} phase ^{demo\phase} frame ^{demo\frame} at ^{player_x},^{player_y} heading ^{demo\heading}";
  )
  if (combat_mode == 1) (
    print "doom closed: ^{combat\kills}/^{combat\enemy_count} kills, ^{combat\shots} shots, ^{combat\misses} misses, ^{steps} moves, ^{blocked} blocked, ^{combat\health} health, ^{combat\ammo} ammo";
  ) else (
    print "doom closed: ^{kills}/^{enemies} kills, ^{steps} moves, ^{blocked} blocked";
  )
  => requested_episode;
)

// One map session owns one looping synthesized score plus a bounded Doom-owned
// effect bank. The general mixer knows only canonical WAV clip indices. Normal
// return, map changes and bubbled failures all close its sidecar authority.
op doom_play_with_music_on [session, initial_events, map, demo_mode,
                            texture_mode, combat_mode, w, h, diag_mode,
                            start_menu, rendered, menu_maps, input_log_path,
                            wad_path] (
  let effects = doom_audio_render_effects[wad_path];
  if (effects\ok == 1) () else (
    eprint[
      "doom-play: effects unavailable: ^{effects\error}; using music only"
    ];
    let music = audio_open_wav[rendered\wav, 1]
      with chaos { _ => bubble }
      with unwind ( audio_close[music]; );
    => doom_play_run_session_on[
      session, initial_events, map, demo_mode, texture_mode, combat_mode,
      w, h, diag_mode, start_menu, menu_maps, input_log_path
    ];
  )
  let clips = [rendered\wav] + effects\wavs;
  let mixer = audio_open_mixer[clips]
    with chaos { _ => bubble }
    with unwind (
      audio_close[mixer];
  );
  // Music leaves headroom for transient effects; effects themselves retain
  // their source amplitude and the mixer performs a final bounded clamp.
  audio_mixer_play[mixer, 0, 0, 1, 176];
  => doom_play_run_session_audio_on[
    session, initial_events, map, demo_mode, texture_mode, combat_mode,
    w, h, diag_mode, start_menu, menu_maps, input_log_path, mixer
  ];
)
has chaos {
  InvalidAudio(detail)
  SpeakerUnavailable(detail)
  BirthFailed(path)
  SpawnFailed(code)
  Handshake(detail)
  Disconnected(op)
}

op doom_play_music_warning [detail] (
  eprint["doom-play: music unavailable: ^{detail}; continuing silently"];
  => 0 - 1;
)

// Executable policy begins here. Everything above can be driven by focused
// tests; the CLI below selects one namespace from a path supplied by the user,
// opens one level-owned window at a time and never searches for game data.
let count = argc[];
if ((count >= 2) and (count <= 10)) () else (
  eprint["usage: doom-play <wad> [ExMy] [--resolution=WxH] [--demo] [--flat] [--static-sprites] [--diag] [--no-music] [--input-log=PATH]"];
  exit[2];
)
let selector = "";
let selector_set = 0;
let demo_mode = 0;
let texture_mode = 1;
let combat_mode = 1;
let render_w = 320;
let render_h = 200;
let resolution_set = 0;
let diagnostic_mode = 0;
let music_mode = 1;
let input_log_path = "";
let input_log_set = 0;
let ai = 2;
while (ai < count) (
  let arg = argv[ai];
  if (string_eq[arg, "--demo"] == 1) (
    if (demo_mode == 0) () else (
      eprint["doom-play: --demo was repeated"];
      exit[2];
    )
    demo_mode = 1;
  ) else if (string_eq[arg, "--flat"] == 1) (
    if (texture_mode == 1) () else (
      eprint["doom-play: --flat was repeated"];
      exit[2];
    )
    texture_mode = 0;
  ) else if (string_eq[arg, "--static-sprites"] == 1) (
    if (combat_mode == 1) () else (
      eprint["doom-play: --static-sprites was repeated"];
      exit[2];
    )
    combat_mode = 0;
  ) else if (string_eq[arg, "--diag"] == 1) (
    if (diagnostic_mode == 0) () else (
      eprint["doom-play: --diag was repeated"];
      exit[2];
    )
    diagnostic_mode = 1;
  ) else if (string_eq[arg, "--no-music"] == 1) (
    if (music_mode == 1) () else (
      eprint["doom-play: --no-music was repeated"];
      exit[2];
    )
    music_mode = 0;
  ) else if (string_starts_with[arg, "--input-log="] == 1) (
    if (input_log_set == 0) () else (
      eprint["doom-play: --input-log was repeated"];
      exit[2];
    )
    input_log_path = string_slice[arg, 12, str_len[arg] - 12];
    if (str_len[input_log_path] > 0) () else (
      eprint["doom-play: --input-log requires a non-empty path"];
      exit[2];
    )
    input_log_set = 1;
  ) else if (string_starts_with[arg, "--resolution="] == 1) (
    if (resolution_set == 0) () else (
      eprint["doom-play: --resolution was repeated"];
      exit[2];
    )
    let spec = string_slice[arg, 13, str_len[arg] - 13];
    let dimensions = string_split[spec, "x"];
    if (arr_len[dimensions] == 2) () else (
      eprint["doom-play: resolution must be WIDTHxHEIGHT"];
      exit[2];
    )
    render_w = string_to_int[dimensions\@0];
    render_h = string_to_int[dimensions\@1];
    if ((render_w >= 320) and (render_w <= 1280) and
        (render_h >= 200) and (render_h <= 800) and
        (render_w * 5 == render_h * 8) and
        (render_w * render_h <= 1024000)) () else (
      eprint["doom-play: resolution must be 8:5 within 320x200..1280x800"];
      exit[2];
    )
    resolution_set = 1;
  ) else if (string_starts_with[arg, "--"] == 1) (
    eprint["doom-play: unexpected option ^{arg}"];
    exit[2];
  ) else if (selector_set == 0) (
    selector = arg;
    selector_set = 1;
  ) else (
    eprint["doom-play: unexpected argument ^{arg}"];
    exit[2];
  )
  ai = ai + 1;
)
let catalog = doom_map_catalog[argv[1]];
if (catalog\ok == 1) () else (
  eprint["doom-play: ^{catalog\error}"];
  exit[1];
)
let playable_maps = catalog\maps;
if (arr_len[playable_maps] > 0) () else (
  eprint["doom-play: WAD contains no complete classic ExMy namespaces"];
  exit[1];
)
if (selector_set == 0) ( selector = playable_maps\@0; )
let selector_index = 0 - 1;
let selector_cursor = 0;
while (selector_cursor < arr_len[playable_maps]) (
  if (string_eq[playable_maps\@selector_cursor, selector] == 1) (
    selector_index = selector_cursor;
  )
  selector_cursor = selector_cursor + 1;
)
if (selector_index >= 0) () else (
  eprint["doom-play: ^{selector} is not a complete ExMy map in this WAD"];
  exit[2];
)
if ((str_len[input_log_path] == 0) or
    (doom_input_trace_reset[input_log_path] == 1)) () else (
  eprint["doom-play: cannot create input trace ^{input_log_path}"];
  exit[1];
)
let session_selector = selector;
let next_episode = 1;
let start_menu = 1 - demo_mode;
let music_cache = doom_audio_cache_disabled[];
if (music_mode == 1) (
  music_cache = doom_audio_cache_default[];
  if (music_cache\enabled == 1) (
    eprint["doom-play: music cache ^{music_cache\dir}"];
  )
)
while (next_episode > 0) (
  // The new level owns a new window, but it exists before its expensive map,
  // texture and FM-derived WAV work. This deliberately stops short of a
  // persistent-window coordinator or concurrent multi-level process model.
  let loading_window = doom_play_loading_window[
    session_selector, demo_mode, render_w, render_h
  ];
  if (loading_window\closed == 1) ( exit[0]; )
  let level_session = loading_window\session;
  let level_events = loading_window\events;
  let map = doom_map_load[argv[1], session_selector];
  if (map\ok == 1) () else (
    if (is_object[level_session]) ( gui_close[level_session]; )
    eprint["doom-play: ^{map\error}"];
    exit[1];
  )
  if (texture_mode == 1) (
    map = doom_texture_load_map[argv[1], map];
    if (map\ok == 1) () else (
      if (is_object[level_session]) ( gui_close[level_session]; )
      eprint["doom-play: ^{map\error}"];
      exit[1];
    )
  )
  let ran_session = 0;
  if (music_mode == 1) (
    eprint["doom-play: loading ^{session_selector} GENMIDI FM music"];
    let rendered = doom_audio_render_map_opl2_cached[
      argv[1], session_selector, music_cache
    ];
    if (rendered\ok == 1) (
      if (rendered\cache_status == 1) (
        eprint["doom-play: ^{session_selector} music cache hit"];
      ) else if (rendered\cache_status == 2) (
        eprint["doom-play: synthesized and cached ^{session_selector} music"];
      ) else (
        eprint["doom-play: synthesized ^{session_selector} music; cache unavailable"];
      )
      let status = 0 - 1;
      if (is_object[level_session]) (
        status = doom_play_with_music_on[
          level_session, level_events, map, demo_mode, texture_mode, combat_mode,
          render_w, render_h, diagnostic_mode, start_menu, rendered,
          playable_maps, input_log_path, argv[1]
        ] with chaos {
          InvalidAudio(detail) => doom_play_music_warning[detail]
          SpeakerUnavailable(detail) => doom_play_music_warning[detail]
          BirthFailed(path) => doom_play_music_warning[path]
          SpawnFailed(code) => doom_play_music_warning["spawn failed ^{code}"]
          Handshake(detail) => doom_play_music_warning[detail]
          Disconnected(op) => doom_play_music_warning[op]
        };
      ) else (
        let late_session = doom_play_open_window[
          map\name, demo_mode, render_w, render_h
        ];
        if (is_object[late_session]) (
          level_session = late_session;
          level_events = [];
          status = doom_play_with_music_on[
            level_session, level_events, map, demo_mode, texture_mode, combat_mode,
            render_w, render_h, diagnostic_mode, start_menu, rendered,
            playable_maps, input_log_path, argv[1]
          ] with chaos {
            InvalidAudio(detail) => doom_play_music_warning[detail]
            SpeakerUnavailable(detail) => doom_play_music_warning[detail]
            BirthFailed(path) => doom_play_music_warning[path]
            SpawnFailed(code) => doom_play_music_warning["spawn failed ^{code}"]
            Handshake(detail) => doom_play_music_warning[detail]
            Disconnected(op) => doom_play_music_warning[op]
          };
        )
      )
      if (status >= 0) (
        next_episode = status;
        ran_session = 1;
      )
    ) else (
      doom_play_music_warning[rendered\error];
    )
  )
  if (ran_session == 0) (
    if (is_object[level_session]) (
      next_episode = doom_play_run_session_on[
        level_session, level_events, map, demo_mode, texture_mode, combat_mode,
        render_w, render_h, diagnostic_mode, start_menu,
        playable_maps, input_log_path
      ];
    ) else (
      next_episode = doom_play_run_session[
        map, demo_mode, texture_mode, combat_mode,
        render_w, render_h, diagnostic_mode, start_menu,
        playable_maps, input_log_path
      ];
    )
  )
  start_menu = 0;
  if ((next_episode >= 1) and (next_episode <= arr_len[playable_maps])) (
    session_selector = doom_ui_map_selector[playable_maps, next_episode];
  ) else if (next_episode == 0) ()
  else ( fall "doom-play: menu returned an invalid checked map"; )
)
exit[0];
