// Freelang Doom Engine orchestration over the checked Doom modules. This file
// owns executable policy and the frame transaction; WAD interpretation,
// simulation, rendering and synthesis remain independently testable in their
// own modules. The only native-facing values are a pixel buffer, presenter
// records and bounded canonical WAV clips passed through f/gui and f/audio's
// process-isolated contracts.

credits: <../games/doom-view.flx> <../games/doom-input.flx>
         <../games/doom-input-trace.flx>
         <../games/doom-frame.flx>
         <../games/doom-session.flx>
         <../games/doom-world.flx> <../games/doom-ui.flx>
         <../games/doom-demo.flx> <../games/doom-audio.flx>
         <f/gui> <f/audio> <f/process> <f/time> <f/trig> <f/strings>;

op doom_play_run [map, demo_mode, texture_mode] (
  => doom_play_run_mode[map, demo_mode, texture_mode, 1];
)

op doom_play_run_mode [map, demo_mode, texture_mode, combat_mode] (
  => doom_play_run_mode_sized[
    map, demo_mode, texture_mode, combat_mode, 320, 200
  ];
)

op doom_play_run_mode_sized [map, demo_mode, texture_mode,
                             combat_mode, w, h] (
  => doom_play_run_session[
    map, demo_mode, texture_mode, combat_mode, w, h, 0, 0,
    ["E1M1", "E1M2"], ""
  ];
)

op doom_play_validate_dimensions [w, h] (
  if ((w >= 320) and (w <= 1280) and
      (h >= 200) and (h <= 800) and
      (w * 5 == h * 8) and (w * h <= 1024000)) () else (
    fall "doom_play_run_mode_sized: unsupported logical resolution";
  )
  => 0;
)

op doom_play_open_window [map_name, demo_mode, w, h] (
  doom_play_validate_dimensions[w, h];
  let session = 0;
  if (demo_mode == 1) (
    session = gui_open_fps_named[
      w, h, "Freelang Doom Engine — ^{map_name}", 60,
      "Freelang Doom Engine"
    ]
      with chaos { _ => 0 };
  ) else (
    session = gui_open_captured_resizable_fps_named[
      w, h, "Freelang Doom Engine — ^{map_name}", 60,
      "Freelang Doom Engine"
    ] with chaos { _ => 0 };
  )
  => session;
)

// Put a real first frame in the level's own window before WAD textures and
// derived music are loaded. `closed` distinguishes a user's early close from
// presenter birth failure; the latter retains the old post-load retry path.
op doom_play_loading_window [map_name, demo_mode, w, h] (
  let session = doom_play_open_window[map_name, demo_mode, w, h];
  if (is_object[session]) () else (
    => { session: 0, closed: 0, events: [] };
  )
  let buf = gui_buffer[w, h];
  let font = gui_font[];
  doom_ui_draw_loading[buf, w, h, font, map_name];
  let events = gui_present[session, buf] with chaos {
    _ => [{ kind: gui_ev_close[], a: 0, b: 0, mods: 0 }]
  };
  if (gui_has_close[events] == 1) (
    gui_close[session];
    => { session: 0, closed: 1, events: [] };
  )
  => { session: session, closed: 0, events: events };
)

op doom_play_run_session [map, demo_mode, texture_mode,
                          combat_mode, w, h, diag_mode, start_menu,
                          menu_maps, input_log_path] (
  let session = doom_play_open_window[map\name, demo_mode, w, h];
  if (is_object[session]) () else ( => 1; )
  => doom_play_run_session_on[
    session, [], map, demo_mode, texture_mode, combat_mode, w, h,
    diag_mode, start_menu, menu_maps, input_log_path
  ];
)

private op doom_play_run_session_carry [
  map, demo_mode, texture_mode, combat_mode, w, h, diag_mode,
  start_menu, menu_maps, input_log_path, carry
] (
  let session = doom_play_open_window[map\name, demo_mode, w, h];
  if (is_object[session]) () else (
    => { requested_episode: 0, carry: carry };
  )
  => doom_play_run_session_audio_carry_on[
    session, [], map, demo_mode, texture_mode, combat_mode, w, h,
    diag_mode, start_menu, menu_maps, input_log_path, 0, carry
  ];
)

// A session without mixer authority remains a fully playable silent session.
// Keeping that value explicit makes sound failure unable to affect simulation.
op doom_play_run_session_on [session, initial_events, map, demo_mode,
                             texture_mode, combat_mode, w, h, diag_mode,
                             start_menu, menu_maps, input_log_path] (
  => doom_play_run_session_audio_on[
    session, initial_events, map, demo_mode, texture_mode, combat_mode,
    w, h, diag_mode, start_menu, menu_maps, input_log_path, 0
  ];
)

private op doom_play_sound [audio_session, voice, clip, gain] (
  if (is_object[audio_session]) (
    => audio_mixer_play[audio_session, voice, clip, 0, gain];
  )
  => 0;
)


// The session emits only bounded semantic clip commands. This native adapter
// is the sole place where those commands gain speaker-sidecar authority.
private op doom_play_emit_sound_commands [audio_session, commands] (
  let i = 0;
  while (i < arr_len[commands]) (
    let command = commands\\i;
    doom_play_sound[
      audio_session, command\voice, command\clip, command\gain
    ];
    i = i + 1;
  )
  => 0;
)

// Optional filesystem tracing is a native diagnostic adapter, not part of the
// shared simulation step. The step retains only the bounded values needed to
// reproduce the existing version-4 evidence records.
private op doom_play_trace_transition [trace, state, events, before] (
  let frame = state\transition_frame;
  let controls = state\controls;
  let play_map = state\play_map;
  let world = state\world;
  let combat = state\combat;
  let move_result = state\move_result;
  trace = doom_input_trace_frame[
    trace, frame, events, before, controls, state\ui\open
  ];
  trace = doom_input_trace_movement[
    trace, frame,
    state\move_from_x, state\move_from_y, state\move_player_z,
    state\move_dx, state\move_dy, move_result,
    state\blocked_streak, state\contact_streak
  ];
  if ((trace\enabled == 1) and (state\blocked_streak > 0) and
      ((state\blocked_streak == 1) or
       (state\blocked_streak % 30 == 0))) (
    let stall_probe = doom_world_stall_probe[
      play_map, world,
      state\move_from_x, state\move_from_y,
      state\move_dx, state\move_dy
    ];
    if (state\combat_mode == 1) (
      stall_probe = doom_world_stall_probe_combat[
        play_map, world, combat,
        state\move_from_x, state\move_from_y,
        state\move_dx, state\move_dy
      ];
    )
    trace = doom_input_trace_stall[
      trace, frame,
      state\move_from_x, state\move_from_y, state\move_player_z,
      state\move_dx, state\move_dy, state\angle, controls,
      stall_probe, state\blocked_streak
    ];
  )
  if ((trace\enabled == 1) and (state\move_blocked == 1) and
      (state\move_moved == 1) and
      ((state\contact_streak == 1) or
       (state\contact_streak % 15 == 0))) (
    let contact_probe = doom_world_stall_probe[
      play_map, world,
      state\move_from_x, state\move_from_y,
      state\move_dx, state\move_dy
    ];
    if (state\combat_mode == 1) (
      contact_probe = doom_world_stall_probe_combat[
        play_map, world, combat,
        state\move_from_x, state\move_from_y,
        state\move_dx, state\move_dy
      ];
    )
    trace = doom_input_trace_contact[
      trace, frame,
      state\move_from_x, state\move_from_y, state\move_player_z,
      state\move_dx, state\move_dy, state\angle, controls,
      move_result, contact_probe, state\contact_streak
    ];
  )
  if ((trace\enabled == 1) and
      (state\previous_contact_streak > 0) and
      (state\contact_streak == 0)) (
    trace = doom_input_trace_resume[
      trace, frame,
      state\move_from_x, state\move_from_y, state\move_player_z,
      state\move_dx, state\move_dy, state\angle, controls,
      move_result, state\previous_contact_streak
    ];
  )
  trace = doom_input_trace_vertical[
    trace, frame,
    state\move_from_x, state\move_from_y,
    state\player_x, state\player_y,
    state\move_from_sector,
    doom_map_point_sector[play_map, state\player_x, state\player_y],
    state\move_player_z, world\player_z,
    state\move_player_vz, world\player_vz,
    state\move_grounded, world\grounded, move_result
  ];
  if (state\combat_mode == 1) (
    trace = doom_input_trace_drone[
      trace, frame, state\drone, state\combat, state\drone_deploy_ready
    ];
  )
  => trace;
)

private op doom_play_empty_carry [] (
  => { active: 0, map: 0, combat: 0 };
)

op doom_play_run_session_audio_on [session, initial_events, map, demo_mode,
                                   texture_mode, combat_mode, w, h, diag_mode,
                                   start_menu, menu_maps, input_log_path,
                                   audio_session] (
  let result = doom_play_run_session_audio_carry_on[
    session, initial_events, map, demo_mode, texture_mode, combat_mode,
    w, h, diag_mode, start_menu, menu_maps, input_log_path,
    audio_session, doom_play_empty_carry[]
  ];
  => result\requested_episode;
)

private op doom_play_run_session_audio_carry_on [
  session, initial_events, map, demo_mode,
  texture_mode, combat_mode, w, h, diag_mode,
  start_menu, menu_maps, input_log_path, audio_session, carry
] (
  let buf = gui_buffer[w, h];
  let font = gui_font[];
  let state = doom_session_new_seeded[
    map, initial_events, demo_mode, combat_mode,
    diag_mode, start_menu, menu_maps, now[] % 2147483647
  ];
  if ((combat_mode == 1) and (carry\active == 1)) (
    state\combat = doom_combat_carry_inventory[
      state\play_map, state\combat, carry\map, carry\combat
    ];
    state\alive = state\combat\alive;
  )
  // Keep the canonical 32/200 status strip outside the 3D viewport. The
  // renderer owns only this leading prefix of the full presenter buffer.
  let viewport_h = h - 32 * h / 200;
  let work = doom_view_work_sized[state\play_map, w, viewport_h];
  let status_cache = doom_ui_status_cache_new[
    w, h, state\play_map\texture_bank
  ];
  let input_trace = doom_input_trace_new[input_log_path, map\name];
  if (str_len[input_trace\error] > 0) (
    eprint["doom-play: ^{input_trace\error}"];
  )

  while (state\running == 1) (
    let frame_started = now[];
    doom_frame_draw[
      buf, w, h, viewport_h, font, state\play_map, work,
      state\player_x, state\player_y, state\angle, state\pitch,
      state\alive, state\kills, state\enemies, state\misses,
      state\steps, state\blocked,
      texture_mode, combat_mode, state\combat, state\world, state\drone,
      status_cache,
      diag_mode, demo_mode, state\controls, state\ui
    ];
    let render_done = now[];
    let events = gui_present[session, buf] with chaos {
      _ => [{ kind: gui_ev_close[], a: 0, b: 0, mods: 0 }]
    };
    let present_done = now[];
    let input_before = "";
    if (input_trace\enabled == 1) (
      input_before = doom_input_trace_snapshot[state\controls];
    )
    let retain_evidence = diag_mode;
    if (input_trace\enabled == 1) ( retain_evidence = 1; )
    state = doom_session_step[state, events, retain_evidence];
    input_trace = doom_play_trace_transition[
      input_trace, state, events, input_before
    ];
    doom_play_emit_sound_commands[audio_session, state\sounds];

    let frame_done = now[];
    if (diag_mode == 1) (
      if (frame_done - frame_started > 50000000) (
        eprint[
          "doom-diag slow frame=^{state\transition_frame} total_ms=^{(frame_done - frame_started) / 1000000} render_ms=^{(render_done - frame_started) / 1000000} present_ms=^{(present_done - render_done) / 1000000} sim_ms=^{(frame_done - present_done) / 1000000} pos=^{state\player_x},^{state\player_y},^{state\world\player_z} grounded=^{state\world\grounded} motion=^{state\move_dx},^{state\move_dy} moved=^{state\move_moved} blocked=^{state\move_blocked}"
        ];
      )
      if (state\transition_frame % 120 == 0) (
        eprint[
          "doom-diag heartbeat frame=^{state\transition_frame} total_ms=^{(frame_done - frame_started) / 1000000} pos=^{state\player_x},^{state\player_y},^{state\world\player_z} grounded=^{state\world\grounded}"
        ];
      )
    )
  )
  doom_input_trace_finish[input_trace, state\frame_index];
  gui_close[session];
  if (demo_mode == 1) (
    print "demo state: point ^{state\demo\point} phase ^{state\demo\phase} frame ^{state\demo\frame} at ^{state\player_x},^{state\player_y} heading ^{state\demo\heading}";
  )
  if (combat_mode == 1) (
    print "doom closed: ^{state\combat\kills}/^{state\combat\enemy_count} kills, ^{state\combat\shots} shots, ^{state\combat\misses} misses, ^{state\steps} moves, ^{state\blocked} blocked, ^{state\combat\health} health, ^{state\combat\ammo} ammo";
  ) else (
    print "doom closed: ^{state\kills}/^{state\enemies} kills, ^{state\steps} moves, ^{state\blocked} blocked";
  )
  => {
    requested_episode: state\requested_episode,
    carry: {
      active: combat_mode, map: state\play_map, combat: state\combat
    }
  };
)


op doom_play_with_music_on [session, initial_events, map, demo_mode,
                            texture_mode, combat_mode, w, h, diag_mode,
                            start_menu, rendered, menu_maps, input_log_path,
                            wad_path] (
  let result = doom_play_with_music_carry_on[
    session, initial_events, map, demo_mode, texture_mode, combat_mode,
    w, h, diag_mode, start_menu, rendered, menu_maps, input_log_path,
    wad_path, doom_play_empty_carry[]
  ];
  => result\requested_episode;
)
has chaos {
  InvalidAudio(detail)
  SpeakerUnavailable(detail)
  BirthFailed(path)
  SpawnFailed(code)
  Handshake(detail)
  Disconnected(op)
}

// One map session owns one looping synthesized score plus a bounded Doom-owned
// effect bank. The general mixer knows only canonical WAV clip indices. Normal
// return, map changes and bubbled failures all close its sidecar authority.
private op doom_play_with_music_carry_on [
  session, initial_events, map, demo_mode,
  texture_mode, combat_mode, w, h, diag_mode,
  start_menu, rendered, menu_maps, input_log_path, wad_path, carry
] (
  let effects = doom_audio_render_effects[wad_path];
  if (effects\ok == 1) () else (
    eprint[
      "doom-play: effects unavailable: ^{effects\error}; using music only"
    ];
    let music = audio_open_wav[rendered\wav, 1]
      with chaos { _ => bubble }
      with unwind ( audio_close[music]; );
    => doom_play_run_session_audio_carry_on[
      session, initial_events, map, demo_mode, texture_mode, combat_mode,
      w, h, diag_mode, start_menu, menu_maps, input_log_path, 0, carry
    ];
  )
  let clips = [rendered\wav] + effects\wavs;
  let mixer = audio_open_mixer[clips]
    with chaos { _ => bubble }
    with unwind (
      audio_close[mixer];
  );
  // Music leaves headroom for transient effects; effects themselves retain
  // their source amplitude and the mixer performs a final bounded clamp.
  audio_mixer_play[mixer, 0, 0, 1, 176];
  => doom_play_run_session_audio_carry_on[
    session, initial_events, map, demo_mode, texture_mode, combat_mode,
    w, h, diag_mode, start_menu, menu_maps, input_log_path, mixer, carry
  ];
)
has chaos {
  InvalidAudio(detail)
  SpeakerUnavailable(detail)
  BirthFailed(path)
  SpawnFailed(code)
  Handshake(detail)
  Disconnected(op)
}

op doom_play_music_warning [detail] (
  eprint["doom-play: music unavailable: ^{detail}; continuing silently"];
  => 0 - 1;
)

// Executable policy begins here. Everything above can be driven by focused
// tests; the CLI below selects one namespace from a path supplied by the user,
// opens one level-owned window at a time and never searches for game data.
let count = argc[];
if ((count >= 2) and (count <= 10)) () else (
  eprint["usage: doom-play <wad> [ExMy] [--resolution=WxH] [--demo] [--flat] [--static-sprites] [--diag] [--no-music] [--input-log=PATH]"];
  exit[2];
)
let selector = "";
let selector_set = 0;
let demo_mode = 0;
let texture_mode = 1;
let combat_mode = 1;
let render_w = 320;
let render_h = 200;
let resolution_set = 0;
let diagnostic_mode = 0;
let music_mode = 1;
let input_log_path = "";
let input_log_set = 0;
let ai = 2;
while (ai < count) (
  let arg = argv[ai];
  if (string_eq[arg, "--demo"] == 1) (
    if (demo_mode == 0) () else (
      eprint["doom-play: --demo was repeated"];
      exit[2];
    )
    demo_mode = 1;
  ) else if (string_eq[arg, "--flat"] == 1) (
    if (texture_mode == 1) () else (
      eprint["doom-play: --flat was repeated"];
      exit[2];
    )
    texture_mode = 0;
  ) else if (string_eq[arg, "--static-sprites"] == 1) (
    if (combat_mode == 1) () else (
      eprint["doom-play: --static-sprites was repeated"];
      exit[2];
    )
    combat_mode = 0;
  ) else if (string_eq[arg, "--diag"] == 1) (
    if (diagnostic_mode == 0) () else (
      eprint["doom-play: --diag was repeated"];
      exit[2];
    )
    diagnostic_mode = 1;
  ) else if (string_eq[arg, "--no-music"] == 1) (
    if (music_mode == 1) () else (
      eprint["doom-play: --no-music was repeated"];
      exit[2];
    )
    music_mode = 0;
  ) else if (string_starts_with[arg, "--input-log="] == 1) (
    if (input_log_set == 0) () else (
      eprint["doom-play: --input-log was repeated"];
      exit[2];
    )
    input_log_path = string_slice[arg, 12, str_len[arg] - 12];
    if (str_len[input_log_path] > 0) () else (
      eprint["doom-play: --input-log requires a non-empty path"];
      exit[2];
    )
    input_log_set = 1;
  ) else if (string_starts_with[arg, "--resolution="] == 1) (
    if (resolution_set == 0) () else (
      eprint["doom-play: --resolution was repeated"];
      exit[2];
    )
    let spec = string_slice[arg, 13, str_len[arg] - 13];
    let dimensions = string_split[spec, "x"];
    if (arr_len[dimensions] == 2) () else (
      eprint["doom-play: resolution must be WIDTHxHEIGHT"];
      exit[2];
    )
    render_w = string_to_int[dimensions\@0];
    render_h = string_to_int[dimensions\@1];
    if ((render_w >= 320) and (render_w <= 1280) and
        (render_h >= 200) and (render_h <= 800) and
        (render_w * 5 == render_h * 8) and
        (render_w * render_h <= 1024000)) () else (
      eprint["doom-play: resolution must be 8:5 within 320x200..1280x800"];
      exit[2];
    )
    resolution_set = 1;
  ) else if (string_starts_with[arg, "--"] == 1) (
    eprint["doom-play: unexpected option ^{arg}"];
    exit[2];
  ) else if (selector_set == 0) (
    selector = arg;
    selector_set = 1;
  ) else (
    eprint["doom-play: unexpected argument ^{arg}"];
    exit[2];
  )
  ai = ai + 1;
)
let catalog = doom_map_catalog[argv[1]];
if (catalog\ok == 1) () else (
  eprint["doom-play: ^{catalog\error}"];
  exit[1];
)
let playable_maps = catalog\maps;
if (arr_len[playable_maps] > 0) () else (
  eprint["doom-play: WAD contains no complete classic ExMy namespaces"];
  exit[1];
)
if (selector_set == 0) ( selector = playable_maps\@0; )
let selector_index = 0 - 1;
let selector_cursor = 0;
while (selector_cursor < arr_len[playable_maps]) (
  if (string_eq[playable_maps\@selector_cursor, selector] == 1) (
    selector_index = selector_cursor;
  )
  selector_cursor = selector_cursor + 1;
)
if (selector_index >= 0) () else (
  eprint["doom-play: ^{selector} is not a complete ExMy map in this WAD"];
  exit[2];
)
if ((str_len[input_log_path] == 0) or
    (doom_input_trace_reset[input_log_path] == 1)) () else (
  eprint["doom-play: cannot create input trace ^{input_log_path}"];
  exit[1];
)
let session_selector = selector;
let next_episode = 1;
let start_menu = 1 - demo_mode;
let inventory_carry = doom_play_empty_carry[];
let music_cache = doom_audio_cache_disabled[];
if (music_mode == 1) (
  music_cache = doom_audio_cache_default[];
  if (music_cache\enabled == 1) (
    eprint["doom-play: music cache ^{music_cache\dir}"];
  )
)
while (next_episode > 0) (
  // The new level owns a new window, but it exists before its expensive map,
  // texture and FM-derived WAV work. This deliberately stops short of a
  // persistent-window coordinator or concurrent multi-level process model.
  let loading_window = doom_play_loading_window[
    session_selector, demo_mode, render_w, render_h
  ];
  if (loading_window\closed == 1) ( exit[0]; )
  let level_session = loading_window\session;
  let level_events = loading_window\events;
  let map = doom_map_load[argv[1], session_selector];
  if (map\ok == 1) () else (
    if (is_object[level_session]) ( gui_close[level_session]; )
    eprint["doom-play: ^{map\error}"];
    exit[1];
  )
  if (texture_mode == 1) (
    map = doom_texture_load_map[argv[1], map];
    if (map\ok == 1) () else (
      if (is_object[level_session]) ( gui_close[level_session]; )
      eprint["doom-play: ^{map\error}"];
      exit[1];
    )
  )
  let ran_session = 0;
  if (music_mode == 1) (
    eprint["doom-play: loading ^{session_selector} GENMIDI FM music"];
    let rendered = doom_audio_render_map_opl2_cached[
      argv[1], session_selector, music_cache
    ];
    if (rendered\ok == 1) (
      if (rendered\cache_status == 1) (
        eprint["doom-play: ^{session_selector} music cache hit"];
      ) else if (rendered\cache_status == 2) (
        eprint["doom-play: synthesized and cached ^{session_selector} music"];
      ) else (
        eprint["doom-play: synthesized ^{session_selector} music; cache unavailable"];
      )
      let status = 0 - 1;
      if (is_object[level_session]) (
        status = doom_play_with_music_carry_on[
          level_session, level_events, map, demo_mode, texture_mode, combat_mode,
          render_w, render_h, diagnostic_mode, start_menu, rendered,
          playable_maps, input_log_path, argv[1], inventory_carry
        ] with chaos {
          InvalidAudio(detail) => doom_play_music_warning[detail]
          SpeakerUnavailable(detail) => doom_play_music_warning[detail]
          BirthFailed(path) => doom_play_music_warning[path]
          SpawnFailed(code) => doom_play_music_warning["spawn failed ^{code}"]
          Handshake(detail) => doom_play_music_warning[detail]
          Disconnected(op) => doom_play_music_warning[op]
        };
      ) else (
        let late_session = doom_play_open_window[
          map\name, demo_mode, render_w, render_h
        ];
        if (is_object[late_session]) (
          level_session = late_session;
          level_events = [];
          status = doom_play_with_music_carry_on[
            level_session, level_events, map, demo_mode, texture_mode, combat_mode,
            render_w, render_h, diagnostic_mode, start_menu, rendered,
            playable_maps, input_log_path, argv[1], inventory_carry
          ] with chaos {
            InvalidAudio(detail) => doom_play_music_warning[detail]
            SpeakerUnavailable(detail) => doom_play_music_warning[detail]
            BirthFailed(path) => doom_play_music_warning[path]
            SpawnFailed(code) => doom_play_music_warning["spawn failed ^{code}"]
            Handshake(detail) => doom_play_music_warning[detail]
            Disconnected(op) => doom_play_music_warning[op]
          };
        )
      )
      if (is_object[status]) (
        next_episode = status\requested_episode;
        inventory_carry = status\carry;
        ran_session = 1;
      )
    ) else (
      doom_play_music_warning[rendered\error];
    )
  )
  if (ran_session == 0) (
    if (is_object[level_session]) (
      let result = doom_play_run_session_audio_carry_on[
        level_session, level_events, map, demo_mode, texture_mode, combat_mode,
        render_w, render_h, diagnostic_mode, start_menu,
        playable_maps, input_log_path, 0, inventory_carry
      ];
      next_episode = result\requested_episode;
      inventory_carry = result\carry;
    ) else (
      let result = doom_play_run_session_carry[
        map, demo_mode, texture_mode, combat_mode,
        render_w, render_h, diagnostic_mode, start_menu,
        playable_maps, input_log_path, inventory_carry
      ];
      next_episode = result\requested_episode;
      inventory_carry = result\carry;
    )
  )
  start_menu = 0;
  if ((next_episode >= 1) and (next_episode <= arr_len[playable_maps])) (
    session_selector = doom_ui_map_selector[playable_maps, next_episode];
  ) else if (next_episode == 0) ()
  else ( fall "doom-play: menu returned an invalid checked map"; )
)
exit[0];
