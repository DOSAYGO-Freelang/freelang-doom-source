// Pure byte-level primitives shared by the WAD inspector and map loader.
// No filesystem module is credited here: command-line tools use f/files while
// GUI programs compose with f/files-chaos through f/gui.

credits: <f/bytes>;

op doom_wad_u16le [b, offset] (
  => bytes_get[b, offset] + bytes_get[b, offset + 1] * 256;
)

op doom_wad_u32le [b, offset] (
  => bytes_get[b, offset] +
    bytes_get[b, offset + 1] * 256 +
    bytes_get[b, offset + 2] * 65536 +
    bytes_get[b, offset + 3] * 16777216;
)

op doom_wad_magic [b, a, c, d, e] (
  if (bytes_len[b] >= 4) () else ( => 0; )
  => (bytes_get[b, 0] == a) and
    (bytes_get[b, 1] == c) and
    (bytes_get[b, 2] == d) and
    (bytes_get[b, 3] == e);
)

op doom_wad_directory_base [index] (
  => index * 16;
)

op doom_wad_name_byte [directory, index, position] (
  => bytes_get[directory, doom_wad_directory_base[index] + 8 + position];
)

op doom_wad_name_valid [directory, index] (
  let ended = 0;
  let i = 0;
  while (i < 8) (
    let c = doom_wad_name_byte[directory, index, i];
    if (ended == 1) (
      if (c != 0) ( => 0; )
    ) else if (c == 0) (
      ended = 1;
    ) else (
      if ((c < 32) or (c > 126)) ( => 0; )
    )
    i = i + 1;
  )
  => 1;
)

op doom_wad_name [directory, index] (
  let length = 0;
  while ((length < 8) and
         (doom_wad_name_byte[directory, index, length] != 0)) (
    length = length + 1;
  )
  let out = bytes_new[length];
  let i = 0;
  while (i < length) (
    let c = doom_wad_name_byte[directory, index, i];
    if ((c < 32) or (c > 126)) ( c = 63; )
    bytes_set[out, i, c];
    i = i + 1;
  )
  => ascii_to_string[out];
)

op doom_wad_names_equal [directory, left, right] (
  let i = 0;
  while (i < 8) (
    if (doom_wad_name_byte[directory, left, i] !=
        doom_wad_name_byte[directory, right, i]) ( => 0; )
    i = i + 1;
  )
  => 1;
)
