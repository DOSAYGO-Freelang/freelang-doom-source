// Doom map music selection and Freelang-owned MUS synthesis. Every input comes
// from the caller's current WAD; no score, instrument bank or rendered WAV is
// embedded in the program. f/audio receives only checked canonical WAV clips
// and never receives a WAD path, lump name or game-policy decision.

credits: <../games/doom-format.flx> <../games/doom-mus.flx>
         <../games/doom-opl2.flx> <../games/doom-laser.flx>
         <../games/doom-blaster-audio.flx>
         <f/files-chaos> <f/process> <f/strings>;

private op doom_audio_result [ok, error, track, wav, ticks, samples, events,
                              cache_status] (
  => {
    ok: ok, error: error, track: track, wav: wav,
    ticks: ticks, samples: samples, events: events,
    cache_status: cache_status
  };
)

private op doom_audio_error [message] (
  => doom_audio_result[0, message, "", bytes_new[0], 0, 0, 0, 0];
)

op doom_audio_empty_effects [] (
  => { ok: 0, error: "", wavs: [] };
)

private op doom_audio_effects_error [message] (
  => doom_audio_empty_effects[] + { error: message };
)

private op doom_audio_put_u16 [b, offset, value] (
  bytes_set[b, offset, value *& 255];
  bytes_set[b, offset + 1, (value *> 8) *& 255];
  => 0;
)

private op doom_audio_put_u32 [b, offset, value] (
  bytes_set[b, offset, value *& 255];
  bytes_set[b, offset + 1, (value *> 8) *& 255];
  bytes_set[b, offset + 2, (value *> 16) *& 255];
  bytes_set[b, offset + 3, (value *> 24) *& 255];
  => 0;
)

private op doom_audio_put_magic [b, offset, a, c, d, e] (
  bytes_set[b, offset, a]; bytes_set[b, offset + 1, c];
  bytes_set[b, offset + 2, d]; bytes_set[b, offset + 3, e];
  => 0;
)

// Doom sound lumps are format 3, little-endian rate/count, then unsigned
// 8-bit PCM. Freelang validates and wraps that data into the one canonical WAV
// species already accepted by f/audio; the sidecar still sees no WAD format.
op doom_audio_render_sound_lump [sound] (
  if ((bytes_len[sound] >= 9) and
      (doom_wad_u16le[sound, 0] == 3)) () else (
    => { ok: 0, error: "sound is not Doom PCM format 3",
         wav: bytes_new[0], ticks: 0 };
  )
  let rate = doom_wad_u16le[sound, 2];
  let samples = doom_wad_u32le[sound, 4];
  if ((rate >= 8000) and (rate <= 48000) and
      (samples > 0) and (samples <= 1048576) and
      (samples == bytes_len[sound] - 8)) () else (
    => { ok: 0, error: "Doom sound rate/count is outside bounded PCM",
         wav: bytes_new[0], ticks: 0 };
  )
  let wav = bytes_new[44 + samples];
  doom_audio_put_magic[wav, 0, 82, 73, 70, 70];
  doom_audio_put_u32[wav, 4, 36 + samples];
  doom_audio_put_magic[wav, 8, 87, 65, 86, 69];
  doom_audio_put_magic[wav, 12, 102, 109, 116, 32];
  doom_audio_put_u32[wav, 16, 16];
  doom_audio_put_u16[wav, 20, 1];
  doom_audio_put_u16[wav, 22, 1];
  doom_audio_put_u32[wav, 24, rate];
  doom_audio_put_u32[wav, 28, rate];
  doom_audio_put_u16[wav, 32, 1];
  doom_audio_put_u16[wav, 34, 8];
  doom_audio_put_magic[wav, 36, 100, 97, 116, 97];
  doom_audio_put_u32[wav, 40, samples];
  let i = 0;
  while (i < samples) (
    bytes_set[wav, 44 + i, bytes_get[sound, 8 + i]];
    i = i + 1;
  )
  => { ok: 1, error: "", wav: wav,
       ticks: (samples * 60 + rate - 1) / rate };
)

private op doom_audio_find_lump [directory, lump_count, name] (
  let i = lump_count - 1;
  while (i >= 0) (
    if (string_eq[doom_wad_name[directory, i], name] == 1) ( => i; )
    i = i - 1;
  )
  => 0 - 1;
)

private op doom_audio_load_sound [path, directory, lump_count,
                                  file_bytes, name] (
  let lump = doom_audio_find_lump[directory, lump_count, name];
  if (lump >= 0) () else (
    => { ok: 0, error: "WAD has no effective ^{name}",
         wav: bytes_new[0], ticks: 0 };
  )
  let offset = doom_wad_u32le[directory, lump * 16];
  let count = doom_wad_u32le[directory, lump * 16 + 4];
  if ((offset <= file_bytes) and (count <= file_bytes - offset)) () else (
    => { ok: 0, error: "^{name} exceeds WAD file",
         wav: bytes_new[0], ticks: 0 };
  )
  let sound = read_range[path, offset, count] with chaos { _ => bytes_new[0] };
  if (bytes_len[sound] == count) () else (
    => { ok: 0, error: "short ^{name} read",
         wav: bytes_new[0], ticks: 0 };
  )
  => doom_audio_render_sound_lump[sound];
)

private op doom_audio_load_sound_bytes [wad, directory, lump_count, name] (
  let lump = doom_audio_find_lump[directory, lump_count, name];
  if (lump >= 0) () else (
    => { ok: 0, error: "WAD has no effective ^{name}",
         wav: bytes_new[0], ticks: 0 };
  )
  let offset = doom_wad_u32le[directory, lump * 16];
  let count = doom_wad_u32le[directory, lump * 16 + 4];
  let file_bytes = bytes_len[wad];
  if ((offset <= file_bytes) and (count <= file_bytes - offset)) () else (
    => { ok: 0, error: "^{name} exceeds WAD bytes",
         wav: bytes_new[0], ticks: 0 };
  )
  => doom_audio_render_sound_lump[bytes_slice[wad, offset, count]];
)

op doom_audio_effect_names [] (
  => [
    "DSSAWFUL", "DSPISTOL", "DSSHOTGN", "DSRLAUNC",
    "DSITEMUP", "DSWPNUP", "DSDOROPN", "DSDORCLS",
    "DSSWTCHN", "DSSWTCHX", "DSTELEPT", "DSBAREXP",
    "DSPLPAIN", "DSPOSIT1", "DSSGTSIT", "DSBGSIT1",
    "DSSGTATK", "DSCLAW", "DSPOPAIN", "DSDMPAIN",
    "DSPODTH1", "DSSGTDTH", "DSBGDTH1", "DSRXPLOD",
    "DSFIRSHT", "DSFIRXPL", "DSCACSIT", "DSBRSSIT",
    "DSCYBSIT", "DSSPISIT", "DSSKLATK", "DSCACDTH",
    "DSBRSDTH", "DSSKLDTH", "DSCYBDTH", "DSSPIDTH",
    "DSPLASMA", "DSBFG", "DSGETPOW"
  ];
)

// SFX-only speakers retain the native mixer's clip numbering by reserving
// slot zero for a one-sample silent score. This is still canonical PCM and
// requires no browser-side knowledge of Doom's bank layout.
op doom_audio_silence_wav [] (
  let sound = bytes_new[9];
  doom_audio_put_u16[sound, 0, 3];
  doom_audio_put_u16[sound, 2, 8000];
  doom_audio_put_u32[sound, 4, 1];
  bytes_set[sound, 8, 128];
  let rendered = doom_audio_render_sound_lump[sound];
  => rendered\wav;
)

// Semantic effect slots live beside the stable WAD-lump bank they address.
// Gameplay emits only weapon/world/actor identities; orchestration never
// duplicates the numeric clip catalog.
op doom_audio_weapon_clip [weapon] (
  => doom_audio_weapon_clip_for[weapon, 1];
)

// Replays retain exact sound selection while consecutive laser shots walk a
// shuffled three-variant family instead of repeating one identical sample.
op doom_audio_weapon_clip_for [weapon, shot_serial] (
  if (weapon == 1) ( => 1; )
  if ((weapon == 2) or (weapon == 4)) ( => 2; )
  if (weapon == 3) ( => 3; )
  if (weapon == 5) ( => 4; )
  if (weapon == 6) ( => 37; )
  if (weapon == 7) ( => 38; )
  if (weapon == doom_laser_weapon[]) (
    let variant = (shot_serial * 1664525 + 1013904223) %
      doom_blaster_sound_count[];
    => doom_audio_laser_clip[variant];
  )
  => 2;
)

op doom_audio_laser_clip [variant] (
  if ((variant >= 0) and (variant < doom_blaster_sound_count[])) () else (
    fall "doom_audio_laser_clip: variant outside bounded family";
  )
  // Slot zero is the silent score and WAD effects occupy 1..N.
  => arr_len[doom_audio_effect_names[]] + 1 + variant;
)

op doom_audio_world_clip [kind] (
  if (kind == 1) ( => 7; )
  if (kind == 2) ( => 8; )
  if (kind == 3) ( => 9; )
  if (kind == 4) ( => 10; )
  if (kind == 5) ( => 11; )
  => 0;
)

op doom_audio_monster_alert_clip [kind] (
  if (kind == 3004) ( => 14; )
  if (kind == 9) ( => 15; )
  if (kind == 3001) ( => 16; )
  if ((kind == 3002) or (kind == 58)) ( => 15; )
  if (kind == 3005) ( => 27; )
  if (kind == 3006) ( => 16; )
  if (kind == 3003) ( => 28; )
  if (kind == 16) ( => 29; )
  if (kind == 7) ( => 30; )
  => 0;
)

op doom_audio_monster_attack_clip [kind] (
  if (kind == 3004) ( => 2; )
  if (kind == 9) ( => 17; )
  if (kind == 3001) ( => 25; )
  if ((kind == 3002) or (kind == 58)) ( => 17; )
  if ((kind == 3005) or (kind == 3003)) ( => 25; )
  if (kind == 3006) ( => 31; )
  if (kind == 16) ( => 4; )
  if (kind == 7) ( => 2; )
  => 0;
)

op doom_audio_monster_pain_clip [kind] (
  if ((kind == 3004) or (kind == 9)) ( => 19; )
  if ((kind == 3001) or (kind == 3002) or (kind == 58)) ( => 20; )
  if ((kind == 3005) or (kind == 3006) or (kind == 3003) or
      (kind == 16) or (kind == 7)) ( => 20; )
  => 0;
)

op doom_audio_monster_death_clip [kind] (
  if (kind == 3004) ( => 21; )
  if (kind == 9) ( => 22; )
  if (kind == 3001) ( => 23; )
  if ((kind == 3002) or (kind == 58)) ( => 22; )
  if (kind == 3005) ( => 32; )
  if (kind == 3003) ( => 33; )
  if (kind == 3006) ( => 34; )
  if (kind == 16) ( => 35; )
  if (kind == 7) ( => 36; )
  => 0;
)

op doom_audio_render_effects [path] (
  let file_bytes = size[path] with chaos { _ => 0 - 1 };
  if (file_bytes >= 12) () else ( => doom_audio_effects_error["short WAD file"]; )
  let header = read_range[path, 0, 12] with chaos { _ => bytes_new[0] };
  if (bytes_len[header] == 12) () else (
    => doom_audio_effects_error["short WAD header read"];
  )
  if ((doom_wad_magic[bytes_slice[header, 0, 4], 73, 87, 65, 68] == 1) or
      (doom_wad_magic[bytes_slice[header, 0, 4], 80, 87, 65, 68] == 1)) () else (
    => doom_audio_effects_error["not an IWAD or PWAD"];
  )
  let lump_count = doom_wad_u32le[header, 4];
  let directory_offset = doom_wad_u32le[header, 8];
  let directory_bytes = lump_count * 16;
  if ((lump_count <= 65536) and (directory_offset <= file_bytes) and
      (directory_bytes <= file_bytes - directory_offset)) () else (
    => doom_audio_effects_error["invalid WAD directory"];
  )
  let directory = read_range[path, directory_offset, directory_bytes]
    with chaos { _ => bytes_new[0] };
  if (bytes_len[directory] == directory_bytes) () else (
    => doom_audio_effects_error["short WAD directory read"];
  )
  // Stable game-owned order. The general mixer receives only this resulting
  // array of canonical WAV clips and has no knowledge of Doom lump semantics.
  let names = doom_audio_effect_names[];
  let wavs = [];
  let i = 0;
  while (i < arr_len[names]) (
    let effect = doom_audio_load_sound[
      path, directory, lump_count, file_bytes, names\\i
    ];
    if (effect\ok == 1) () else (
      => doom_audio_effects_error[effect\error];
    )
    wavs = wavs + [effect\wav];
    i = i + 1;
  )
  i = 0;
  while (i < doom_blaster_sound_count[]) (
    wavs = wavs + [doom_blaster_sound_wav[i]];
    i = i + 1;
  )
  => { ok: 1, error: "", wavs: wavs };
)

// In-memory twin of doom_audio_render_effects. Browser-selected WAD authority
// never becomes a path: Freelang validates directory spans and converts Doom
// format-3 sound lumps into the same canonical WAV bank used by native Doom.
op doom_audio_render_effects_bytes [wad] (
  let file_bytes = bytes_len[wad];
  if (file_bytes >= 12) () else ( => doom_audio_effects_error["short WAD bytes"]; )
  let magic = bytes_slice[wad, 0, 4];
  if ((doom_wad_magic[magic, 73, 87, 65, 68] == 1) or
      (doom_wad_magic[magic, 80, 87, 65, 68] == 1)) () else (
    => doom_audio_effects_error["not an IWAD or PWAD"];
  )
  let lump_count = doom_wad_u32le[wad, 4];
  let directory_offset = doom_wad_u32le[wad, 8];
  let directory_bytes = lump_count * 16;
  if ((lump_count <= 65536) and (directory_offset <= file_bytes) and
      (directory_bytes <= file_bytes - directory_offset)) () else (
    => doom_audio_effects_error["invalid WAD directory"];
  )
  let directory = bytes_slice[wad, directory_offset, directory_bytes];
  let names = doom_audio_effect_names[];
  let wavs = [];
  let i = 0;
  while (i < arr_len[names]) (
    let effect = doom_audio_load_sound_bytes[
      wad, directory, lump_count, names\\i
    ];
    if (effect\ok == 1) () else (
      => doom_audio_effects_error[effect\error];
    )
    wavs = wavs + [effect\wav];
    i = i + 1;
  )
  i = 0;
  while (i < doom_blaster_sound_count[]) (
    wavs = wavs + [doom_blaster_sound_wav[i]];
    i = i + 1;
  )
  => { ok: 1, error: "", wavs: wavs };
)

// Every checked classic episode namespace names its score by adding D_. The
// caller still has to prove that both the map namespace and effective music
// lump exist in its WAD; this helper admits no MAPxx or malformed selector.
op doom_audio_track_for_map [map_name] (
  if ((str_len[map_name] == 4) and
      (map_name\\0 == 69) and
      (map_name\\1 >= 49) and (map_name\\1 <= 57) and
      (map_name\\2 == 77) and
      (map_name\\3 >= 49) and (map_name\\3 <= 57)) (
    => "D_" + map_name;
  )
  => "";
)

op doom_audio_render_map [path, map_name] (
  let wanted = doom_audio_track_for_map[map_name];
  if (str_len[wanted] > 0) () else (
    => doom_audio_error["no bounded music mapping for ^{map_name}"];
  )
  let file_bytes = size[path] with chaos { _ => 0 - 1 };
  if (file_bytes >= 12) () else ( => doom_audio_error["short WAD file"]; )
  let header = read_range[path, 0, 12] with chaos { _ => bytes_new[0] };
  if (bytes_len[header] == 12) () else ( => doom_audio_error["short WAD header read"]; )
  let magic = bytes_slice[header, 0, 4];
  if ((doom_wad_magic[magic, 73, 87, 65, 68] == 1) or
      (doom_wad_magic[magic, 80, 87, 65, 68] == 1)) () else (
    => doom_audio_error["not an IWAD or PWAD"];
  )
  let lump_count = doom_wad_u32le[header, 4];
  let directory_offset = doom_wad_u32le[header, 8];
  let directory_bytes = lump_count * 16;
  if ((lump_count <= 65536) and (directory_offset <= file_bytes) and
      (directory_bytes <= file_bytes - directory_offset)) () else (
    => doom_audio_error["invalid WAD directory"];
  )
  let directory = read_range[path, directory_offset, directory_bytes]
    with chaos { _ => bytes_new[0] };
  if (bytes_len[directory] == directory_bytes) () else (
    => doom_audio_error["short WAD directory read"];
  )
  let selected_offset = 0;
  let selected_bytes = 0;
  let i = lump_count - 1;
  while ((i >= 0) and (selected_bytes == 0)) (
    if (string_eq[doom_wad_name[directory, i], wanted] == 1) (
      selected_offset = doom_wad_u32le[directory, i * 16];
      selected_bytes = doom_wad_u32le[directory, i * 16 + 4];
    )
    i = i - 1;
  )
  if (selected_bytes > 0) () else (
    => doom_audio_error["WAD has no effective ^{wanted} MUS lump"];
  )
  if ((selected_offset <= file_bytes) and
      (selected_bytes <= file_bytes - selected_offset)) () else (
    => doom_audio_error["music lump exceeds WAD file"];
  )
  let mus = read_range[path, selected_offset, selected_bytes]
    with chaos { _ => bytes_new[0] };
  if (bytes_len[mus] == selected_bytes) () else (
    => doom_audio_error["short ^{wanted} lump read"];
  )
  let rendered = doom_mus_render_wav[mus];
  if (rendered\ok == 1) () else ( => doom_audio_error[rendered\error]; )
  => doom_audio_result[
    1, "", wanted, rendered\wav, rendered\ticks, rendered\samples,
    rendered\events, 0
  ];
)

private op doom_audio_load_raw_lump [path, directory, lump_count,
                                     file_bytes, name, maximum] (
  let lump = doom_audio_find_lump[directory, lump_count, name];
  if (lump >= 0) () else (
    => { ok: 0, error: "WAD has no effective ^{name}", data: bytes_new[0] };
  )
  let offset = doom_wad_u32le[directory, lump * 16];
  let count = doom_wad_u32le[directory, lump * 16 + 4];
  if ((count > 0) and (count <= maximum)) () else (
    => { ok: 0, error: "^{name} exceeds its byte bound", data: bytes_new[0] };
  )
  if ((offset <= file_bytes) and (count <= file_bytes - offset)) () else (
    => { ok: 0, error: "^{name} exceeds WAD file", data: bytes_new[0] };
  )
  let data = read_range[path, offset, count]
    with chaos { _ => bytes_new[0] };
  if (bytes_len[data] == count) () else (
    => { ok: 0, error: "short ^{name} read", data: bytes_new[0] };
  )
  => { ok: 1, error: "", data: data };
)

private op doom_audio_load_raw_lump_bytes [wad, directory, lump_count,
                                           name, maximum] (
  let lump = doom_audio_find_lump[directory, lump_count, name];
  if (lump >= 0) () else (
    => { ok: 0, error: "WAD has no effective ^{name}", data: bytes_new[0] };
  )
  let offset = doom_wad_u32le[directory, lump * 16];
  let count = doom_wad_u32le[directory, lump * 16 + 4];
  let file_bytes = bytes_len[wad];
  if ((count > 0) and (count <= maximum)) () else (
    => { ok: 0, error: "^{name} exceeds its byte bound", data: bytes_new[0] };
  )
  if ((offset <= file_bytes) and (count <= file_bytes - offset)) () else (
    => { ok: 0, error: "^{name} exceeds WAD bytes", data: bytes_new[0] };
  )
  => { ok: 1, error: "", data: bytes_slice[wad, offset, count] };
)

private op doom_audio_opl2_inputs_error [message] (
  => {
    ok: 0, error: message, track: "",
    mus: bytes_new[0], bank: bytes_new[0]
  };
)

// Read the exact last-wins MUS and GENMIDI inputs before synthesis. Keeping
// this separate lets the gameplay cache key the inputs without first paying
// the renderer's cost; WAD structure and byte bounds remain checked here.
private op doom_audio_load_map_opl2_inputs [path, map_name] (
  let wanted = doom_audio_track_for_map[map_name];
  if (str_len[wanted] > 0) () else (
    => doom_audio_opl2_inputs_error[
      "no bounded music mapping for ^{map_name}"
    ];
  )
  let file_bytes = size[path] with chaos { _ => 0 - 1 };
  if (file_bytes >= 12) () else (
    => doom_audio_opl2_inputs_error["short WAD file"];
  )
  let header = read_range[path, 0, 12] with chaos { _ => bytes_new[0] };
  if (bytes_len[header] == 12) () else (
    => doom_audio_opl2_inputs_error["short WAD header read"];
  )
  let magic = bytes_slice[header, 0, 4];
  if ((doom_wad_magic[magic, 73, 87, 65, 68] == 1) or
      (doom_wad_magic[magic, 80, 87, 65, 68] == 1)) () else (
    => doom_audio_opl2_inputs_error["not an IWAD or PWAD"];
  )
  let lump_count = doom_wad_u32le[header, 4];
  let directory_offset = doom_wad_u32le[header, 8];
  let directory_bytes = lump_count * 16;
  if ((lump_count <= 65536) and (directory_offset <= file_bytes) and
      (directory_bytes <= file_bytes - directory_offset)) () else (
    => doom_audio_opl2_inputs_error["invalid WAD directory"];
  )
  let directory = read_range[path, directory_offset, directory_bytes]
    with chaos { _ => bytes_new[0] };
  if (bytes_len[directory] == directory_bytes) () else (
    => doom_audio_opl2_inputs_error["short WAD directory read"];
  )
  let mus = doom_audio_load_raw_lump[
    path, directory, lump_count, file_bytes, wanted, 1048576
  ];
  if (mus\ok == 1) () else (
    => doom_audio_opl2_inputs_error[mus\error];
  )
  let bank = doom_audio_load_raw_lump[
    path, directory, lump_count, file_bytes, "GENMIDI", 65536
  ];
  if (bank\ok == 1) () else (
    => doom_audio_opl2_inputs_error[bank\error];
  )
  => {
    ok: 1, error: "", track: wanted,
    mus: mus\data, bank: bank\data
  };
)

// In-memory twin for browser-selected authority. It applies the same
// last-wins directory policy and exact MUS/GENMIDI bounds without inventing a
// path or moving archive interpretation into JavaScript.
op doom_audio_load_map_opl2_inputs_bytes [wad, map_name] (
  let wanted = doom_audio_track_for_map[map_name];
  if (str_len[wanted] > 0) () else (
    => doom_audio_opl2_inputs_error[
      "no bounded music mapping for ^{map_name}"
    ];
  )
  let file_bytes = bytes_len[wad];
  if (file_bytes >= 12) () else (
    => doom_audio_opl2_inputs_error["short WAD bytes"];
  )
  let magic = bytes_slice[wad, 0, 4];
  if ((doom_wad_magic[magic, 73, 87, 65, 68] == 1) or
      (doom_wad_magic[magic, 80, 87, 65, 68] == 1)) () else (
    => doom_audio_opl2_inputs_error["not an IWAD or PWAD"];
  )
  let lump_count = doom_wad_u32le[wad, 4];
  let directory_offset = doom_wad_u32le[wad, 8];
  let directory_bytes = lump_count * 16;
  if ((lump_count <= 65536) and (directory_offset <= file_bytes) and
      (directory_bytes <= file_bytes - directory_offset)) () else (
    => doom_audio_opl2_inputs_error["invalid WAD directory"];
  )
  let directory = bytes_slice[wad, directory_offset, directory_bytes];
  let mus = doom_audio_load_raw_lump_bytes[
    wad, directory, lump_count, wanted, 1048576
  ];
  if (mus\ok == 1) () else (
    => doom_audio_opl2_inputs_error[mus\error];
  )
  let bank = doom_audio_load_raw_lump_bytes[
    wad, directory, lump_count, "GENMIDI", 65536
  ];
  if (bank\ok == 1) () else (
    => doom_audio_opl2_inputs_error[bank\error];
  )
  => {
    ok: 1, error: "", track: wanted,
    mus: mus\data, bank: bank\data
  };
)

// Render one admitted map through the WAD's effective GENMIDI bank. The
// complete bounded WAV remains Freelang-owned; f/audio receives no path or
// WAD semantics and the protocol remains the single-WAV v1 contract.
op doom_audio_render_map_opl2 [path, map_name] (
  let inputs = doom_audio_load_map_opl2_inputs[path, map_name];
  if (inputs\ok == 1) () else ( => doom_audio_error[inputs\error]; )
  let rendered = doom_mus_render_opl2_wav[inputs\mus, inputs\bank];
  if (rendered\ok == 1) () else ( => doom_audio_error[rendered\error]; )
  => doom_audio_result[
    1, "", inputs\track, rendered\wav, rendered\ticks, rendered\samples,
    rendered\events, 0
  ];
)

// Cache version is explicit authority over output semantics. Bump it whenever
// the FM renderer, GENMIDI interpretation or WAV parameters change.
op doom_audio_opl2_cache_version [] (
  => "freelang-doom-opl2-cache/1|renderer=2026-08-21.1|rate=22050|channels=1|bits=8";
)

op doom_audio_cache_disabled [] (
  => { enabled: 0, dir: "" };
)

private op doom_audio_cache_sep [] (
  if (os[] == 2) ( => "\"; )
  => "/";
)

private op doom_audio_cache_join [base, name] (
  if ((string_ends_with[base, "/"] == 1) or
      (string_ends_with[base, "\"] == 1)) ( => base + name; )
  => base + doom_audio_cache_sep[] + name;
)

private op doom_audio_cache_ensure_dir [path] (
  if (str_len[path] == 0) ( => 0; )
  if (is_dir_raw[path] == 1) ( => 1; )
  if (exists_raw[path] == 1) ( => 0; )
  mkdir_raw[path];
  => is_dir_raw[path];
)

// Explicit-root constructor is primarily a deterministic test seam and a
// caller override. Its parent must already exist; the named leaf is created.
op doom_audio_cache_at [dir] (
  if (doom_audio_cache_ensure_dir[dir] == 1) () else (
    => doom_audio_cache_disabled[];
  )
  let normalized = dir;
  if ((string_ends_with[normalized, "/"] == 1) or
      (string_ends_with[normalized, "\"] == 1)) () else (
    normalized = normalized + doom_audio_cache_sep[];
  )
  => { enabled: 1, dir: normalized };
)

// Platform cache policy is Doom-owned, not an f/audio responsibility.
// FREELANG_DOOM_MUSIC_CACHE is an optional exact-root override.
op doom_audio_cache_default [] (
  let override = getenv["FREELANG_DOOM_MUSIC_CACHE"];
  if (str_len[override] > 0) ( => doom_audio_cache_at[override]; )

  let platform = os[];
  let base = "";
  if (platform == 1) (
    let home = getenv["HOME"];
    if (str_len[home] > 0) (
      base = doom_audio_cache_join[home, "Library"];
      if (doom_audio_cache_ensure_dir[base] == 1) (
        base = doom_audio_cache_join[base, "Caches"];
      ) else ( base = ""; )
    )
  ) else if (platform == 0) (
    base = getenv["XDG_CACHE_HOME"];
    if (str_len[base] == 0) (
      let home = getenv["HOME"];
      if (str_len[home] > 0) (
        base = doom_audio_cache_join[home, ".cache"];
      )
    )
  ) else if (platform == 2) (
    base = getenv["LOCALAPPDATA"];
  )
  if (doom_audio_cache_ensure_dir[base] == 1) () else (
    => doom_audio_cache_disabled[];
  )
  let vendor = doom_audio_cache_join[base, "dosaygo"];
  if (doom_audio_cache_ensure_dir[vendor] == 1) () else (
    => doom_audio_cache_disabled[];
  )
  let app = doom_audio_cache_join[vendor, "freelang-doom"];
  if (doom_audio_cache_ensure_dir[app] == 1) () else (
    => doom_audio_cache_disabled[];
  )
  => doom_audio_cache_at[doom_audio_cache_join[app, "music"]];
)

// Two content digests keep key construction bounded even for the 1 MiB MUS
// limit. The final digest makes the filename fixed-width and path-safe.
op doom_audio_cache_key [mus, bank] (
  let material = doom_audio_opl2_cache_version[] +
    "|mus=" + rainbow256[mus] + "|genmidi=" + rainbow256[bank];
  => rainbow256[string_to_utf8_bytes[material]];
)

private op doom_audio_prepared_error [message] (
  => {
    ok: 0, error: message, track: "", key: "",
    mus: bytes_new[0], bank: bytes_new[0],
    ticks: 0, samples: 0, events: 0
  };
)

// Prepare the exact semantic cache key and expected WAV shape without paying
// the FM renderer. This is the async browser seam: a cache miss later renders
// from these retained Freelang-owned inputs inside the WASM Worker.
op doom_audio_prepare_map_opl2_bytes [wad, map_name] (
  let inputs = doom_audio_load_map_opl2_inputs_bytes[wad, map_name];
  if (inputs\ok == 1) () else ( => doom_audio_prepared_error[inputs\error]; )
  let bank_valid = doom_opl_bank_validate[inputs\bank];
  if (bank_valid\ok == 1) () else ( => doom_audio_prepared_error[bank_valid\error]; )
  let decoded = doom_mus_decode[inputs\mus];
  if (decoded\ok == 1) () else ( => doom_audio_prepared_error[decoded\error]; )
  let samples = decoded\ticks * 22050 / 140;
  if ((samples > 0) and (samples <= 22050 * 600)) () else (
    => doom_audio_prepared_error["render exceeds ten minutes"];
  )
  => {
    ok: 1, error: "", track: inputs\track,
    key: doom_audio_cache_key[inputs\mus, inputs\bank],
    mus: inputs\mus, bank: inputs\bank,
    ticks: decoded\ticks, samples: samples, events: decoded\events
  };
)

op doom_audio_render_prepared_opl2 [prepared] (
  if (prepared\ok == 1) () else ( => doom_audio_error[prepared\error]; )
  let rendered = doom_mus_render_opl2_wav[prepared\mus, prepared\bank];
  if (rendered\ok == 1) () else ( => doom_audio_error[rendered\error]; )
  => doom_audio_result[
    1, "", prepared\track, rendered\wav, rendered\ticks,
    rendered\samples, rendered\events, 0
  ];
)

private op doom_audio_cache_key_ok [key] (
  if (str_len[key] == 64) () else ( => 0; )
  let i = 0;
  while (i < 64) (
    let c = key\\i;
    let hex = 0;
    if ((c >= 48) and (c <= 57)) ( hex = 1; )
    if ((c >= 97) and (c <= 102)) ( hex = 1; )
    if (hex == 1) () else ( => 0; )
    i = i + 1;
  )
  => 1;
)

op doom_audio_cache_entry_path [cache, map_name, key] (
  if (cache\enabled == 1) () else ( => ""; )
  if (str_len[doom_audio_track_for_map[map_name]] > 0) () else ( => ""; )
  if (doom_audio_cache_key_ok[key] == 1) () else ( => ""; )
  => cache\dir + map_name + "-" + key + ".wav";
)

private op doom_audio_cache_named_map_entry [name, map_name] (
  if ((str_len[name] == 73) and
      (string_starts_with[name, map_name + "-"] == 1) and
      (string_ends_with[name, ".wav"] == 1)) () else ( => 0; )
  let i = 5;
  while (i < 69) (
    let c = name\\i;
    let hex = 0;
    if ((c >= 48) and (c <= 57)) ( hex = 1; )
    if ((c >= 97) and (c <= 102)) ( hex = 1; )
    if (hex == 1) () else ( => 0; )
    i = i + 1;
  )
  => 1;
)

// Keep at most one derived WAV per bounded ExMy selector. Across E1M1..E9M9
// that caps the cache at 81 validated files even as WADs or renderer versions
// change. Unrecognized files are never removed.
private op doom_audio_cache_prune_map [cache, map_name, keep_name] (
  if (cache\enabled == 1) () else ( => 0; )
  let names = list_raw[cache\dir];
  let i = 0;
  while (i < arr_len[names]) (
    let name = names\\i;
    if ((doom_audio_cache_named_map_entry[name, map_name] == 1) and
        (string_eq[name, keep_name] == 0)) (
      remove_raw[cache\dir + name];
    )
    i = i + 1;
  )
  => 0;
)

op doom_audio_cache_wav_valid [wav, expected_samples] (
  let n = bytes_len[wav];
  if ((expected_samples > 0) and
      (expected_samples <= 22050 * 600) and
      (n == 44 + expected_samples)) () else ( => 0; )
  if ((doom_wad_magic[bytes_slice[wav, 0, 4], 82, 73, 70, 70] == 1) and
      (doom_wad_magic[bytes_slice[wav, 8, 4], 87, 65, 86, 69] == 1) and
      (doom_wad_magic[bytes_slice[wav, 12, 4], 102, 109, 116, 32] == 1) and
      (doom_wad_magic[bytes_slice[wav, 36, 4], 100, 97, 116, 97] == 1)) ()
  else ( => 0; )
  => (doom_wad_u32le[wav, 4] == n - 8) and
     (doom_wad_u32le[wav, 16] == 16) and
     (doom_wad_u16le[wav, 20] == 1) and
     (doom_wad_u16le[wav, 22] == 1) and
     (doom_wad_u32le[wav, 24] == 22050) and
     (doom_wad_u32le[wav, 28] == 22050) and
     (doom_wad_u16le[wav, 32] == 1) and
     (doom_wad_u16le[wav, 34] == 8) and
     (doom_wad_u32le[wav, 40] == expected_samples);
)

op doom_audio_cache_read_wav [path, expected_samples] (
  if (is_file_raw[path] == 1) () else ( => bytes_new[0]; )
  let n = size_raw[path];
  if (n == 44 + expected_samples) () else ( => bytes_new[0]; )
  let wav = read_bytes_raw[path];
  if (doom_audio_cache_wav_valid[wav, expected_samples] == 1) ( => wav; )
  => bytes_new[0];
)

// Validate before and after writing, then publish through replace-rename. A
// crash can leave only the pid-scoped temp; no partial final WAV is visible.
op doom_audio_cache_publish_wav [path, wav, expected_samples] (
  if (doom_audio_cache_wav_valid[wav, expected_samples] == 1) () else ( => 0; )
  let tmp = "^{path}.^{pid[]}.tmp";
  if (exists_raw[tmp] == 1) ( remove_raw[tmp]; )
  if (write_bytes_raw[tmp, wav] == 0) () else ( => 0; )
  let stored = read_bytes_raw[tmp];
  let exact = doom_audio_cache_wav_valid[stored, expected_samples] and
    string_eq[rainbow256[stored], rainbow256[wav]];
  if (exact == 1) () else (
    remove_raw[tmp];
    => 0;
  )
  if (move_raw[tmp, path] == 0) ( => 1; )
  remove_raw[tmp];
  => 0;
)

// Status: 1 hit, 2 miss stored, 3 miss rendered but cache unavailable.
op doom_audio_render_map_opl2_cached [path, map_name, cache] (
  let inputs = doom_audio_load_map_opl2_inputs[path, map_name];
  if (inputs\ok == 1) () else ( => doom_audio_error[inputs\error]; )
  let bank_valid = doom_opl_bank_validate[inputs\bank];
  if (bank_valid\ok == 1) () else ( => doom_audio_error[bank_valid\error]; )
  let decoded = doom_mus_decode[inputs\mus];
  if (decoded\ok == 1) () else ( => doom_audio_error[decoded\error]; )
  let expected_samples = decoded\ticks * 22050 / 140;
  let key = doom_audio_cache_key[inputs\mus, inputs\bank];
  let entry_name = map_name + "-" + key + ".wav";
  let entry = doom_audio_cache_entry_path[cache, map_name, key];
  if (cache\enabled == 1) (
    let hit = doom_audio_cache_read_wav[entry, expected_samples];
    if (bytes_len[hit] > 0) (
      => doom_audio_result[
        1, "", inputs\track, hit, decoded\ticks, expected_samples,
        decoded\events, 1
      ];
    )
  )

  let rendered = doom_mus_render_opl2_wav[inputs\mus, inputs\bank];
  if (rendered\ok == 1) () else ( => doom_audio_error[rendered\error]; )
  let cache_status = 3;
  if ((cache\enabled == 1) and
      (doom_audio_cache_publish_wav[
         entry, rendered\wav, rendered\samples
       ] == 1)) (
    cache_status = 2;
    doom_audio_cache_prune_map[cache, map_name, entry_name];
  )
  => doom_audio_result[
    1, "", inputs\track, rendered\wav, rendered\ticks, rendered\samples,
    rendered\events, cache_status
  ];
)
