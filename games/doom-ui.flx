// WAD-native Doom status and menu composition. The presenter remains a pixel
// sink: layout, menu state and every decision stay deterministic in Freelang.

credits: <../games/doom-combat.flx> <f/gui> <f/strings>;

op doom_ui_new [] (
  => doom_ui_new_for_map["E1M2"];
)

private op doom_ui_default_maps [] ( => ["E1M1", "E1M2"]; )

op doom_ui_new_for_maps [maps, map_name] (
  if ((arr_len[maps] > 0) and (arr_len[maps] <= 81)) () else (
    fall "doom_ui_new_for_maps: classic map count outside 1..81";
  )
  let cursor = 0;
  let found = 0;
  let i = 0;
  while (i < arr_len[maps]) (
    if (string_eq[maps\@i, map_name] == 1) (
      cursor = i;
      found = 1;
    )
    i = i + 1;
  )
  if (found == 1) () else (
    fall "doom_ui_new_for_maps: current map is absent from menu";
  )
  let top = cursor - 3;
  if (top < 0) ( top = 0; )
  if (top + 7 > arr_len[maps]) ( top = arr_len[maps] - 7; )
  if (top < 0) ( top = 0; )
  => {
    open: 0, cursor: cursor, top: top, maps: maps,
    look_speed: 1, selection: 0
  };
)

op doom_ui_new_for_map [map_name] (
  => doom_ui_new_for_maps[doom_ui_default_maps[], map_name];
)

op doom_ui_map_selector [maps, selection] (
  if ((selection >= 1) and (selection <= arr_len[maps])) (
    => maps\@(selection - 1);
  )
  fall "doom_ui_map_selector: selection outside checked map menu";
)

// Compatibility name retained for callers that still use the original
// two-entry application fixture.
op doom_ui_episode_selector [selection] (
  => doom_ui_map_selector[doom_ui_default_maps[], selection];
)

// Asset-independent first frame: it is available before the caller has
// parsed map geometry, WAD patches or a derived music cache entry.
op doom_ui_draw_loading [buf, w, h, font, map_name] (
  gui_fill[buf, gui_rgb[14, 10, 12]];
  let heading = "FREELANG DOOM";
  let loading = "LOADING ^{map_name}...";
  gui_text_scaled[
    buf, w, h, font, (w - str_len[heading] * 16) / 2, h / 2 - 25,
    heading, gui_rgb[190, 32, 24], 2
  ];
  gui_text[
    buf, w, h, font, (w - str_len[loading] * 8) / 2, h / 2 + 9,
    loading, gui_rgb[218, 206, 172]
  ];
  => 1;
)

op doom_ui_next [ui, events] (
  ui\selection = 0;
  if (gui_key_pressed[events, gui_key_esc[]] == 1) (
    if (ui\open == 0) (
      ui\open = 1;
    ) else (
      ui\open = 0;
    )
    => ui;
  )
  if (ui\open == 0) ( => ui; )

  if (gui_key_pressed[events, gui_key_up[]] == 1) (
    ui\cursor = ui\cursor - 1;
    if (ui\cursor < 0) ( ui\cursor = arr_len[ui\maps] - 1; )
  )
  if (gui_key_pressed[events, gui_key_down[]] == 1) (
    ui\cursor = ui\cursor + 1;
    if (ui\cursor >= arr_len[ui\maps]) ( ui\cursor = 0; )
  )
  if (ui\cursor < ui\top) ( ui\top = ui\cursor; )
  if (ui\cursor >= ui\top + 7) ( ui\top = ui\cursor - 6; )
  let max_top = arr_len[ui\maps] - 7;
  if (max_top < 0) ( max_top = 0; )
  if (ui\top > max_top) ( ui\top = max_top; )
  if (ui\top < 0) ( ui\top = 0; )
  if (ui\cursor >= arr_len[ui\maps]) (
    fall "doom_ui_next: cursor escaped checked map menu";
  )
  if (gui_key_pressed[events, gui_key_return[]] == 1) (
    ui\selection = ui\cursor + 1;
    ui\open = 0;
  )
  => ui;
)

op doom_ui_draw_patch_scaled [buf, w, h, bank, slot, x, y,
                              scale_numerator, scale_denominator] (
  let ui_meta = bank\ui_meta;
  let ui_pixels = bank\ui_pixels;
  let ui_opaque = bank\ui_opaque;
  let rgbx_colours = bank\rgbx_colours;
  if ((bank\ui_ready == 1) and
      (bank\ui_slots == doom_texture_ui_slots[]) and
      (slot >= 0) and (slot < bank\ui_slots) and
      (scale_numerator > 0) and (scale_denominator > 0) and
      (buf_len[ui_meta] == bank\ui_slots * 5) and
      (bytes_len[ui_pixels] == bytes_len[ui_opaque])) () else (
    => 0;
  )
  let mb = slot * 5;
  let pw = buf_get[ui_meta, mb];
  let ph = buf_get[ui_meta, mb + 1];
  let offset = buf_get[ui_meta, mb + 2];
  if ((pw > 0) and (ph > 0) and (offset >= 0) and
      (pw * ph <= bytes_len[ui_pixels] - offset)) () else ( => 0; )
  view rgbx as %32le[] over buf;
  let drawn_width = pw * scale_numerator / scale_denominator;
  let drawn_height = ph * scale_numerator / scale_denominator;
  if (drawn_width < 1) ( drawn_width = 1; )
  if (drawn_height < 1) ( drawn_height = 1; )
  let painted = 0;
  // Full-frame 640x400 and 1280x800 status layers are exact 2x/4x views of
  // the original 320x200 art. Walk source texels once for those integer
  // scales: each admitted palette lookup owns a compact destination block,
  // avoiding repeated nearest-neighbour division and opacity reads.
  let integer_scale = scale_numerator / scale_denominator;
  if (((integer_scale == 1) or (integer_scale == 2) or
       (integer_scale == 3) or (integer_scale == 4)) and
      (scale_numerator == integer_scale * scale_denominator)) (
    let sy = 0;
    while (sy < ph) (
      let sx = 0;
      while (sx < pw) (
        let source = offset + sy * pw + sx;
        if (bytes_get[ui_opaque, source] == 1) (
          let packed_colour = buf_get[
            rgbx_colours, bytes_get[ui_pixels, source]
          ];
          let repeat_y = 0;
          while (repeat_y < integer_scale) (
            let dy = y + sy * integer_scale + repeat_y;
            if ((dy >= 0) and (dy < h)) (
              let repeat_x = 0;
              while (repeat_x < integer_scale) (
                let dx = x + sx * integer_scale + repeat_x;
                if ((dx >= 0) and (dx < w)) (
                  rgbx@(dy * w + dx) = packed_colour;
                  painted = painted + 1;
                )
                repeat_x = repeat_x + 1;
              )
            )
            repeat_y = repeat_y + 1;
          )
        )
        sx = sx + 1;
      )
      sy = sy + 1;
    )
    => painted;
  )
  let ty = 0;
  while (ty < drawn_height) (
    let sy = ty * ph / drawn_height;
    let dy = y + ty;
    if ((dy >= 0) and (dy < h)) (
      let tx = 0;
      while (tx < drawn_width) (
        let sx = tx * pw / drawn_width;
        let dx = x + tx;
        let source = offset + sy * pw + sx;
        if ((dx >= 0) and (dx < w) and
            (bytes_get[ui_opaque, source] == 1)) (
          let packed_colour = buf_get[
            rgbx_colours, bytes_get[ui_pixels, source]
          ];
          let pixel = dy * w + dx;
          rgbx@pixel = packed_colour;
          painted = painted + 1;
        )
        tx = tx + 1;
      )
    )
    ty = ty + 1;
  )
  => painted;
)

op doom_ui_draw_patch [buf, w, h, bank, slot, x, y] (
  => doom_ui_draw_patch_scaled[buf, w, h, bank, slot, x, y, 1, 1];
)

private op doom_ui_patch_width [bank, slot] (
  if ((slot >= 0) and (slot < bank\ui_slots)) (
    => buf_get[bank\ui_meta, slot * 5];
  )
  => 0;
)

op doom_ui_text_width_scaled [bank, text, numerator, denominator] (
  if ((numerator > 0) and (denominator > 0)) () else ( => 0; )
  let width = 0;
  let i = 0;
  while (i < str_len[text]) (
    let c = text\\i;
    if (c == 32) ( width = width + 4 * numerator / denominator; )
    else if ((c >= 33) and (c <= 95)) (
      width = width +
        (doom_ui_patch_width[bank, doom_texture_ui_font_slot[c]] + 1) *
          numerator / denominator;
    )
    i = i + 1;
  )
  => width;
)

op doom_ui_text_width [bank, text] (
  => doom_ui_text_width_scaled[bank, text, 1, 1];
)

op doom_ui_draw_text_scaled [buf, w, h, bank, x, y, text,
                             numerator, denominator] (
  if ((numerator > 0) and (denominator > 0)) () else ( => 0; )
  let cursor = x;
  let i = 0;
  while (i < str_len[text]) (
    let c = text\\i;
    if (c == 32) (
      cursor = cursor + 4 * numerator / denominator;
    ) else if ((c >= 33) and (c <= 95)) (
      let slot = doom_texture_ui_font_slot[c];
      doom_ui_draw_patch_scaled[
        buf, w, h, bank, slot, cursor, y, numerator, denominator
      ];
      cursor = cursor +
        (doom_ui_patch_width[bank, slot] + 1) * numerator / denominator;
    )
    i = i + 1;
  )
  => cursor - x;
)

op doom_ui_draw_text [buf, w, h, bank, x, y, text] (
  => doom_ui_draw_text_scaled[buf, w, h, bank, x, y, text, 1, 1];
)

private op doom_ui_number_width [bank, text, small, yellow] (
  let width = 0;
  let i = 0;
  while (i < str_len[text]) (
    let digit = text\\i - 48;
    let slot = doom_texture_ui_big_number_slot[digit];
    if (small == 1) (
      slot = doom_texture_ui_gray_number_slot[digit];
      if (yellow == 1) ( slot = doom_texture_ui_yellow_number_slot[digit]; )
    )
    width = width + doom_ui_patch_width[bank, slot];
    i = i + 1;
  )
  => width;
)

private op doom_ui_draw_number_right [buf, w, h, bank, right, y,
                                      value, small, yellow] (
  let shown = value;
  if (shown < 0) ( shown = 0; )
  if (shown > 999) ( shown = 999; )
  let text = int_to_string[shown];
  let x = right - doom_ui_number_width[bank, text, small, yellow];
  let i = 0;
  while (i < str_len[text]) (
    let digit = text\\i - 48;
    let slot = doom_texture_ui_big_number_slot[digit];
    if (small == 1) (
      slot = doom_texture_ui_gray_number_slot[digit];
      if (yellow == 1) ( slot = doom_texture_ui_yellow_number_slot[digit]; )
    )
    doom_ui_draw_patch[buf, w, h, bank, slot, x, y];
    x = x + doom_ui_patch_width[bank, slot];
    i = i + 1;
  )
  => 0;
)

private op doom_ui_number_width_scaled [bank, text, small, yellow,
                                        numerator, denominator] (
  let width = 0;
  let i = 0;
  while (i < str_len[text]) (
    let digit = text\\i - 48;
    let slot = doom_texture_ui_big_number_slot[digit];
    if (small == 1) (
      slot = doom_texture_ui_gray_number_slot[digit];
      if (yellow == 1) ( slot = doom_texture_ui_yellow_number_slot[digit]; )
    )
    width = width +
      doom_ui_patch_width[bank, slot] * numerator / denominator;
    i = i + 1;
  )
  => width;
)

private op doom_ui_draw_number_right_scaled [buf, w, h, bank, right, y,
                                             value, small, yellow,
                                             numerator, denominator] (
  let shown = value;
  if (shown < 0) ( shown = 0; )
  if (shown > 999) ( shown = 999; )
  let text = int_to_string[shown];
  let x = right - doom_ui_number_width_scaled[
    bank, text, small, yellow, numerator, denominator
  ];
  let i = 0;
  while (i < str_len[text]) (
    let digit = text\\i - 48;
    let slot = doom_texture_ui_big_number_slot[digit];
    if (small == 1) (
      slot = doom_texture_ui_gray_number_slot[digit];
      if (yellow == 1) ( slot = doom_texture_ui_yellow_number_slot[digit]; )
    )
    doom_ui_draw_patch_scaled[
      buf, w, h, bank, slot, x, y, numerator, denominator
    ];
    x = x + doom_ui_patch_width[bank, slot] * numerator / denominator;
    i = i + 1;
  )
  => 0;
)

private op doom_ui_draw_status_static [buf, w, h, bank,
                                       scale_n, scale_d, bx, by] (
  doom_ui_draw_patch_scaled[
    buf, w, h, bank, doom_texture_ui_status_slot[], bx, by,
    scale_n, scale_d
  ];
  doom_ui_draw_patch_scaled[
    buf, w, h, bank, doom_texture_ui_arms_slot[],
    bx + 104 * scale_n / scale_d, by, scale_n, scale_d
  ];
  => 1;
)

private op doom_ui_face_tier [health] (
  if (health >= 80) ( => 0; )
  if (health >= 60) ( => 1; )
  if (health >= 40) ( => 2; )
  if (health >= 20) ( => 3; )
  => 4;
)

// The face is live state, never part of the immutable status cache. It idles
// among the three straight-ahead frames, reacts briefly to damage, descends
// through the five health tiers and has an explicit terminal frame.
op doom_ui_face_slot [combat] (
  if (combat\health == 0) ( => doom_texture_ui_face_dead_slot[]; )
  let tier = doom_ui_face_tier[combat\health];
  let since_pain = combat\tick - combat\player_pain_tick;
  if ((since_pain >= 0) and (since_pain < 18)) (
    => doom_texture_ui_face_ouch_slot[tier];
  )
  => doom_texture_ui_face_straight_slot[tier, (combat\tick / 30) % 3];
)

private op doom_ui_draw_status_layers [buf, w, h, bank, combat, world,
                                       draw_static] (
  if (bank\ui_ready == 1) () else ( => 0; )
  let scale_n = h;
  let scale_d = 200;
  let status_width = 320 * scale_n / scale_d;
  let bx = (w - status_width) / 2;
  let by = h - 32 * scale_n / scale_d;
  if (draw_static == 1) (
    doom_ui_draw_status_static[
      buf, w, h, bank, scale_n, scale_d, bx, by
    ];
  )

  doom_ui_draw_patch_scaled[
    buf, w, h, bank, doom_ui_face_slot[combat],
    bx + 143 * scale_n / scale_d, by + 2 * scale_n / scale_d,
    scale_n, scale_d
  ];

  if ((world\blue_key == 1) or (world\blue_skull == 1)) (
    let skull = world\blue_skull;
    doom_ui_draw_patch_scaled[
      buf, w, h, bank, doom_texture_ui_key_slot[0, skull],
      bx + 239 * scale_n / scale_d, by + 3 * scale_n / scale_d,
      scale_n, scale_d
    ];
  )
  if ((world\yellow_key == 1) or (world\yellow_skull == 1)) (
    let skull = world\yellow_skull;
    doom_ui_draw_patch_scaled[
      buf, w, h, bank, doom_texture_ui_key_slot[1, skull],
      bx + 239 * scale_n / scale_d, by + 13 * scale_n / scale_d,
      scale_n, scale_d
    ];
  )
  if ((world\red_key == 1) or (world\red_skull == 1)) (
    let skull = world\red_skull;
    doom_ui_draw_patch_scaled[
      buf, w, h, bank, doom_texture_ui_key_slot[2, skull],
      bx + 239 * scale_n / scale_d, by + 23 * scale_n / scale_d,
      scale_n, scale_d
    ];
  )

  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 44 * scale_n / scale_d,
    by + 3 * scale_n / scale_d,
    doom_combat_current_ammo[combat], 0, 0, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 90 * scale_n / scale_d,
    by + 3 * scale_n / scale_d, combat\health, 0, 0, scale_n, scale_d
  ];
  doom_ui_draw_patch_scaled[
    buf, w, h, bank, doom_texture_ui_percent_slot[],
    bx + 90 * scale_n / scale_d, by + 3 * scale_n / scale_d,
    scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 221 * scale_n / scale_d,
    by + 3 * scale_n / scale_d, combat\armor, 0, 0, scale_n, scale_d
  ];
  doom_ui_draw_patch_scaled[
    buf, w, h, bank, doom_texture_ui_percent_slot[],
    bx + 221 * scale_n / scale_d, by + 3 * scale_n / scale_d,
    scale_n, scale_d
  ];

  let weapon = 2;
  while (weapon <= 7) (
    let column = (weapon - 2) % 3;
    let row = (weapon - 2) / 3;
    let slot = doom_texture_ui_gray_number_slot[weapon];
    if (doom_combat_weapon_owned[combat, weapon] == 1) (
      slot = doom_texture_ui_yellow_number_slot[weapon];
    )
    doom_ui_draw_patch_scaled[
      buf, w, h, bank, slot,
      bx + (111 + column * 12) * scale_n / scale_d,
      by + (4 + row * 10) * scale_n / scale_d, scale_n, scale_d
    ];
    weapon = weapon + 1;
  )

  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 288 * scale_n / scale_d,
    by + 4 * scale_n / scale_d, combat\ammo, 1, 1, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 288 * scale_n / scale_d,
    by + 10 * scale_n / scale_d, combat\shells, 1, 1, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 288 * scale_n / scale_d,
    by + 16 * scale_n / scale_d, combat\rockets, 1, 1, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 288 * scale_n / scale_d,
    by + 22 * scale_n / scale_d, combat\cells, 1, 1, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 314 * scale_n / scale_d,
    by + 4 * scale_n / scale_d, combat\max_ammo, 1, 1, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 314 * scale_n / scale_d,
    by + 10 * scale_n / scale_d, combat\max_shells, 1, 1, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 314 * scale_n / scale_d,
    by + 16 * scale_n / scale_d, combat\max_rockets, 1, 1, scale_n, scale_d
  ];
  doom_ui_draw_number_right_scaled[
    buf, w, h, bank, bx + 314 * scale_n / scale_d,
    by + 22 * scale_n / scale_d, combat\max_cells, 1, 1, scale_n, scale_d
  ];

  => 1;
)

// Pickup text lives in the 3D viewport, which is repainted every frame. Keep
// it outside the persistent status-strip cache even when its value is stable.
private op doom_ui_draw_pickup_message [buf, w, h, bank, world] (
  if (world\pickup_tick > 0) (
    let message_x = (w - doom_ui_text_width[bank, world\pickup_message]) / 2;
    doom_ui_draw_text[
      buf, w, h, bank, message_x, 12, world\pickup_message
    ];
  )
  => 0;
)

// Cache only the immutable WAD status artwork. Live ammunition, health,
// armour and weapon ownership remain ordinary overlays, so this is a raster
// reuse policy rather than a second source of UI truth.
op doom_ui_status_cache_new [w, h, bank] (
  let status_h = 32 * h / 200;
  if ((bank\ui_ready == 1) and (w > 0) and (h > 0) and
      (w % 2 == 0) and (status_h > 0) and
      (320 * h / 200 == w)) () else (
    fall "doom_ui_status_cache_new: expected a measured 8:5 status raster";
  )
  let pixels = gui_buffer[w, status_h];
  doom_ui_draw_status_static[pixels, w, status_h, bank, h, 200, 0, 0];
  => {
    pixels: pixels, width: w, frame_height: h, height: status_h,
    valid: 0, face: 0 - 1, current_ammo: 0 - 1,
    health: 0 - 1, armor: 0 - 1, weapons: 0 - 1, keys: 0 - 1,
    ammo: 0 - 1, shells: 0 - 1, rockets: 0 - 1, cells: 0 - 1,
    max_ammo: 0 - 1, max_shells: 0 - 1,
    max_rockets: 0 - 1, max_cells: 0 - 1,
    redraws: 0
  };
)

op doom_ui_draw_status [buf, w, h, bank, combat, world] (
  doom_ui_draw_status_layers[buf, w, h, bank, combat, world, 1];
  doom_ui_draw_pickup_message[buf, w, h, bank, world];
  => 1;
)

op doom_ui_draw_status_cached [buf, w, h, bank, cache, combat, world] (
  let status_h = 32 * h / 200;
  let cached_pixels = cache\pixels;
  if ((cache\width == w) and (cache\frame_height == h) and
      (cache\height == status_h) and (w % 2 == 0) and
      (bytes_len[buf] == w * h * 4) and
      (bytes_len[cached_pixels] == w * status_h * 4)) () else (
    fall "doom_ui_draw_status_cached: cache dimensions disagree";
  )
  let face = doom_ui_face_slot[combat];
  let current_ammo = doom_combat_current_ammo[combat];
  let weapons = 0;
  let weapon = 1;
  while (weapon <= 7) (
    weapons = weapons * 2 + doom_combat_weapon_owned[combat, weapon];
    weapon = weapon + 1;
  )
  let keys = world\blue_key + world\blue_skull * 2 +
    world\yellow_key * 4 + world\yellow_skull * 8 +
    world\red_key * 16 + world\red_skull * 32;
  let unchanged =
    (cache\valid == 1) and (cache\face == face) and
    (cache\current_ammo == current_ammo) and
    (cache\health == combat\health) and (cache\armor == combat\armor) and
    (cache\weapons == weapons) and (cache\keys == keys) and
    (cache\ammo == combat\ammo) and (cache\shells == combat\shells) and
    (cache\rockets == combat\rockets) and (cache\cells == combat\cells) and
    (cache\max_ammo == combat\max_ammo) and
    (cache\max_shells == combat\max_shells) and
    (cache\max_rockets == combat\max_rockets) and
    (cache\max_cells == combat\max_cells);
  if (unchanged == 0) (
    view cached_words as %32le[] over cached_pixels;
    view frame_words as %32le[] over buf;
    let target = (h - status_h) * w;
    let i = 0;
    while (i < buf_len[cached_words]) (
      frame_words@(target + i) = cached_words@i;
      i = i + 1;
    )
    doom_ui_draw_status_layers[buf, w, h, bank, combat, world, 0];
    cache\valid = 1;
    cache\face = face;
    cache\current_ammo = current_ammo;
    cache\health = combat\health;
    cache\armor = combat\armor;
    cache\weapons = weapons;
    cache\keys = keys;
    cache\ammo = combat\ammo;
    cache\shells = combat\shells;
    cache\rockets = combat\rockets;
    cache\cells = combat\cells;
    cache\max_ammo = combat\max_ammo;
    cache\max_shells = combat\max_shells;
    cache\max_rockets = combat\max_rockets;
    cache\max_cells = combat\max_cells;
    cache\redraws = cache\redraws + 1;
  )
  doom_ui_draw_pickup_message[buf, w, h, bank, world];
  => 1;
)

private op doom_ui_draw_centered_patch_scaled [buf, w, h, bank, slot, y,
                                               numerator, denominator] (
  let drawn_width =
    doom_ui_patch_width[bank, slot] * numerator / denominator;
  let x = (w - drawn_width) / 2;
  => doom_ui_draw_patch_scaled[
    buf, w, h, bank, slot, x, y, numerator, denominator
  ];
)

private op doom_ui_draw_centered_text_scaled [buf, w, h, bank, y, text,
                                              numerator, denominator] (
  let x = (w - doom_ui_text_width_scaled[
    bank, text, numerator, denominator
  ]) / 2;
  => doom_ui_draw_text_scaled[
    buf, w, h, bank, x, y, text, numerator, denominator
  ];
)

op doom_ui_draw_menu [buf, w, h, bank, ui] (
  if ((ui\open == 1) and (bank\ui_ready == 1)) () else ( => 0; )
  let scale_n = h;
  let scale_d = 200;
  gui_rect[buf, w, h, 0, 0, w, h, gui_rgb[14, 10, 12]];
  doom_ui_draw_centered_patch_scaled[
    buf, w, h, bank, doom_texture_ui_logo_slot[],
    10 * scale_n / scale_d, scale_n, scale_d
  ];
  doom_ui_draw_centered_text_scaled[
    buf, w, h, bank, 66 * scale_n / scale_d, "SELECT MAP",
    scale_n, scale_d
  ];
  let first_y = 84 * scale_n / scale_d;
  let row = 0;
  let index = ui\top;
  while ((row < 7) and (index < arr_len[ui\maps])) (
    doom_ui_draw_centered_text_scaled[
      buf, w, h, bank, first_y + row * 13 * scale_n / scale_d,
      ui\maps\@index, scale_n, scale_d
    ];
    row = row + 1;
    index = index + 1;
  )
  let cursor = ui\cursor;
  let selected = ui\maps\@cursor;
  let selected_x = (w - doom_ui_text_width_scaled[
    bank, selected, scale_n, scale_d
  ]) / 2;
  let cy = first_y - 5 * scale_n / scale_d +
    (ui\cursor - ui\top) * 13 * scale_n / scale_d;
  doom_ui_draw_patch_scaled[
    buf, w, h, bank,
    doom_texture_ui_skull1_slot[] + ((ui\cursor + ui\look_speed) % 2),
    selected_x - 24 * scale_n / scale_d, cy, scale_n, scale_d
  ];
  doom_ui_draw_centered_text_scaled[
    buf, w, h, bank, 181 * scale_n / scale_d,
    "MAP ^{ui\cursor + 1}/^{arr_len[ui\maps]}", scale_n, scale_d
  ];
  => 1;
)
