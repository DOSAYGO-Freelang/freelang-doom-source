// Bounded deterministic combat state for the classic-map application.
// Map geometry and WAD assets stay immutable; each admitted enemy owns one
// explicit phase-bearing record under one published application bound.

credits: <../games/doom-map.flx> <../games/doom-texture.flx>
         <../games/doom-stock.flx>
         <f/arrays> <f/bytes> <f/trig>;

states DoomEnemyPhase {
  Dormant
  Chase
  Attack
  Pain
  Death
}

// The registered Doom 1.9 E1--E3 maximum is 177 admitted actors (E1M6).
// Keep deliberate headroom while retaining a loud finite simulation table.
op doom_combat_enemy_limit [] ( => 256; )

op doom_combat_actor_phase_name [actor] (
  => actor\phase with states DoomEnemyPhase {
    Dormant => "dormant"
    Chase => "chase"
    Attack => "attack"
    Pain => "pain"
    Death => "death"
  };
)

op doom_combat_actor_targetable [actor] (
  => actor\phase with states DoomEnemyPhase {
    Dormant => 1
    Chase => 1
    Attack => 1
    Pain => 1
    Death => 0
  };
)

// Ordinary dead actors retain a corpse sprite. Vanilla Lost Souls instead
// leave the world after their six-frame terminal animation reaches S_NULL.
op doom_combat_actor_renderable [actor] (
  if ((actor\family == 5) and
      (actor\phase == DoomEnemyPhase\Death) and
      (actor\phase_tick >= 36)) (
    => 0;
  )
  => 1;
)

private op doom_combat_attack_sprite_slot [actor, rotation] (
  let frame = 4 + (actor\phase_tick / 5) % 2;
  if ((actor\family == 2) or (actor\family == 3) or
      (actor\family == 6)) (
    frame = 4 + (actor\phase_tick / 5) % 3;
  )
  if (actor\family == 4) ( frame = 1 + (actor\phase_tick / 5) % 3; )
  if (actor\family == 5) ( frame = 2 + (actor\phase_tick / 5) % 2; )
  if (actor\family == 7) ( frame = 4 + (actor\phase_tick / 5) % 2; )
  if (actor\family == 8) ( frame = 6; )
  => doom_texture_sprite_directional_slot[actor\family, frame, rotation];
)

private op doom_combat_pain_sprite_slot [actor, rotation] (
  let frame = 6;
  if ((actor\family == 2) or (actor\family == 3) or
      (actor\family == 6)) ( frame = 7; )
  if (actor\family == 4) ( frame = 4 + (actor\phase_tick / 4) % 2; )
  if (actor\family == 5) ( frame = 4; )
  if (actor\family == 7) ( frame = 6; )
  if (actor\family == 8) ( frame = 7; )
  => doom_texture_sprite_directional_slot[actor\family, frame, rotation];
)

private op doom_combat_walk_sprite_slot [actor, rotation, dormant] (
  let frame = (actor\phase_tick / 6) % 4;
  if (dormant == 1) ( frame = (actor\phase_tick / 30) % 2; )
  if (actor\family == 4) ( frame = 0; )
  if (actor\family == 5) (
    frame = (actor\phase_tick / 6) % 2;
    if (dormant == 1) ( frame = (actor\phase_tick / 30) % 2; )
  )
  if ((actor\family == 8) and (dormant == 0)) (
    frame = (actor\phase_tick / 6) % 6;
  )
  => doom_texture_sprite_directional_slot[actor\family, frame, rotation];
)

private op doom_combat_death_sprite_slot [actor] (
  let frame_ticks = 5;
  let terminal_frame = 4;
  if (actor\family == 5) (
    frame_ticks = 6;
    terminal_frame = 5;
  )
  let frame = actor\phase_tick / frame_ticks;
  if (frame > terminal_frame) ( frame = terminal_frame; )
  => doom_texture_sprite_death_slot[actor\family, frame];
)

op doom_combat_actor_sprite_slot [actor, rotation] (
  => actor\phase with states DoomEnemyPhase {
    Dormant => doom_combat_walk_sprite_slot[actor, rotation, 1]
    Chase => doom_combat_walk_sprite_slot[actor, rotation, 0]
    Attack => doom_combat_attack_sprite_slot[actor, rotation]
    Pain => doom_combat_pain_sprite_slot[actor, rotation]
    Death => doom_combat_death_sprite_slot[actor]
  };
)

op doom_combat_weapon_frame [combat] (
  let cooldown = combat\shot_cooldown;
  if ((combat\selected_weapon == 1) and (cooldown > 0)) (
    => 1 + cooldown % 3;
  )
  if (combat\selected_weapon == 2) (
    // Vanilla holds PISGA for four tics before A_FirePistol advances the
    // body to PISGB and creates PISFA. The bounded ten-tic cycle retains
    // that ordering and uses the remaining six tics for the firing frame.
    if (cooldown >= 7) ( => 0; )
    if (cooldown > 0) ( => 1; )
  )
  if (combat\selected_weapon == 3) (
    // S_SGUN1 and S_SGUN2 both use SHTGA: the three-tic wind-up is dark,
    // then the two flash states finish before SHTGB/C/D begin the pump.
    if (cooldown >= 15) ( => 0; )
    if (cooldown >= 10) ( => 1; )
    if (cooldown >= 5) ( => 2; )
    if (cooldown > 0) ( => 3; )
  )
  if ((combat\selected_weapon == 4) and (cooldown > 0)) (
    => (combat\shots + 1) % 2;
  )
  if ((combat\selected_weapon == 5) and (cooldown > 0)) (
    => 1;
  )
  if ((combat\selected_weapon == 6) and (cooldown > 0)) (
    // S_PLASMA1 stays on PLSGA for its three firing tics; PLSGB is the
    // refire state. Flash choice is independent of the body frame.
    if (cooldown >= 2) ( => 0; )
    => 1;
  )
  if (combat\selected_weapon == 7) (
    // Keep vanilla's full twenty-tic BFGGA charge before the gun flash.
    if (cooldown >= 11) ( => 0; )
    if (cooldown > 0) ( => 1; )
  )
  => 0;
)

op doom_combat_weapon_slot [combat] (
  => doom_texture_weapon_slot_for[
    combat\selected_weapon, doom_combat_weapon_frame[combat]
  ];
)

// Doom draws the weapon body and muzzle fire as separate psprites. A negative
// slot is explicit absence; callers never infer a flash from weapon movement.
op doom_combat_muzzle_slot [combat] (
  let cooldown = combat\shot_cooldown;
  let weapon = combat\selected_weapon;
  if ((weapon == 2) and (cooldown <= 6) and (cooldown > 0)) (
    => doom_texture_muzzle_slot_for[2, 0];
  )
  if ((weapon == 3) and (cooldown <= 21) and (cooldown >= 15)) (
    let frame = 0;
    if (cooldown <= 17) ( frame = 1; )
    => doom_texture_muzzle_slot_for[3, frame];
  )
  if ((weapon == 4) and (cooldown > 0)) (
    => doom_texture_muzzle_slot_for[4, (combat\shots + 1) % 2];
  )
  if ((weapon == 5) and (cooldown >= 16)) (
    // MISFA-D retain their original 3/4/4/4-tic durations.
    let elapsed = 30 - cooldown;
    let frame = 0;
    if (elapsed >= 3) ( frame = 1; )
    if (elapsed >= 7) ( frame = 2; )
    if (elapsed >= 11) ( frame = 3; )
    => doom_texture_muzzle_slot_for[5, frame];
  )
  if ((weapon == 6) and (cooldown > 0)) (
    => doom_texture_muzzle_slot_for[6, (combat\shots + 1) % 2];
  )
  if ((weapon == 7) and (cooldown <= 10) and (cooldown > 0)) (
    // The bounded cycle preserves the twenty-tic charge exactly, then
    // compresses the 11/6 flash pair into the ten remaining tics.
    let frame = 0;
    if (cooldown <= 3) ( frame = 1; )
    => doom_texture_muzzle_slot_for[7, frame];
  )
  => 0 - 1;
)

op doom_combat_weapon_owned [combat, weapon] (
  if ((weapon < 0) or (weapon >= bytes_len[combat\weapons])) ( => 0; )
  => bytes_get[combat\weapons, weapon];
)

op doom_combat_current_ammo [combat] (
  if (combat\selected_weapon == 1) ( => 1; )
  if ((combat\selected_weapon == 2) or (combat\selected_weapon == 4)) (
    => combat\ammo;
  )
  if (combat\selected_weapon == 3) ( => combat\shells; )
  if (combat\selected_weapon == 5) ( => combat\rockets; )
  if ((combat\selected_weapon == 6) or (combat\selected_weapon == 7)) (
    => combat\cells;
  )
  => 0;
)

op doom_combat_can_fire [combat] (
  if (combat\selected_weapon == 7) ( => combat\cells >= 40; )
  => doom_combat_current_ammo[combat] > 0;
)

op doom_combat_select_weapon [combat, weapon] (
  if ((weapon >= 1) and (weapon <= 7) and
      (doom_combat_weapon_owned[combat, weapon] == 1)) (
    if (combat\selected_weapon != weapon) (
      combat\selected_weapon = weapon;
      combat\shot_cooldown = 0;
      combat\weapon_switches = combat\weapon_switches + 1;
    )
  )
  => combat;
)

op doom_combat_cycle_weapon [combat, direction] (
  if ((direction == 1) or (direction == 0 - 1)) () else ( => combat; )
  let candidate = combat\selected_weapon;
  let attempts = 0;
  while (attempts < 7) (
    candidate = candidate + direction;
    if (candidate > 7) ( candidate = 1; )
    if (candidate < 1) ( candidate = 7; )
    if (doom_combat_weapon_owned[combat, candidate] == 1) (
      => doom_combat_select_weapon[combat, candidate];
    )
    attempts = attempts + 1;
  )
  => combat;
)

private op doom_combat_abs [value] (
  if (value < 0) ( => 0 - value; )
  => value;
)

private op doom_combat_distance [actor, player_x, player_y] (
  let dx = doom_combat_abs[player_x - actor\x];
  let dy = doom_combat_abs[player_y - actor\y];
  if (dx > dy) ( => dx; )
  => dy;
)

private op doom_combat_heading [dx, dy] (
  let ax = doom_combat_abs[dx];
  let ay = doom_combat_abs[dy];
  if (ay * 2 < ax) (
    if (dx >= 0) ( => 0; )
    => 180;
  )
  if (ax * 2 < ay) (
    if (dy >= 0) ( => 90; )
    => 270;
  )
  if ((dx >= 0) and (dy >= 0)) ( => 45; )
  if ((dx < 0) and (dy >= 0)) ( => 135; )
  if ((dx < 0) and (dy < 0)) ( => 225; )
  => 315;
)

private op doom_combat_actor_max_health [kind] (
  => doom_stock_actor_max_health[kind];
)

private op doom_combat_actor_attack_range [kind] (
  => doom_stock_actor_attack_range[kind];
)

// The original uses a byte RNG. This application keeps replay authority by
// deriving the same bounded damage bands from explicit combat state instead
// of introducing hidden global randomness.
private op doom_combat_human_bullet_damage [combat, actor] (
  => 3 * (1 + (combat\tick + actor\thing) % 5);
)

private op doom_combat_attack_chance [distance] (
  let chance = 220 - distance / 2;
  if (chance < 48) ( chance = 48; )
  if (chance > 220) ( chance = 220; )
  => chance;
)

private op doom_combat_human_bullet_hits [combat, actor, distance] (
  let roll = (combat\tick * 11 + actor\thing * 7) % 256;
  => roll < doom_combat_attack_chance[distance];
)

private op doom_combat_shotgun_damage [combat, actor, distance] (
  let seed = combat\tick + actor\thing;
  let chance = doom_combat_attack_chance[distance];
  let damage = 0;
  let pellet = 0;
  while (pellet < 3) (
    let roll = (seed * (11 + pellet * 6) + pellet * 43) % 256;
    if (roll < chance) (
      damage = damage + 3 * (1 + (seed * (3 + pellet * 4) + pellet) % 5);
    )
    pellet = pellet + 1;
  )
  => damage;
)

private op doom_combat_imp_melee_damage [combat, actor] (
  => 3 * (1 + (combat\tick + actor\thing) % 8);
)

private op doom_combat_demon_melee_damage [combat, actor] (
  => 4 * (1 + (combat\tick + actor\thing) % 10);
)

private op doom_combat_lost_soul_damage [combat, actor] (
  => 3 * (1 + (combat\tick + actor\thing) % 8);
)

private op doom_combat_monster_ball_damage [combat, actor] (
  let factor = 5;
  if (actor\kind == 3003) ( factor = 8; )
  if (actor\kind == 16) ( factor = 20; )
  => factor * (1 + (combat\tick + actor\thing) % 8);
)

private op doom_combat_line_of_sight [map, actor,
                                      player_x, player_y, player_z] (
  => 1 - doom_map_sight_blocked_at[
    map,
    actor\x, actor\y, doom_combat_floor_at[map, actor\x, actor\y] + 28,
    player_x, player_y, player_z + 41
  ];
)

// Movement owns a 16-unit cross-section rather than only an actor centre.
// Sweeping the four cardinal support points keeps a billboard's physical
// anchor away from solid/closed geometry without inventing mutable sectors.
op doom_combat_actor_move_blocked [map, from_x, from_y, to_x, to_y] (
  if (doom_map_move_blocked[
        map, from_x, from_y, to_x, to_y, 56, 24
      ] == 1) ( => 1; )
  let radius = 16;
  if (doom_map_move_blocked[
        map, from_x + radius, from_y, to_x + radius, to_y, 56, 24
      ] == 1) ( => 1; )
  if (doom_map_move_blocked[
        map, from_x - radius, from_y, to_x - radius, to_y, 56, 24
      ] == 1) ( => 1; )
  if (doom_map_move_blocked[
        map, from_x, from_y + radius, to_x, to_y + radius, 56, 24
      ] == 1) ( => 1; )
  if (doom_map_move_blocked[
        map, from_x, from_y - radius, to_x, to_y - radius, 56, 24
      ] == 1) ( => 1; )
  => 0;
)

// Touching vertical spans do not overlap. Keeping this rule explicit prevents
// an actor on a lower floor from becoming an invisible wall at a ledge.
op doom_combat_vertical_overlap [first_z, first_height,
                                 second_z, second_height] (
  if ((first_z < second_z + second_height) and
      (second_z < first_z + first_height)) ( => 1; )
  => 0;
)

private op doom_combat_floor_at [map, x, y] (
  let sector = doom_map_point_sector[map, x, y];
  => buf_get[map\sectors, sector * 5];
)

// A live actor cannot overlap the player, another targetable actor or a live
// barrel when their horizontal and vertical spans both overlap. Corpses exit
// the blocker set on the lethal shot while their final sprite remains visible.
op doom_combat_actor_position_blocked [map, combat, actor, to_x, to_y,
                                       player_x, player_y, player_z] (
  let actor_z = doom_combat_floor_at[map, to_x, to_y];
  if ((doom_combat_abs[to_x - player_x] < 32) and
      (doom_combat_abs[to_y - player_y] < 32) and
      (doom_combat_vertical_overlap[actor_z, 56, player_z, 56] == 1)) (
    => 1;
  )
  let i = 0;
  while (i < combat\enemy_count) (
    let other = combat\actors\\i;
    if ((other\thing != actor\thing) and
        (doom_combat_actor_targetable[other] == 1) and
        (doom_combat_abs[to_x - other\x] < 32) and
        (doom_combat_abs[to_y - other\y] < 32) and
        (doom_combat_vertical_overlap[
           actor_z, 56,
           doom_combat_floor_at[map, other\x, other\y], 56
         ] == 1)) ( => 1; )
    i = i + 1;
  )
  i = 0;
  while (i < arr_len[combat\barrels]) (
    let barrel = combat\barrels\\i;
    if ((barrel\state == 1) and
        (doom_combat_abs[to_x - barrel\x] < 32) and
        (doom_combat_abs[to_y - barrel\y] < 32) and
        (doom_combat_vertical_overlap[
           actor_z, 56,
           doom_combat_floor_at[map, barrel\x, barrel\y], 42
         ] == 1)) ( => 1; )
    i = i + 1;
  )
  => 0;
)

private op doom_combat_actor_candidate_blocked [
  map, combat, actor, from_x, from_y, to_x, to_y,
  player_x, player_y, player_z
] (
  if (doom_combat_actor_move_blocked[
        map, from_x, from_y, to_x, to_y
      ] == 1) ( => 1; )
  => doom_combat_actor_position_blocked[
    map, combat, actor, to_x, to_y, player_x, player_y, player_z
  ];
)

private op doom_combat_move_actor [map, combat, actor,
                                   player_x, player_y, player_z] (
  let sx = 0;
  let sy = 0;
  if (player_x > actor\x) ( sx = 2; )
  if (player_x < actor\x) ( sx = 0 - 2; )
  if (player_y > actor\y) ( sy = 2; )
  if (player_y < actor\y) ( sy = 0 - 2; )
  let next_x = actor\x + sx;
  let next_y = actor\y + sy;
  if (doom_combat_actor_candidate_blocked[
        map, combat, actor, actor\x, actor\y, next_x, next_y,
        player_x, player_y, player_z
      ] == 0) (
    actor\x = next_x;
    actor\y = next_y;
    => 1;
  )
  if ((sx != 0) and
      (doom_combat_actor_candidate_blocked[
         map, combat, actor, actor\x, actor\y, actor\x + sx, actor\y,
         player_x, player_y, player_z
       ] == 0)) (
    actor\x = actor\x + sx;
    => 1;
  )
  if ((sy != 0) and
      (doom_combat_actor_candidate_blocked[
         map, combat, actor, actor\x, actor\y, actor\x, actor\y + sy,
         player_x, player_y, player_z
       ] == 0)) (
    actor\y = actor\y + sy;
    => 1;
  )
  => 0;
)

op doom_combat_validate [map, combat] (
  if ((arr_len[combat\actors] == combat\enemy_count) and
      (combat\enemy_count >= 0) and
      (combat\enemy_count <= doom_combat_enemy_limit[]) and
      (bytes_len[combat\alive] == map\thing_count) and
      (combat\health >= 0) and (combat\health <= combat\health_cap) and
      (combat\max_health == 100) and
      (combat\health_cap == 200) and
      (combat\ammo >= 0) and (combat\ammo <= combat\max_ammo) and
      (combat\max_ammo == 200 + combat\backpack * 200) and
      (combat\shells >= 0) and (combat\shells <= combat\max_shells) and
      (combat\max_shells == 50 + combat\backpack * 50) and
      (combat\rockets >= 0) and (combat\rockets <= combat\max_rockets) and
      (combat\max_rockets == 50 + combat\backpack * 50) and
      (combat\cells >= 0) and (combat\cells <= combat\max_cells) and
      (combat\max_cells == 300 + combat\backpack * 300) and
      ((combat\backpack == 0) or (combat\backpack == 1)) and
      ((combat\berserk == 0) or (combat\berserk == 1)) and
      (combat\invulnerability_tick >= 0) and
      (combat\invulnerability_tick <= 1800) and
      (combat\invisibility_tick >= 0) and
      (combat\invisibility_tick <= 3600) and
      (combat\radiation_tick >= 0) and
      (combat\radiation_tick <= 3600) and
      (combat\light_tick >= 0) and (combat\light_tick <= 7200) and
      (bytes_len[combat\weapons] == 8) and
      (combat\selected_weapon >= 1) and (combat\selected_weapon <= 7) and
      (bytes_get[combat\weapons, combat\selected_weapon] == 1) and
      (combat\armor >= 0) and (combat\armor <= combat\max_armor) and
      (combat\max_armor == 200) and
      (combat\shot_cooldown >= 0) and (combat\shot_cooldown <= 30) and
      (arr_len[combat\projectiles] <= 32) and
      (arr_len[combat\drops] <= combat\enemy_count) and
      (combat\kills >= 0) and (combat\kills <= combat\enemy_count)) () else (
    fall "doom_combat_validate: player or table invariant violated";
  )
  let deaths = 0;
  let i = 0;
  while (i < combat\enemy_count) (
    let actor = combat\actors\\i;
    let phase_tick_limit = 30;
    if ((actor\family == 5) and (actor\phase == DoomEnemyPhase\Death)) (
      phase_tick_limit = 36;
    )
    if ((actor\thing >= 0) and (actor\thing < map\thing_count) and
        (actor\family >= 0) and (actor\family < 9) and
        (actor\health >= 0) and (actor\health <= actor\max_health) and
        (actor\max_health == doom_combat_actor_max_health[actor\kind]) and
        (actor\phase_tick >= 0) and
        (actor\phase_tick <= phase_tick_limit) and
        (actor\attack_cooldown >= 0) and (actor\attack_cooldown <= 60)) () else (
      fall "doom_combat_validate: enemy invariant violated";
    )
    let phase_valid = actor\phase with states DoomEnemyPhase {
      Dormant => actor\health > 0
      Chase => actor\health > 0
      Attack => actor\health > 0
      Pain => actor\health > 0
      Death => actor\health == 0
    };
    if (phase_valid == 1) () else (
      fall "doom_combat_validate: health and phase disagree";
    )
    if (actor\health == 0) (
      deaths = deaths + 1;
      if (bytes_get[combat\alive, actor\thing] == 0) () else (
        fall "doom_combat_validate: dead actor remains targetable";
      )
    ) else if (bytes_get[combat\alive, actor\thing] == 1) () else (
      fall "doom_combat_validate: live actor is absent from target table";
    )
    i = i + 1;
  )
  if (deaths == combat\kills) () else (
    fall "doom_combat_validate: kill count disagrees with death phases";
  )
  i = 0;
  while (i < arr_len[combat\projectiles]) (
    let projectile = combat\projectiles\\i;
    if ((projectile\kind >= 1) and (projectile\kind <= 7) and
        (projectile\state >= 0) and (projectile\state <= 2) and
        (projectile\angle >= 0) and (projectile\angle < 360) and
        (projectile\damage >= 0) and (projectile\damage <= 200) and
        (projectile\age >= 0) and (projectile\age <= 180)) () else (
      fall "doom_combat_validate: projectile invariant violated";
    )
    i = i + 1;
  )
  i = 0;
  while (i < arr_len[combat\drops]) (
    let drop = combat\drops\\i;
    if (((drop\kind == 2007) or (drop\kind == 2001)) and
        ((drop\alive == 0) or (drop\alive == 1))) () else (
      fall "doom_combat_validate: dropped item invariant violated";
    )
    i = i + 1;
  )
  if (arr_len[combat\barrels] <= 64) () else (
    fall "doom_combat_validate: barrel count exceeds 64";
  )
  i = 0;
  while (i < arr_len[combat\barrels]) (
    let barrel = combat\barrels\\i;
    if ((barrel\thing >= 0) and (barrel\thing < map\thing_count) and
        (barrel\health >= 0) and (barrel\health <= 20) and
        (barrel\state >= 0) and (barrel\state <= 2) and
        (barrel\phase_tick >= 0) and (barrel\phase_tick <= 45) and
        (((barrel\state == 1) and (barrel\health > 0)) or
         ((barrel\state != 1) and (barrel\health == 0)))) () else (
      fall "doom_combat_validate: barrel invariant violated";
    )
    i = i + 1;
  )
  => 1;
)

op doom_combat_new [map] (
  let actors = [];
  let barrels = [];
  let alive = bytes_new[map\thing_count];
  let enemy_count = 0;
  let unsupported_enemies = 0;
  let i = 0;
  while (i < map\thing_count) (
    let tb = i * 4;
    let kind = buf_get[map\things, tb + 2];
    let family = doom_texture_sprite_family[kind];
    if ((doom_map_thing_is_enemy[kind] == 1) and (family < 0)) (
      unsupported_enemies = unsupported_enemies + 1;
    )
    if ((doom_map_thing_is_enemy[kind] == 1) and (family >= 0)) (
      if (enemy_count < doom_combat_enemy_limit[]) (
        let max_health = doom_combat_actor_max_health[kind];
        actors = actors + [{
          thing: i, kind: kind, family: family,
          x: buf_get[map\things, tb], y: buf_get[map\things, tb + 1],
          angle: buf_get[map\thing_angles, i],
          health: max_health, max_health: max_health,
          phase: DoomEnemyPhase\Dormant, phase_tick: 0,
          attack_cooldown: 0
        }];
        bytes_set[alive, i, 1];
        enemy_count = enemy_count + 1;
      ) else (
        unsupported_enemies = unsupported_enemies + 1;
      )
    )
    if (kind == 2035) (
      if (arr_len[barrels] < 64) () else (
        fall "doom_combat_new: barrel count exceeds 64";
      )
      barrels = barrels + [{
        thing: i, x: buf_get[map\things, tb], y: buf_get[map\things, tb + 1],
        health: 20, state: 1, phase_tick: 0
      }];
    )
    i = i + 1;
  )
  let combat = {
    actors: actors, alive: alive, enemy_count: enemy_count,
    unsupported_enemies: unsupported_enemies, barrels: barrels,
    health: 100, max_health: 100, health_cap: 200,
    ammo: 50, max_ammo: 200,
    shells: 0, max_shells: 50, rockets: 0, max_rockets: 50,
    cells: 0, max_cells: 300,
    backpack: 0, berserk: 0,
    invulnerability_tick: 0, invisibility_tick: 0,
    radiation_tick: 0, light_tick: 0,
    weapons: bytes_new[8], selected_weapon: 2, weapon_switches: 0,
    armor: 0, max_armor: 200,
    shot_cooldown: 0, shots: 0, dry_fires: 0,
    projectiles: [], projectile_impacts: 0,
    monster_projectile_impacts: 0,
    explosion_serial: 0,
    monster_alert_serial: 0, monster_alert_kind: 0,
    monster_attack_serial: 0, monster_attack_kind: 0,
    monster_pain_serial: 0, monster_pain_kind: 0,
    monster_death_serial: 0, monster_death_kind: 0,
    player_pain_serial: 0, player_pain_tick: 0 - 1000,
    drops: [], drops_spawned: 0, drops_picked: 0,
    kills: 0, misses: 0, damage_taken: 0, armor_absorbed: 0, tick: 0
  };
  bytes_set[combat\weapons, 2, 1];
  doom_combat_validate[map, combat];
  => combat;
)

// Carry only durable player inventory into a freshly constructed map combat
// state. Map actors, drops, projectiles, counters, cooldowns and timed powers
// remain owned by `fresh`; keys remain world state and are therefore absent
// here. A new weapon owner prevents one map session from mutating another.
op doom_combat_carry_inventory [fresh_map, fresh, prior_map, prior] (
  doom_combat_validate[fresh_map, fresh];
  doom_combat_validate[prior_map, prior];

  let weapons = bytes_new[8];
  let weapon = 0;
  while (weapon < bytes_len[weapons]) (
    bytes_set[weapons, weapon, bytes_get[prior\weapons, weapon]];
    weapon = weapon + 1;
  )

  fresh\health = prior\health;
  fresh\armor = prior\armor;
  fresh\backpack = prior\backpack;
  fresh\max_ammo = 200 + fresh\backpack * 200;
  fresh\max_shells = 50 + fresh\backpack * 50;
  fresh\max_rockets = 50 + fresh\backpack * 50;
  fresh\max_cells = 300 + fresh\backpack * 300;
  fresh\ammo = prior\ammo;
  fresh\shells = prior\shells;
  fresh\rockets = prior\rockets;
  fresh\cells = prior\cells;
  fresh\weapons = weapons;
  fresh\selected_weapon = prior\selected_weapon;

  doom_combat_validate[fresh_map, fresh];
  => fresh;
)

// Player inventory is combat authority. World collection decides whether a
// thing is reachable and retires it; this operation alone changes weapons,
// ammunition, health, armor and timed powers.
op doom_combat_take_pickup [combat, kind] (
  if (kind == 2005) (
    let fresh = 1 - doom_combat_weapon_owned[combat, 1];
    if (fresh == 0) ( => 0; )
    bytes_set[combat\weapons, 1, 1];
    doom_combat_select_weapon[combat, 1];
  ) else if (kind == 2001) (
    let fresh = 1 - doom_combat_weapon_owned[combat, 3];
    if ((fresh == 0) and (combat\shells >= combat\max_shells)) ( => 0; )
    bytes_set[combat\weapons, 3, 1];
    combat\shells = combat\shells + 8;
    if (fresh == 1) ( doom_combat_select_weapon[combat, 3]; )
  ) else if (kind == 2002) (
    let fresh = 1 - doom_combat_weapon_owned[combat, 4];
    if ((fresh == 0) and (combat\ammo >= combat\max_ammo)) ( => 0; )
    bytes_set[combat\weapons, 4, 1];
    combat\ammo = combat\ammo + 20;
    if (fresh == 1) ( doom_combat_select_weapon[combat, 4]; )
  ) else if (kind == 2003) (
    let fresh = 1 - doom_combat_weapon_owned[combat, 5];
    if ((fresh == 0) and (combat\rockets >= combat\max_rockets)) ( => 0; )
    bytes_set[combat\weapons, 5, 1];
    combat\rockets = combat\rockets + 2;
    if (fresh == 1) ( doom_combat_select_weapon[combat, 5]; )
  ) else if (kind == 2004) (
    let fresh = 1 - doom_combat_weapon_owned[combat, 6];
    if ((fresh == 0) and (combat\cells >= combat\max_cells)) ( => 0; )
    bytes_set[combat\weapons, 6, 1];
    combat\cells = combat\cells + 40;
    if (fresh == 1) ( doom_combat_select_weapon[combat, 6]; )
  ) else if (kind == 2006) (
    let fresh = 1 - doom_combat_weapon_owned[combat, 7];
    if ((fresh == 0) and (combat\cells >= combat\max_cells)) ( => 0; )
    bytes_set[combat\weapons, 7, 1];
    combat\cells = combat\cells + 40;
    if (fresh == 1) ( doom_combat_select_weapon[combat, 7]; )
  ) else if (kind == 2007) (
    if (combat\ammo >= combat\max_ammo) ( => 0; )
    combat\ammo = combat\ammo + 10;
  ) else if (kind == 2048) (
    if (combat\ammo >= combat\max_ammo) ( => 0; )
    combat\ammo = combat\ammo + 50;
  ) else if (kind == 2008) (
    if (combat\shells >= combat\max_shells) ( => 0; )
    combat\shells = combat\shells + 4;
  ) else if (kind == 2049) (
    if (combat\shells >= combat\max_shells) ( => 0; )
    combat\shells = combat\shells + 20;
  ) else if (kind == 2046) (
    if (combat\rockets >= combat\max_rockets) ( => 0; )
    combat\rockets = combat\rockets + 5;
  ) else if (kind == 2010) (
    if (combat\rockets >= combat\max_rockets) ( => 0; )
    combat\rockets = combat\rockets + 1;
  ) else if (kind == 2047) (
    if (combat\cells >= combat\max_cells) ( => 0; )
    combat\cells = combat\cells + 20;
  ) else if (kind == 17) (
    if (combat\cells >= combat\max_cells) ( => 0; )
    combat\cells = combat\cells + 100;
  ) else if (kind == 8) (
    let fresh = 1 - combat\backpack;
    if ((fresh == 0) and
        (combat\ammo >= combat\max_ammo) and
        (combat\shells >= combat\max_shells) and
        (combat\rockets >= combat\max_rockets) and
        (combat\cells >= combat\max_cells)) ( => 0; )
    if (fresh == 1) (
      combat\backpack = 1;
      combat\max_ammo = 400;
      combat\max_shells = 100;
      combat\max_rockets = 100;
      combat\max_cells = 600;
    )
    combat\ammo = combat\ammo + 10;
    combat\shells = combat\shells + 4;
    combat\rockets = combat\rockets + 1;
    combat\cells = combat\cells + 20;
  ) else if (kind == 2011) (
    if (combat\health >= combat\max_health) ( => 0; )
    combat\health = combat\health + 10;
    if (combat\health > combat\max_health) (
      combat\health = combat\max_health;
    )
  ) else if (kind == 2012) (
    if (combat\health >= combat\max_health) ( => 0; )
    combat\health = combat\health + 25;
    if (combat\health > combat\max_health) (
      combat\health = combat\max_health;
    )
  ) else if (kind == 2013) (
    if (combat\health >= combat\health_cap) ( => 0; )
    combat\health = combat\health + 100;
    if (combat\health > combat\health_cap) (
      combat\health = combat\health_cap;
    )
  ) else if (kind == 2014) (
    if (combat\health >= combat\health_cap) ( => 0; )
    combat\health = combat\health + 1;
  ) else if (kind == 2015) (
    if (combat\armor >= combat\max_armor) ( => 0; )
    combat\armor = combat\armor + 1;
  ) else if (kind == 2018) (
    if (combat\armor >= 100) ( => 0; )
    combat\armor = 100;
  ) else if (kind == 2019) (
    if (combat\armor >= 200) ( => 0; )
    combat\armor = 200;
  ) else if (kind == 2022) (
    combat\invulnerability_tick = 1800;
  ) else if (kind == 2023) (
    if ((combat\berserk == 1) and (combat\health >= 100)) ( => 0; )
    combat\berserk = 1;
    if (combat\health < 100) ( combat\health = 100; )
    bytes_set[combat\weapons, 1, 1];
    doom_combat_select_weapon[combat, 1];
  ) else if (kind == 2024) (
    combat\invisibility_tick = 3600;
  ) else if (kind == 2025) (
    combat\radiation_tick = 3600;
  ) else if (kind == 2045) (
    combat\light_tick = 7200;
  ) else ( => 0; )
  if (combat\ammo > combat\max_ammo) ( combat\ammo = combat\max_ammo; )
  if (combat\shells > combat\max_shells) (
    combat\shells = combat\max_shells;
  )
  if (combat\rockets > combat\max_rockets) (
    combat\rockets = combat\max_rockets;
  )
  if (combat\cells > combat\max_cells) ( combat\cells = combat\max_cells; )
  => 1;
)

op doom_combat_take_drop [combat, kind] (
  if (kind == 2007) (
    if (combat\ammo >= combat\max_ammo) ( => 0; )
    combat\ammo = combat\ammo + 5;
    if (combat\ammo > combat\max_ammo) ( combat\ammo = combat\max_ammo; )
    => 1;
  )
  if (kind == 2001) (
    let fresh = 1 - doom_combat_weapon_owned[combat, 3];
    if ((fresh == 0) and (combat\shells >= combat\max_shells)) ( => 0; )
    bytes_set[combat\weapons, 3, 1];
    combat\shells = combat\shells + 4;
    if (combat\shells > combat\max_shells) (
      combat\shells = combat\max_shells;
    )
    if (fresh == 1) ( doom_combat_select_weapon[combat, 3]; )
    => 1;
  )
  => 0;
)

private op doom_combat_spawn_drop [combat, actor] (
  let kind = 0 - 1;
  if (actor\kind == 3004) ( kind = 2007; )
  if (actor\kind == 9) ( kind = 2001; )
  if (kind >= 0) (
    combat\drops = combat\drops + [{
      x: actor\x, y: actor\y, kind: kind, alive: 1
    }];
    combat\drops_spawned = combat\drops_spawned + 1;
  )
  => kind;
)

private op doom_combat_hurt_actor [combat, actor, damage] (
  if ((damage <= 0) or (doom_combat_actor_targetable[actor] == 0)) ( => 0; )
  if (damage > actor\health) ( damage = actor\health; )
  actor\health = actor\health - damage;
  actor\phase_tick = 0;
  if (actor\health == 0) (
    actor\phase = DoomEnemyPhase\Death;
    actor\attack_cooldown = 0;
    bytes_set[combat\alive, actor\thing, 0];
    combat\kills = combat\kills + 1;
    combat\monster_death_kind = actor\kind;
    combat\monster_death_serial = combat\monster_death_serial + 1;
    doom_combat_spawn_drop[combat, actor];
  ) else (
    actor\phase = DoomEnemyPhase\Pain;
    combat\monster_pain_kind = actor\kind;
    combat\monster_pain_serial = combat\monster_pain_serial + 1;
  )
  => damage;
)

private op doom_combat_hurt_barrel [barrel, damage] (
  if ((damage <= 0) or (barrel\state != 1)) ( => 0; )
  if (damage > barrel\health) ( damage = barrel\health; )
  barrel\health = barrel\health - damage;
  if (barrel\health == 0) (
    // phase_tick zero is an explicit pending explosion. The bounded resolver
    // consumes it once and can enqueue other barrels without recursion.
    barrel\state = 2;
    barrel\phase_tick = 0;
  )
  => damage;
)

private op doom_combat_resolve_barrel_explosions [map, combat] (
  let hits = 0;
  let processed = 0;
  let searching = 1;
  while ((searching == 1) and (processed < arr_len[combat\barrels])) (
    searching = 0;
    let source_index = 0 - 1;
    let i = 0;
    while ((i < arr_len[combat\barrels]) and (source_index < 0)) (
      let candidate = combat\barrels\\i;
      if ((candidate\state == 2) and (candidate\phase_tick == 0)) (
        source_index = i;
      )
      i = i + 1;
    )
    if (source_index >= 0) (
      searching = 1;
      processed = processed + 1;
      let source = combat\barrels\\source_index;
      source\phase_tick = 1;
      combat\explosion_serial = combat\explosion_serial + 1;
      i = 0;
      while (i < combat\enemy_count) (
        let actor = combat\actors\\i;
        if (doom_combat_actor_targetable[actor] == 1) (
          let distance = doom_combat_abs[actor\x - source\x];
          let dy = doom_combat_abs[actor\y - source\y];
          if (dy > distance) ( distance = dy; )
          if ((distance <= 128) and
              (doom_map_sight_blocked[
                 map, source\x, source\y, actor\x, actor\y
               ] == 0)) (
            let damage = 80 - distance / 2;
            if (damage < 16) ( damage = 16; )
            if (doom_combat_hurt_actor[combat, actor, damage] > 0) (
              hits = hits + 1;
            )
          )
        )
        i = i + 1;
      )
      i = 0;
      while (i < arr_len[combat\barrels]) (
        if (i != source_index) (
          let barrel = combat\barrels\\i;
          if (barrel\state == 1) (
            let distance = doom_combat_abs[barrel\x - source\x];
            let dy = doom_combat_abs[barrel\y - source\y];
            if (dy > distance) ( distance = dy; )
            if ((distance <= 96) and
                (doom_map_sight_blocked[
                   map, source\x, source\y, barrel\x, barrel\y
                 ] == 0) and
                (doom_combat_hurt_barrel[barrel, 20] > 0)) (
              hits = hits + 1;
            )
          )
        )
        i = i + 1;
      )
    )
  )
  => hits;
)

// A teleport destination is authoritative placement, not an ordinary attempt
// to enter an occupied body radius. Retire overlapping live bodies before the
// next movement frame so arrival cannot become an invisible collision trap.
// The bounded non-recursive barrel resolver preserves the same explosion path
// used by weapon damage.
op doom_combat_telefrag [map, combat, x, y] (
  let hits = 0;
  let i = 0;
  while (i < combat\enemy_count) (
    let actor = combat\actors\\i;
    if ((doom_combat_actor_targetable[actor] == 1) and
        (doom_combat_abs[actor\x - x] < 32) and
        (doom_combat_abs[actor\y - y] < 32)) (
      if (doom_combat_hurt_actor[combat, actor, actor\health] > 0) (
        hits = hits + 1;
      )
    )
    i = i + 1;
  )
  i = 0;
  while (i < arr_len[combat\barrels]) (
    let barrel = combat\barrels\\i;
    if ((barrel\state == 1) and
        (doom_combat_abs[barrel\x - x] < 32) and
        (doom_combat_abs[barrel\y - y] < 32)) (
      if (doom_combat_hurt_barrel[barrel, barrel\health] > 0) (
        hits = hits + 1;
      )
    )
    i = i + 1;
  )
  doom_combat_resolve_barrel_explosions[map, combat];
  doom_combat_validate[map, combat];
  => hits;
)

private op doom_combat_hurt_player_mode [map, combat, damage, forced] (
  if ((damage <= 0) or (combat\health == 0)) ( => combat; )
  if ((forced == 0) and (combat\invulnerability_tick > 0)) ( => combat; )
  if (combat\invisibility_tick > 0) (
    damage = (damage + 1) / 2;
  )
  let absorbed = 0;
  if (combat\armor > 0) (
    absorbed = (damage + 1) / 2;
    if (absorbed > combat\armor) ( absorbed = combat\armor; )
    combat\armor = combat\armor - absorbed;
    combat\armor_absorbed = combat\armor_absorbed + absorbed;
    damage = damage - absorbed;
  )
  if (damage > combat\health) ( damage = combat\health; )
  combat\health = combat\health - damage;
  combat\damage_taken = combat\damage_taken + damage;
  if (damage > 0) (
    combat\player_pain_serial = combat\player_pain_serial + 1;
    combat\player_pain_tick = combat\tick;
  )
  doom_combat_validate[map, combat];
  => combat;
)

op doom_combat_hurt_player [map, combat, damage] (
  => doom_combat_hurt_player_mode[map, combat, damage, 0];
)

// Sector 11 is the episode-completion damage floor. It deliberately bypasses
// temporary invulnerability so the explicit map exit cannot become stranded.
op doom_combat_hurt_player_forced [map, combat, damage] (
  => doom_combat_hurt_player_mode[map, combat, damage, 1];
)

private op doom_combat_spawn_player_projectile [map, combat,
                                                 player_x, player_y, angle,
                                                 kind, speed, damage] (
  if ((kind >= 1) and (kind <= 7) and
      ((kind == 1) or (kind >= 6)) and
      (speed > 0) and (speed <= 32) and
      (damage >= 0) and (damage <= 200)) () else (
    fall "doom_combat_spawn_player_projectile: invalid bounded projectile";
  )
  let direction = trig_sincos[angle];
  let q31 = 2147483648;
  let vx = direction\cos * speed / q31;
  let vy = direction\sin * speed / q31;
  let sector = doom_map_point_sector[map, player_x, player_y];
  let projectile = 0;
  let slot = 0 - 1;
  let i = 0;
  while ((i < arr_len[combat\projectiles]) and (slot < 0)) (
    let existing = combat\projectiles\\i;
    if (existing\state == 0) ( slot = i; )
    i = i + 1;
  )
  if (slot >= 0) (
    projectile = combat\projectiles\\slot;
  ) else if (arr_len[combat\projectiles] < 32) (
    projectile = {
      kind: 1, state: 0, x: 0, y: 0, z: 0,
      vx: 0, vy: 0, angle: 0, damage: 0, age: 0, hits: 0
    };
    combat\projectiles = combat\projectiles + [projectile];
  ) else (
    => 0;
  )
  projectile\kind = kind;
  projectile\state = 1;
  projectile\x = player_x + vx / 2;
  projectile\y = player_y + vy / 2;
  projectile\z = buf_get[map\sectors, sector * 5] + 32;
  projectile\vx = vx;
  projectile\vy = vy;
  projectile\angle = doom_combat_heading[vx, vy];
  projectile\damage = damage;
  projectile\age = 0;
  projectile\hits = 0;
  => 1;
)

private op doom_combat_spawn_rocket [map, combat,
                                     player_x, player_y, angle] (
  => doom_combat_spawn_player_projectile[
    map, combat, player_x, player_y, angle, 1, 16, 0
  ];
)

private op doom_combat_spawn_monster_projectile [map, combat, actor,
                                                  player_x, player_y] (
  let heading = doom_combat_heading[
    player_x - actor\x, player_y - actor\y
  ];
  let direction = trig_sincos[trig_from_degrees[heading]];
  let q31 = 2147483648;
  let projectile_kind = 2;
  let speed = 10;
  if (actor\kind == 3005) ( projectile_kind = 3; speed = 8; )
  if (actor\kind == 3003) ( projectile_kind = 4; speed = 15; )
  if (actor\kind == 16) ( projectile_kind = 5; speed = 20; )
  if ((actor\kind == 3001) or (actor\kind == 3005) or
      (actor\kind == 3003) or (actor\kind == 16)) () else (
    fall "doom_combat_spawn_monster_projectile: unsupported actor kind";
  )
  let vx = direction\cos * speed / q31;
  let vy = direction\sin * speed / q31;
  let projectile = 0;
  let slot = 0 - 1;
  let i = 0;
  while ((i < arr_len[combat\projectiles]) and (slot < 0)) (
    let existing = combat\projectiles\\i;
    if (existing\state == 0) ( slot = i; )
    i = i + 1;
  )
  if (slot >= 0) (
    projectile = combat\projectiles\\slot;
  ) else if (arr_len[combat\projectiles] < 32) (
    projectile = {
      kind: projectile_kind, state: 0, x: 0, y: 0, z: 0,
      vx: 0, vy: 0, angle: 0, damage: 0, age: 0, hits: 0
    };
    combat\projectiles = combat\projectiles + [projectile];
  ) else (
    => 0;
  )
  projectile\kind = projectile_kind;
  projectile\state = 1;
  projectile\x = actor\x + vx / 2;
  projectile\y = actor\y + vy / 2;
  projectile\z = doom_combat_floor_at[map, actor\x, actor\y] + 32;
  projectile\vx = vx;
  projectile\vy = vy;
  projectile\angle = heading;
  projectile\damage = doom_combat_imp_melee_damage[combat, actor];
  if (actor\kind != 3001) (
    projectile\damage = doom_combat_monster_ball_damage[combat, actor];
  )
  projectile\age = 0;
  projectile\hits = 0;
  => 1;
)

private op doom_combat_explode_rocket [map, combat, projectile] (
  let hits = 0;
  let i = 0;
  while (i < combat\enemy_count) (
    let actor = combat\actors\\i;
    if (doom_combat_actor_targetable[actor] == 1) (
      let distance = doom_combat_abs[actor\x - projectile\x];
      let dy = doom_combat_abs[actor\y - projectile\y];
      if (dy > distance) ( distance = dy; )
      if (distance <= 128) (
        let damage = 112 - distance * 3 / 4;
        if (damage < 16) ( damage = 16; )
        if (doom_combat_hurt_actor[combat, actor, damage] > 0) (
          hits = hits + 1;
        )
      )
    )
    i = i + 1;
  )
  i = 0;
  while (i < arr_len[combat\barrels]) (
    let barrel = combat\barrels\\i;
    if (barrel\state == 1) (
      let distance = doom_combat_abs[barrel\x - projectile\x];
      let dy = doom_combat_abs[barrel\y - projectile\y];
      if (dy > distance) ( distance = dy; )
      if ((distance <= 128) and
          (doom_map_sight_blocked[
             map, projectile\x, projectile\y, barrel\x, barrel\y
           ] == 0)) (
        let damage = 112 - distance * 3 / 4;
        if (damage < 16) ( damage = 16; )
        if (doom_combat_hurt_barrel[barrel, damage] > 0) (
          hits = hits + 1;
        )
      )
    )
    i = i + 1;
  )
  hits = hits + doom_combat_resolve_barrel_explosions[map, combat];
  projectile\state = 2;
  projectile\age = 0;
  projectile\hits = hits;
  combat\projectile_impacts = combat\projectile_impacts + 1;
  if (hits == 0) ( combat\misses = combat\misses + 1; )
  => hits;
)

private op doom_combat_impact_player_energy [map, combat, projectile] (
  if ((projectile\kind == 6) or (projectile\kind == 7)) () else (
    fall "doom_combat_impact_player_energy: non-energy projectile";
  )
  let radius = 32;
  if (projectile\kind == 7) ( radius = 256; )
  let hits = 0;
  let i = 0;
  while (i < combat\enemy_count) (
    let actor = combat\actors\\i;
    let distance = doom_combat_abs[actor\x - projectile\x];
    let dy = doom_combat_abs[actor\y - projectile\y];
    if (dy > distance) ( distance = dy; )
    if ((doom_combat_actor_targetable[actor] == 1) and
        (distance <= radius) and
        ((projectile\kind == 7) or (hits == 0)) and
        (doom_map_sight_blocked_at[
           map, projectile\x, projectile\y, projectile\z,
           actor\x, actor\y,
           doom_combat_floor_at[map, actor\x, actor\y] + 28
         ] == 0)) (
      let damage = projectile\damage;
      if (projectile\kind == 7) (
        damage = 200 - distance * 5 / 8;
        if (damage < 40) ( damage = 40; )
      )
      if (doom_combat_hurt_actor[combat, actor, damage] > 0) (
        hits = hits + 1;
      )
    )
    i = i + 1;
  )
  i = 0;
  while (i < arr_len[combat\barrels]) (
    let barrel = combat\barrels\\i;
    let distance = doom_combat_abs[barrel\x - projectile\x];
    let dy = doom_combat_abs[barrel\y - projectile\y];
    if (dy > distance) ( distance = dy; )
    if ((barrel\state == 1) and (distance <= radius) and
        ((projectile\kind == 7) or (hits == 0)) and
        (doom_map_sight_blocked_at[
           map, projectile\x, projectile\y, projectile\z,
           barrel\x, barrel\y,
           doom_combat_floor_at[map, barrel\x, barrel\y] + 21
         ] == 0)) (
      let damage = projectile\damage;
      if (projectile\kind == 7) (
        damage = 200 - distance * 5 / 8;
        if (damage < 40) ( damage = 40; )
      )
      if (doom_combat_hurt_barrel[barrel, damage] > 0) (
        hits = hits + 1;
      )
    )
    i = i + 1;
  )
  hits = hits + doom_combat_resolve_barrel_explosions[map, combat];
  projectile\state = 2;
  projectile\age = 0;
  projectile\hits = hits;
  combat\projectile_impacts = combat\projectile_impacts + 1;
  if (hits == 0) ( combat\misses = combat\misses + 1; )
  => hits;
)

private op doom_combat_impact_monster_projectile [map, combat, projectile,
                                                   hit_player] (
  if ((hit_player == 1) and (combat\health > 0)) (
    doom_combat_hurt_player[map, combat, projectile\damage];
    projectile\hits = 1;
  ) else (
    projectile\hits = 0;
  )
  projectile\state = 2;
  projectile\age = 0;
  combat\monster_projectile_impacts = combat\monster_projectile_impacts + 1;
  => projectile\hits;
)

private op doom_combat_tick_projectiles [map, combat,
                                         player_x, player_y, player_z] (
  let i = 0;
  while (i < arr_len[combat\projectiles]) (
    let projectile = combat\projectiles\\i;
    if (projectile\state == 1) (
      let next_x = projectile\x + projectile\vx;
      let next_y = projectile\y + projectile\vy;
      let impact = doom_map_move_blocked_at[
        map, projectile\x, projectile\y, next_x, next_y,
        projectile\z - 4, 8, 0
      ];
      let world_impact = impact;
      let hit_player = 0;
      if ((projectile\kind == 1) or (projectile\kind >= 6)) (
        let ai = 0;
        while ((ai < combat\enemy_count) and (impact == 0)) (
          let actor = combat\actors\\ai;
          if ((doom_combat_actor_targetable[actor] == 1) and
              (doom_combat_abs[actor\x - next_x] <= 24) and
              (doom_combat_abs[actor\y - next_y] <= 24)) (
            let actor_z = doom_combat_floor_at[map, actor\x, actor\y];
            if (doom_combat_vertical_overlap[
                  projectile\z - 4, 8, actor_z, 56
                ] == 1) (
              impact = 1;
            )
          )
          ai = ai + 1;
        )
        let bi = 0;
        while ((bi < arr_len[combat\barrels]) and (impact == 0)) (
          let barrel = combat\barrels\\bi;
          if ((barrel\state == 1) and
              (doom_combat_abs[barrel\x - next_x] <= 24) and
              (doom_combat_abs[barrel\y - next_y] <= 24)) (
            let barrel_z = doom_combat_floor_at[map, barrel\x, barrel\y];
            if (doom_combat_vertical_overlap[
                  projectile\z - 4, 8, barrel_z, 42
                ] == 1) (
              impact = 1;
            )
          )
          bi = bi + 1;
        )
      ) else if ((doom_combat_abs[player_x - next_x] <= 20) and
                 (doom_combat_abs[player_y - next_y] <= 20) and
                 (doom_combat_vertical_overlap[
                    projectile\z - 4, 8, player_z, 56
                  ] == 1)) (
        impact = 1;
        hit_player = 1;
      )
      if (impact == 1) (
        if (world_impact == 0) (
          projectile\x = next_x;
          projectile\y = next_y;
        )
        if (projectile\kind == 1) (
          doom_combat_explode_rocket[map, combat, projectile];
        ) else if (projectile\kind >= 6) (
          doom_combat_impact_player_energy[map, combat, projectile];
        ) else (
          doom_combat_impact_monster_projectile[
            map, combat, projectile, hit_player
          ];
        )
      ) else (
        projectile\x = next_x;
        projectile\y = next_y;
        projectile\age = projectile\age + 1;
        if (projectile\age >= 180) (
          if (projectile\kind == 1) (
            doom_combat_explode_rocket[map, combat, projectile];
          ) else if (projectile\kind >= 6) (
            doom_combat_impact_player_energy[map, combat, projectile];
          ) else (
            projectile\state = 0;
          )
        )
      )
    ) else if (projectile\state == 2) (
      projectile\age = projectile\age + 1;
      let retire = 8;
      if (projectile\kind >= 2) ( retire = 15; )
      if (projectile\kind == 7) ( retire = 24; )
      if (projectile\age >= retire) ( projectile\state = 0; )
    )
    i = i + 1;
  )
  => 0;
)

// Select one nearest bounded shootable. Keeping its kind explicit prevents a
// barrel in front of an enemy from becoming transparent to weapon authority.
op doom_combat_hitscan_at [map, combat, player_x, player_y, player_z,
                           angle, maximum] (
  let direction = trig_sincos[angle];
  let q31 = 2147483648;
  let best_kind = 0;
  let best_index = 0 - 1;
  let best_distance = maximum + 1;
  let i = 0;
  while (i < combat\enemy_count) (
    let actor = combat\actors\\i;
    if (doom_combat_actor_targetable[actor] == 1) (
      let dx = actor\x - player_x;
      let dy = actor\y - player_y;
      let forward = (dx * direction\cos + dy * direction\sin) / q31;
      let sideways = (dy * direction\cos - dx * direction\sin) / q31;
      if (sideways < 0) ( sideways = 0 - sideways; )
      if ((forward > 0) and (forward <= maximum) and
          (sideways <= 32) and (forward < best_distance) and
          (doom_map_sight_blocked_at[
             map, player_x, player_y, player_z + 41,
             actor\x, actor\y,
             doom_combat_floor_at[map, actor\x, actor\y] + 28
           ] == 0)) (
        best_kind = 1;
        best_index = i;
        best_distance = forward;
      )
    )
    i = i + 1;
  )
  i = 0;
  while (i < arr_len[combat\barrels]) (
    let barrel = combat\barrels\\i;
    if (barrel\state == 1) (
      let dx = barrel\x - player_x;
      let dy = barrel\y - player_y;
      let forward = (dx * direction\cos + dy * direction\sin) / q31;
      let sideways = (dy * direction\cos - dx * direction\sin) / q31;
      if (sideways < 0) ( sideways = 0 - sideways; )
      if ((forward > 0) and (forward <= maximum) and
          (sideways <= 24) and (forward < best_distance) and
          (doom_map_sight_blocked_at[
             map, player_x, player_y, player_z + 41,
             barrel\x, barrel\y,
             doom_combat_floor_at[map, barrel\x, barrel\y] + 21
           ] == 0)) (
        best_kind = 2;
        best_index = i;
        best_distance = forward;
      )
    )
    i = i + 1;
  )
  => { kind: best_kind, index: best_index, distance: best_distance };
)

op doom_combat_hitscan [map, combat, player_x, player_y, angle, maximum] (
  => doom_combat_hitscan_at[
    map, combat, player_x, player_y,
    doom_combat_floor_at[map, player_x, player_y], angle, maximum
  ];
)

op doom_combat_hitscan_target [map, combat, player_x, player_y,
                               angle, maximum] (
  let target = doom_combat_hitscan[
    map, combat, player_x, player_y, angle, maximum
  ];
  if (target\kind == 1) ( => target\index; )
  => 0 - 1;
)

// The deterministic evidence producer needs a bearing without introducing a
// language-level atan2. It selects one visible target at least 64 units away,
// then exhaustively chooses the best of the closed 360-degree command domain.
// This runs only when a demo aim phase begins, never in the interactive loop.
op doom_combat_demo_heading [map, combat, player_x, player_y, fallback] (
  let player_z = doom_combat_floor_at[map, player_x, player_y];
  let target = 0 - 1;
  let best_distance = 2147483647;
  let i = 0;
  while (i < combat\enemy_count) (
    let actor = combat\actors\\i;
    if ((doom_combat_actor_targetable[actor] == 1) and
        (doom_combat_line_of_sight[
           map, actor, player_x, player_y, player_z
         ] == 1)) (
      let dx = doom_combat_abs[actor\x - player_x];
      let dy = doom_combat_abs[actor\y - player_y];
      let distance = dx + dy;
      if ((distance >= 64) and (distance < best_distance)) (
        target = i;
        best_distance = distance;
      )
    )
    i = i + 1;
  )
  if (target < 0) (
    i = 0;
    while (i < combat\enemy_count) (
      let actor = combat\actors\\i;
      if ((doom_combat_actor_targetable[actor] == 1) and
          (doom_combat_line_of_sight[
             map, actor, player_x, player_y, player_z
           ] == 1)) (
        let distance = doom_combat_abs[actor\x - player_x] +
          doom_combat_abs[actor\y - player_y];
        if (distance < best_distance) (
          target = i;
          best_distance = distance;
        )
      )
      i = i + 1;
    )
  )
  if (target < 0) ( => fallback; )
  let actor = combat\actors\\target;
  let dx = actor\x - player_x;
  let dy = actor\y - player_y;
  let heading = 0;
  let best_dot = 0 - 1;
  let degrees = 0;
  while (degrees < 360) (
    let direction = trig_sincos[trig_from_degrees[degrees]];
    let dot = dx * direction\cos + dy * direction\sin;
    if (dot > best_dot) (
      best_dot = dot;
      heading = degrees;
    )
    degrees = degrees + 1;
  )
  => heading;
)

op doom_combat_fire_at [map, combat, player_x, player_y, player_z, angle] (
  if (combat\health > 0) () else ( => combat; )
  if (combat\shot_cooldown == 0) () else ( => combat; )
  let weapon = combat\selected_weapon;
  if (doom_combat_can_fire[combat] == 1) () else (
    combat\dry_fires = combat\dry_fires + 1;
    => combat;
  )
  let damage = 10;
  if (weapon == 1) (
    damage = 20;
    if (combat\berserk == 1) ( damage = 60; )
  ) else if ((weapon == 2) or (weapon == 4)) (
    combat\ammo = combat\ammo - 1;
  ) else if (weapon == 3) (
    combat\shells = combat\shells - 1;
    damage = 45;
  ) else if (weapon == 5) (
    combat\rockets = combat\rockets - 1;
    damage = 100;
  ) else if (weapon == 6) (
    combat\cells = combat\cells - 1;
    damage = 20;
  ) else if (weapon == 7) (
    combat\cells = combat\cells - 40;
    damage = 200;
  ) else (
    fall "doom_combat_fire: selected weapon is outside bounded arsenal";
  )
  combat\shots = combat\shots + 1;
  combat\shot_cooldown = 10;
  if (weapon == 1) ( combat\shot_cooldown = 4; )
  if (weapon == 3) ( combat\shot_cooldown = 24; )
  if (weapon == 4) ( combat\shot_cooldown = 4; )
  if (weapon == 5) ( combat\shot_cooldown = 30; )
  if (weapon == 6) ( combat\shot_cooldown = 4; )
  if (weapon == 7) ( combat\shot_cooldown = 30; )
  if (weapon == 5) (
    doom_combat_spawn_rocket[map, combat, player_x, player_y, angle];
    doom_combat_validate[map, combat];
    => combat;
  )
  if ((weapon == 6) or (weapon == 7)) (
    let kind = 6;
    let speed = 25;
    if (weapon == 7) ( kind = 7; speed = 18; )
    doom_combat_spawn_player_projectile[
      map, combat, player_x, player_y, angle, kind, speed, damage
    ];
    doom_combat_validate[map, combat];
    => combat;
  )
  let target = doom_combat_hitscan_at[
    map, combat, player_x, player_y, player_z, angle, 1024
  ];
  if (target\kind == 0) (
    combat\misses = combat\misses + 1;
    doom_combat_validate[map, combat];
    => combat;
  )
  if (target\kind == 1) (
    let actor = combat\actors\\(target\index);
    doom_combat_hurt_actor[combat, actor, damage];
  ) else if (target\kind == 2) (
    let barrel = combat\barrels\\(target\index);
    doom_combat_hurt_barrel[barrel, damage];
    doom_combat_resolve_barrel_explosions[map, combat];
  ) else (
    fall "doom_combat_fire: hitscan returned unknown target kind";
  )
  doom_combat_validate[map, combat];
  => combat;
)

op doom_combat_fire [map, combat, player_x, player_y, angle] (
  => doom_combat_fire_at[
    map, combat, player_x, player_y,
    doom_combat_floor_at[map, player_x, player_y], angle
  ];
)

private op doom_combat_tick_barrels [combat] (
  let i = 0;
  while (i < arr_len[combat\barrels]) (
    let barrel = combat\barrels\\i;
    if (barrel\state == 2) (
      barrel\phase_tick = barrel\phase_tick + 1;
      if (barrel\phase_tick >= 45) (
        barrel\phase_tick = 45;
        barrel\state = 0;
      )
    )
    i = i + 1;
  )
  => 0;
)

op doom_combat_tick_at [map, combat, player_x, player_y, player_z] (
  if (combat\invulnerability_tick > 0) (
    combat\invulnerability_tick = combat\invulnerability_tick - 1;
  )
  if (combat\invisibility_tick > 0) (
    combat\invisibility_tick = combat\invisibility_tick - 1;
  )
  if (combat\radiation_tick > 0) (
    combat\radiation_tick = combat\radiation_tick - 1;
  )
  if (combat\light_tick > 0) (
    combat\light_tick = combat\light_tick - 1;
  )
  if (combat\shot_cooldown > 0) (
    combat\shot_cooldown = combat\shot_cooldown - 1;
  )
  doom_combat_tick_projectiles[
    map, combat, player_x, player_y, player_z
  ];
  doom_combat_tick_barrels[combat];
  let i = 0;
  while (i < combat\enemy_count) (
    let actor = combat\actors\\i;
    if (actor\attack_cooldown > 0) (
      actor\attack_cooldown = actor\attack_cooldown - 1;
    )
    actor\phase with states DoomEnemyPhase {
      Dormant => (
        actor\phase_tick = actor\phase_tick + 1;
        if (actor\phase_tick > 30) ( actor\phase_tick = 0; )
        if ((combat\health > 0) and
            (doom_combat_distance[actor, player_x, player_y] <= 640) and
            (doom_combat_line_of_sight[
               map, actor, player_x, player_y, player_z
             ] == 1)) (
          actor\phase = DoomEnemyPhase\Chase;
          actor\phase_tick = 0;
          combat\monster_alert_kind = actor\kind;
          combat\monster_alert_serial = combat\monster_alert_serial + 1;
        )
      )
      Chase => (
        actor\phase_tick = actor\phase_tick + 1;
        if (actor\phase_tick > 30) ( actor\phase_tick = 0; )
        actor\angle = doom_combat_heading[
          player_x - actor\x, player_y - actor\y
        ];
        let distance = doom_combat_distance[actor, player_x, player_y];
        let visible = doom_combat_line_of_sight[
          map, actor, player_x, player_y, player_z
        ];
        let attack_range = doom_combat_actor_attack_range[actor\kind];
        if ((combat\health > 0) and (distance <= attack_range) and
            (visible == 1) and
            (actor\attack_cooldown == 0)) (
          actor\phase = DoomEnemyPhase\Attack;
          actor\phase_tick = 0;
        ) else if ((combat\health > 0) and (distance > 56) and
                   (visible == 1) and
                   (actor\phase_tick % 3 == 0)) (
          doom_combat_move_actor[
            map, combat, actor, player_x, player_y, player_z
          ];
        )
      )
      Attack => (
        actor\phase_tick = actor\phase_tick + 1;
        let distance = doom_combat_distance[actor, player_x, player_y];
        let visible = doom_combat_line_of_sight[
          map, actor, player_x, player_y, player_z
        ];
        let attack_range = doom_combat_actor_attack_range[actor\kind];
        if ((combat\health == 0) or (distance > attack_range + 128) or
            (visible == 0)) (
          actor\phase = DoomEnemyPhase\Chase;
          actor\phase_tick = 0;
        ) else (
          if (actor\kind == 3006) (
            let charge_step = 0;
            while (charge_step < 4) (
              doom_combat_move_actor[
                map, combat, actor, player_x, player_y, player_z
              ];
              charge_step = charge_step + 1;
            )
          )
          if ((actor\phase_tick == 8) and (actor\attack_cooldown == 0)) (
            combat\monster_attack_kind = actor\kind;
            combat\monster_attack_serial = combat\monster_attack_serial + 1;
            if (actor\kind == 3004) (
              if (doom_combat_human_bullet_hits[
                    combat, actor, distance
                  ] == 1) (
                doom_combat_hurt_player[
                  map, combat, doom_combat_human_bullet_damage[combat, actor]
                ];
              )
            ) else if (actor\kind == 9) (
              let damage = doom_combat_shotgun_damage[
                combat, actor, distance
              ];
              if (damage > 0) (
                doom_combat_hurt_player[map, combat, damage];
              )
            ) else if (actor\kind == 3001) (
              if (distance <= 64) (
                doom_combat_hurt_player[
                  map, combat, doom_combat_imp_melee_damage[combat, actor]
                ];
              ) else (
                doom_combat_spawn_monster_projectile[
                  map, combat, actor, player_x, player_y
                ];
              )
            ) else if ((actor\kind == 3002) or (actor\kind == 58)) (
              doom_combat_hurt_player[
                map, combat, doom_combat_demon_melee_damage[combat, actor]
              ];
            ) else if ((actor\kind == 3005) or (actor\kind == 3003) or
                       (actor\kind == 16)) (
              doom_combat_spawn_monster_projectile[
                map, combat, actor, player_x, player_y
              ];
            ) else if (actor\kind == 3006) (
              if (doom_combat_distance[actor, player_x, player_y] <= 48) (
                doom_combat_hurt_player[
                  map, combat, doom_combat_lost_soul_damage[combat, actor]
                ];
              )
            ) else if (actor\kind == 7) (
              let damage = doom_combat_shotgun_damage[
                combat, actor, distance
              ];
              if (damage > 0) (
                doom_combat_hurt_player[map, combat, damage];
              )
            ) else (
              fall "doom_combat_tick_at: admitted actor has no attack";
            )
            actor\attack_cooldown = 60;
          )
          if (actor\phase_tick >= 18) (
            actor\phase = DoomEnemyPhase\Chase;
            actor\phase_tick = 0;
          )
        )
      )
      Pain => (
        actor\phase_tick = actor\phase_tick + 1;
        if (actor\phase_tick >= 8) (
          actor\phase = DoomEnemyPhase\Chase;
          actor\phase_tick = 0;
        )
      )
      Death => (
        let terminal_tick = 25;
        if (actor\family == 5) ( terminal_tick = 36; )
        if (actor\phase_tick < terminal_tick) (
          actor\phase_tick = actor\phase_tick + 1;
        )
      )
    };
    i = i + 1;
  )
  combat\tick = combat\tick + 1;
  doom_combat_validate[map, combat];
  => combat;
)

// Deterministic fixtures that do not model jumping retain the grounded entry
// point; the live application passes its authoritative airborne feet height.
op doom_combat_tick [map, combat, player_x, player_y] (
  => doom_combat_tick_at[
    map, combat, player_x, player_y,
    doom_combat_floor_at[map, player_x, player_y]
  ];
)
