// Bounded classic Doom wall/flat asset loading.
//
// Wall textures are composed from PNAMES + TEXTURE1/2 patch graphs into a
// map-local indexed atlas. Sector flats are retained as their native 64x64
// indexed pixels. Every directory span, definition, patch column and post is
// checked before an indexed read; PLAYPAL/COLORMAP remain data, not a native
// image-decoder boundary.

credits: <../games/doom-format.flx> <../games/doom-stock.flx>
         <../games/doom-laser.flx> <../games/doom-shield.flx>
         <f/buffers> <f/bytes>
         <f/files-chaos> <f/strings>;

private op doom_texture_read_range [path, offset, count] (
  => read_range[path, offset, count] with chaos { _ => bytes_new[0] };
)

// A retained WAD owner is the browser/native-neutral texture source.  Every
// caller has already proved the directory entry against the owner's exact
// measurement, but keep this leaf independently bounded so no future catalog
// path can turn bytes_slice's caller contract into an unchecked read.
private op doom_texture_read_wad [wad, offset, count] (
  if ((is_bytes[wad] == 1) and (offset >= 0) and (count >= 0) and
      (offset <= bytes_len[wad]) and (count <= bytes_len[wad] - offset)) (
    => bytes_slice[wad, offset, count];
  )
  => bytes_new[0];
)

private op doom_texture_s16 [b, offset] (
  let value = doom_wad_u16le[b, offset];
  if (value >= 32768) ( => value - 65536; )
  => value;
)

private op doom_texture_result [ok, error, count] (
  => { ok: ok, error: error, count: count };
)

private op doom_texture_error [message] (
  => doom_texture_result[0, message, 0];
)

op doom_texture_empty_bank [] (
  => {
    ready: 0, error: "", texture_count: 0,
    texture_names: bytes_new[0], texture_meta: %32[],
    texture_pixels: bytes_new[0], texture_opaque: bytes_new[0],
    flat_count: 0, flat_names: bytes_new[0],
    flat_pixels: bytes_new[0], sky_flat: 0 - 1, sky_texture: 0 - 1,
    sprite_ready: 0, sprite_slots: 0, sprite_loaded: 0,
    sprite_meta: %32[], sprite_pixels: bytes_new[0],
    sprite_opaque: bytes_new[0],
    ui_ready: 0, ui_slots: 0, ui_meta: %32[],
    ui_pixels: bytes_new[0], ui_opaque: bytes_new[0],
    palette: bytes_new[0], colormap: bytes_new[0],
    colours: %32[], rgbx_colours: %32[]
  };
)

private op doom_texture_bank_error [message] (
  => doom_texture_empty_bank[] + { error: message };
)

private op doom_texture_name_fold [c] (
  if ((c >= 97) and (c <= 122)) ( => c - 32; )
  => c;
)

op doom_texture_name_valid_at [b, offset] (
  if ((offset >= 0) and (offset <= bytes_len[b] - 8)) () else ( => 0; )
  let ended = 0;
  let length = 0;
  let i = 0;
  while (i < 8) (
    let c = bytes_get[b, offset + i];
    if (ended == 1) (
      if (c != 0) ( => 0; )
    ) else if (c == 0) (
      ended = 1;
    ) else (
      if ((c < 33) or (c > 126)) ( => 0; )
      length = length + 1;
    )
    i = i + 1;
  )
  => length > 0;
)

op doom_texture_name_equal [left, left_offset, right, right_offset] (
  if ((left_offset >= 0) and (left_offset <= bytes_len[left] - 8) and
      (right_offset >= 0) and (right_offset <= bytes_len[right] - 8)) () else (
    => 0;
  )
  let i = 0;
  while (i < 8) (
    let a = doom_texture_name_fold[bytes_get[left, left_offset + i]];
    let b = doom_texture_name_fold[bytes_get[right, right_offset + i]];
    if (a != b) ( => 0; )
    i = i + 1;
  )
  => 1;
)

op doom_texture_name_is [b, offset, name] (
  if ((offset >= 0) and (offset <= bytes_len[b] - 8)) () else ( => 0; )
  let length = str_len[name];
  if (length <= 8) () else ( => 0; )
  let i = 0;
  while (i < 8) (
    let wanted = 0;
    if (i < length) ( wanted = name\\i; )
    let actual = doom_texture_name_fold[bytes_get[b, offset + i]];
    if (actual != doom_texture_name_fold[wanted]) ( => 0; )
    i = i + 1;
  )
  => 1;
)

// Produce the opposite canonical SW1*/SW2* name without granting arbitrary
// string/path authority. Returning zero leaves ordinary wall textures alone.
private op doom_texture_switch_name_into [source, source_offset, target] (
  if (doom_texture_name_valid_at[source, source_offset] == 1) () else ( => 0; )
  if ((doom_texture_name_fold[bytes_get[source, source_offset]] == 83) and
      (doom_texture_name_fold[bytes_get[source, source_offset + 1]] == 87) and
      ((bytes_get[source, source_offset + 2] == 49) or
       (bytes_get[source, source_offset + 2] == 50))) () else ( => 0; )
  doom_texture_name_copy[source, source_offset, target, 0];
  if (bytes_get[target, 2] == 49) (
    bytes_set[target, 2, 50];
  ) else (
    bytes_set[target, 2, 49];
  )
  => 1;
)

// Resolve a loaded switch texture to its opposite atlas slot. The loader
// admits the matching definition alongside every map-referenced SW1/SW2 name,
// so the frame loop and mutable world never search the WAD itself.
op doom_texture_switch_partner [bank, texture] (
  if ((texture >= 0) and (texture < bank\texture_count) and
      (bytes_len[bank\texture_names] == bank\texture_count * 8)) () else (
    => 0 - 1;
  )
  let alternate = bytes_new[8];
  doom_texture_zero[alternate];
  if (doom_texture_switch_name_into[
        bank\texture_names, texture * 8, alternate
      ] == 1) () else ( => 0 - 1; )
  => doom_texture_compact_find[
    bank\texture_names, bank\texture_count, alternate, 0
  ];
)

private op doom_texture_name_copy [source, source_offset, target, target_offset] (
  let i = 0;
  while (i < 8) (
    bytes_set[target, target_offset + i, bytes_get[source, source_offset + i]];
    i = i + 1;
  )
  => 0;
)

private op doom_texture_directory_name_equal [directory, index, name, name_offset] (
  => doom_texture_name_equal[directory, index * 16 + 8, name, name_offset];
)

private op doom_texture_find_lump_raw [directory, lump_count, name, name_offset] (
  let i = lump_count - 1;
  while (i >= 0) (
    if (doom_texture_directory_name_equal[
          directory, i, name, name_offset
        ] == 1) ( => i; )
    i = i - 1;
  )
  => 0 - 1;
)

private op doom_texture_find_lump [directory, lump_count, name] (
  let i = lump_count - 1;
  while (i >= 0) (
    if (doom_texture_name_is[directory, i * 16 + 8, name] == 1) ( => i; )
    i = i - 1;
  )
  => 0 - 1;
)

private op doom_texture_entry [directory, index] (
  let base = index * 16;
  => {
    index: index,
    offset: doom_wad_u32le[directory, base],
    bytes: doom_wad_u32le[directory, base + 4]
  };
)

private op doom_texture_entry_fits [entry, file_bytes] (
  => (entry\offset <= file_bytes) and
    (entry\bytes <= file_bytes - entry\offset);
)

op doom_texture_parse_pnames [pnames] (
  if (bytes_len[pnames] >= 4) () else (
    => doom_texture_error["PNAMES is shorter than its count"];
  )
  let count = doom_wad_u32le[pnames, 0];
  if (count <= 4096) () else (
    => doom_texture_error["PNAMES exceeds 4096 names"];
  )
  if (bytes_len[pnames] == 4 + count * 8) () else (
    => doom_texture_error["PNAMES length does not match its count"];
  )
  let i = 0;
  while (i < count) (
    if (doom_texture_name_valid_at[pnames, 4 + i * 8] == 1) () else (
      => doom_texture_error["PNAMES entry ^{i} is not a canonical WAD name"];
    )
    i = i + 1;
  )
  => doom_texture_result[1, "", count];
)

op doom_texture_validate_definitions [label, data, pnames_count] (
  if (bytes_len[data] >= 4) () else (
    => doom_texture_error["^{label} is shorter than its count"];
  )
  let count = doom_wad_u32le[data, 0];
  if (count <= 4096) () else (
    => doom_texture_error["^{label} exceeds 4096 textures"];
  )
  let directory_bytes = 4 + count * 4;
  if (directory_bytes <= bytes_len[data]) () else (
    => doom_texture_error["^{label} directory exceeds the lump"];
  )
  let i = 0;
  while (i < count) (
    let offset = doom_wad_u32le[data, 4 + i * 4];
    if ((offset >= directory_bytes) and (offset <= bytes_len[data] - 22)) () else (
      => doom_texture_error["^{label} texture ^{i} has an invalid offset"];
    )
    if (doom_texture_name_valid_at[data, offset] == 1) () else (
      => doom_texture_error["^{label} texture ^{i} has an invalid name"];
    )
    let width = doom_wad_u16le[data, offset + 12];
    let height = doom_wad_u16le[data, offset + 14];
    let patch_count = doom_wad_u16le[data, offset + 20];
    if ((width > 0) and (width <= 4096) and
        (height > 0) and (height <= 4096) and
        (width * height <= 8388608)) () else (
      => doom_texture_error["^{label} texture ^{i} has invalid dimensions"];
    )
    if ((patch_count > 0) and (patch_count <= 1024)) () else (
      => doom_texture_error["^{label} texture ^{i} has invalid patch count"];
    )
    if (22 + patch_count * 10 <= bytes_len[data] - offset) () else (
      => doom_texture_error["^{label} texture ^{i} patch list exceeds the lump"];
    )
    let p = 0;
    while (p < patch_count) (
      let patch = doom_wad_u16le[data, offset + 22 + p * 10 + 4];
      if (patch < pnames_count) () else (
        => doom_texture_error[
          "^{label} texture ^{i} patch ^{p} exceeds PNAMES"
        ];
      )
      p = p + 1;
    )
    i = i + 1;
  )
  => doom_texture_result[1, "", count];
)

private op doom_texture_find_in_definitions [data, name, name_offset, source] (
  if (bytes_len[data] < 4) (
    => { found: 0, source: source, offset: 0, width: 0, height: 0,
         patches: 0 };
  )
  let count = doom_wad_u32le[data, 0];
  let i = count - 1;
  while (i >= 0) (
    let offset = doom_wad_u32le[data, 4 + i * 4];
    if (doom_texture_name_equal[data, offset, name, name_offset] == 1) (
      => {
        found: 1, source: source, offset: offset,
        width: doom_wad_u16le[data, offset + 12],
        height: doom_wad_u16le[data, offset + 14],
        patches: doom_wad_u16le[data, offset + 20]
      };
    )
    i = i - 1;
  )
  => { found: 0, source: source, offset: 0, width: 0, height: 0,
       patches: 0 };
)

private op doom_texture_find_definition [texture1, texture1_index,
                                         texture2, texture2_index,
                                         name, name_offset] (
  // The later effective catalog wins; duplicate definitions inside one
  // catalog also resolve backward. Classic IWADs place TEXTURE2 later, but
  // the rule is derived from the actual confined directory rather than that
  // historical ordering.
  let later = doom_texture_find_in_definitions[
    texture1, name, name_offset, 1
  ];
  let earlier = doom_texture_find_in_definitions[
    texture2, name, name_offset, 2
  ];
  if (texture2_index > texture1_index) (
    let swap = later; later = earlier; earlier = swap;
  )
  if (later\found == 1) ( => later; )
  => earlier;
)

op doom_texture_validate_patch [patch] (
  if (bytes_len[patch] >= 8) () else (
    => doom_texture_error["patch is shorter than its header"];
  )
  let width = doom_wad_u16le[patch, 0];
  let height = doom_wad_u16le[patch, 2];
  if ((width > 0) and (width <= 4096) and
      (height > 0) and (height <= 4096)) () else (
    => doom_texture_error["patch dimensions are outside 1..4096"];
  )
  let header_bytes = 8 + width * 4;
  if (header_bytes <= bytes_len[patch]) () else (
    => doom_texture_error["patch column directory exceeds the lump"];
  )
  let column = 0;
  while (column < width) (
    let cursor = doom_wad_u32le[patch, 8 + column * 4];
    if ((cursor >= header_bytes) and (cursor < bytes_len[patch])) () else (
      => doom_texture_error["patch column ^{column} has an invalid offset"];
    )
    let posts = 0;
    let ended = 0;
    while (ended == 0) (
      if (cursor < bytes_len[patch]) () else (
        => doom_texture_error["patch column ^{column} has no terminator"];
      )
      let top = bytes_get[patch, cursor];
      if (top == 255) (
        ended = 1;
      ) else (
        if (cursor <= bytes_len[patch] - 4) () else (
          => doom_texture_error["patch column ^{column} has a short post"];
        )
        let length = bytes_get[patch, cursor + 1];
        if ((length > 0) and (top + length <= height)) () else (
          => doom_texture_error["patch column ^{column} has an invalid post span"];
        )
        if (length + 4 <= bytes_len[patch] - cursor) () else (
          => doom_texture_error["patch column ^{column} post exceeds the lump"];
        )
        cursor = cursor + length + 4;
        posts = posts + 1;
        if (posts <= height + 1) () else (
          => doom_texture_error["patch column ^{column} exceeds its post bound"];
        )
      )
    )
    column = column + 1;
  )
  => doom_texture_result[1, "", width];
)

op doom_texture_compose_patch [pixels, opaque, atlas_offset,
                               texture_width, texture_height,
                               patch, origin_x, origin_y] (
  let valid = doom_texture_validate_patch[patch];
  if (valid\ok == 1) () else ( => valid; )
  if ((atlas_offset >= 0) and
      (texture_width > 0) and (texture_height > 0) and
      (texture_width * texture_height <= bytes_len[pixels] - atlas_offset) and
      (bytes_len[opaque] == bytes_len[pixels])) () else (
    => doom_texture_error["texture composition target exceeds its atlas"];
  )
  let patch_width = doom_wad_u16le[patch, 0];
  let column = 0;
  while (column < patch_width) (
    let cursor = doom_wad_u32le[patch, 8 + column * 4];
    let top = bytes_get[patch, cursor];
    while (top != 255) (
      let length = bytes_get[patch, cursor + 1];
      let x = origin_x + column;
      let row = 0;
      while (row < length) (
        let y = origin_y + top + row;
        if ((x >= 0) and (x < texture_width) and
            (y >= 0) and (y < texture_height)) (
          let target = atlas_offset + y * texture_width + x;
          bytes_set[pixels, target, bytes_get[patch, cursor + 3 + row]];
          bytes_set[opaque, target, 1];
        )
        row = row + 1;
      )
      cursor = cursor + length + 4;
      top = bytes_get[patch, cursor];
    )
    column = column + 1;
  )
  => doom_texture_result[1, "", patch_width];
)

// A classic sprite lump is BASE[4] + FRAME + ROTATION, optionally followed
// by a second FRAME + ROTATION that reuses the same patch mirrored. Rotation
// zero means one view serves every direction; a lump may still name a second
// independent rotation-zero frame.
// This validates the whole selected namespace before a patch byte is read.
op doom_texture_sprite_name_valid_at [b, offset] (
  if (doom_texture_name_valid_at[b, offset] == 1) () else ( => 0; )
  let length = 0;
  while ((length < 8) and (bytes_get[b, offset + length] != 0)) (
    length = length + 1;
  )
  if ((length == 6) or (length == 8)) () else ( => 0; )
  let i = 0;
  while (i < 4) (
    let c = bytes_get[b, offset + i];
    if (((c >= 65) and (c <= 90)) or
        ((c >= 48) and (c <= 57))) () else ( => 0; )
    i = i + 1;
  )
  let frame = bytes_get[b, offset + 4];
  let rotation = bytes_get[b, offset + 5];
  if ((frame >= 65) and (frame <= 90) and
      (rotation >= 48) and (rotation <= 56)) () else ( => 0; )
  if (length == 6) ( => 1; )
  let second_frame = bytes_get[b, offset + 6];
  let second_rotation = bytes_get[b, offset + 7];
  => (second_frame >= 65) and (second_frame <= 90) and
    (second_rotation >= 48) and (second_rotation <= 56);
)

// Doom One's cast is a closed table. Spectres deliberately share SARG pixels
// with demons; their visual distinction belongs to the renderer.
op doom_texture_sprite_family [kind] (
  => doom_stock_actor_family[kind];
)

// Static E1M1 resource and weapon sprites. Animation remains deliberately
// outside this slice; frame A is the canonical, validated pickup witness.
op doom_texture_pickup_family [kind] (
  if (kind == doom_laser_pickup_kind[]) (
    => doom_stock_pickup_family[doom_laser_source_pickup_kind[]];
  )
  => doom_stock_pickup_family[kind];
)

op doom_texture_prop_family [kind] (
  => doom_stock_prop_family[kind];
)

op doom_texture_prop_solid [kind] (
  => doom_stock_prop_solid[kind];
)

op doom_texture_prop_radius [kind] (
  => doom_stock_prop_radius[kind];
)

op doom_texture_prop_hangs [kind] (
  => doom_stock_prop_hangs[kind];
)

op doom_texture_prop_world_height [kind] (
  => doom_stock_prop_world_height[kind];
)

op doom_texture_prop_frame_count [family] (
  if (family == 0) ( => 7; )
  if ((family == 11) or (family == 14) or (family == 21)) ( => 2; )
  if (family == 24) ( => 3; )
  if ((family == 23) or (family == 26) or (family == 27) or
      (family == 28) or (family == 31) or
      (family == 37) or (family == 38) or (family == 39)) ( => 4; )
  if ((family >= 1) and (family < 41)) ( => 1; )
  => 0;
)

op doom_texture_prop_frame_for_tick [kind, tick] (
  let family = doom_texture_prop_family[kind];
  if (family < 1) ( => 0; )
  let count = doom_texture_prop_frame_count[family];
  if (count <= 1) ( => 0; )
  let rate = 10;
  if ((family == 21) or (family == 31)) ( rate = 20; )
  if ((family >= 26) and (family <= 28)) ( rate = 7; )
  if ((family >= 37) and (family <= 39)) ( rate = 7; )
  => (tick / rate) % count;
)

private op doom_texture_frame_suffix [frame] (
  if (frame == 0) ( => "A0"; )
  if (frame == 1) ( => "B0"; )
  if (frame == 2) ( => "C0"; )
  if (frame == 3) ( => "D0"; )
  => "";
)

private op doom_texture_prop_name [family, frame] (
  if (family == 0) (
    if (frame == 0) ( => "BAR1A0"; )
    if (frame == 1) ( => "BAR1B0"; )
    if (frame == 2) ( => "BEXPA0"; )
    if (frame == 3) ( => "BEXPB0"; )
    if (frame == 4) ( => "BEXPC0"; )
    if (frame == 5) ( => "BEXPD0"; )
    if (frame == 6) ( => "BEXPE0"; )
  )
  if (family == 1) ( => "PLAYW0"; )
  if (family == 2) ( => "PLAYN0"; )
  if (family == 3) ( => "POSSL0"; )
  if (family == 4) ( => "SPOSL0"; )
  if (family == 5) ( => "TROOM0"; )
  if (family == 6) ( => "SARGN0"; )
  if (family == 7) ( => "HEADL0"; )
  if (family == 8) ( => "SKULK0"; )
  if (family == 9) ( => "POL5A0"; )
  if (family == 10) ( => "POL1A0"; )
  if (family == 11) (
    if (frame == 0) ( => "POL6A0"; )
    if (frame == 1) ( => "POL6B0"; )
  )
  if (family == 12) ( => "POL4A0"; )
  if (family == 13) ( => "POL2A0"; )
  if (family == 14) (
    if (frame == 0) ( => "POL3A0"; )
    if (frame == 1) ( => "POL3B0"; )
  )
  if (family == 15) ( => "COL1A0"; )
  if (family == 16) ( => "COL2A0"; )
  if (family == 17) ( => "COL3A0"; )
  if (family == 18) ( => "COL4A0"; )
  if (family == 19) ( => "CANDA0"; )
  if (family == 20) ( => "CBRAA0"; )
  if (family == 21) (
    if (frame == 0) ( => "COL5A0"; )
    if (frame == 1) ( => "COL5B0"; )
  )
  if (family == 22) ( => "COL6A0"; )
  if (family == 23) (
    if (frame == 0) ( => "CEYEA0"; )
    if ((frame == 1) or (frame == 3)) ( => "CEYEB0"; )
    if (frame == 2) ( => "CEYEC0"; )
  )
  if (family == 24) (
    if (frame == 0) ( => "FSKUA0"; )
    if (frame == 1) ( => "FSKUB0"; )
    if (frame == 2) ( => "FSKUC0"; )
  )
  if (family == 25) ( => "TRE1A0"; )
  if (family == 26) ( => "TBLU" + doom_texture_frame_suffix[frame]; )
  if (family == 27) ( => "TGRN" + doom_texture_frame_suffix[frame]; )
  if (family == 28) ( => "TRED" + doom_texture_frame_suffix[frame]; )
  if (family == 29) ( => "SMITA0"; )
  if (family == 30) ( => "ELECA0"; )
  if (family == 31) (
    if (frame == 0) ( => "GOR1A0"; )
    if ((frame == 1) or (frame == 3)) ( => "GOR1B0"; )
    if (frame == 2) ( => "GOR1C0"; )
  )
  if (family == 32) ( => "GOR2A0"; )
  if (family == 33) ( => "GOR3A0"; )
  if (family == 34) ( => "GOR4A0"; )
  if (family == 35) ( => "GOR5A0"; )
  if (family == 36) ( => "TRE2A0"; )
  if (family == 37) ( => "SMBT" + doom_texture_frame_suffix[frame]; )
  if (family == 38) ( => "SMGT" + doom_texture_frame_suffix[frame]; )
  if (family == 39) ( => "SMRT" + doom_texture_frame_suffix[frame]; )
  if (family == 40) ( => "COLUA0"; )
  => "";
)

private op doom_texture_pickup_name [family] (
  if (family == 0) ( => "CLIPA0"; )
  if (family == 1) ( => "AMMOA0"; )
  if (family == 2) ( => "STIMA0"; )
  if (family == 3) ( => "MEDIA0"; )
  if (family == 4) ( => "BON1A0"; )
  if (family == 5) ( => "BON2A0"; )
  if (family == 6) ( => "ARM1A0"; )
  if (family == 7) ( => "ARM2A0"; )
  if (family == 8) ( => "SHOTA0"; )
  if (family == 9) ( => "MGUNA0"; )
  if (family == 10) ( => "LAUNA0"; )
  if (family == 11) ( => "SHELA0"; )
  if (family == 12) ( => "SBOXA0"; )
  if (family == 13) ( => "BROKA0"; )
  if (family == 14) ( => "RKEYA0"; )
  if (family == 15) ( => "SOULA0"; )
  if (family == 16) ( => "CSAWA0"; )
  if (family == 17) ( => "BKEYA0"; )
  if (family == 18) ( => "YKEYA0"; )
  if (family == 19) ( => "RSKUA0"; )
  if (family == 20) ( => "YSKUA0"; )
  if (family == 21) ( => "BSKUA0"; )
  if (family == 22) ( => "PLASA0"; )
  if (family == 23) ( => "BFUGA0"; )
  if (family == 24) ( => "ROCKA0"; )
  if (family == 25) ( => "CELLA0"; )
  if (family == 26) ( => "CELPA0"; )
  if (family == 27) ( => "BPAKA0"; )
  if (family == 28) ( => "PINVA0"; )
  if (family == 29) ( => "PSTRA0"; )
  if (family == 30) ( => "PINSA0"; )
  if (family == 31) ( => "SUITA0"; )
  if (family == 32) ( => "PMAPA0"; )
  if (family == 33) ( => "PVISA0"; )
  => "";
)

private op doom_texture_sprite_base [family] (
  let base = "";
  if (family == 0) ( base = "POSS"; )
  if (family == 1) ( base = "SPOS"; )
  if (family == 2) ( base = "TROO"; )
  if (family == 3) ( base = "SARG"; )
  if (family == 4) ( base = "HEAD"; )
  if (family == 5) ( base = "SKUL"; )
  if (family == 6) ( base = "BOSS"; )
  if (family == 7) ( base = "CYBR"; )
  if (family == 8) ( base = "SPID"; )
  => base;
)

private op doom_texture_sprite_frame [frame] (
  if (frame == 0) ( => "A"; )
  if (frame == 1) ( => "B"; )
  if (frame == 2) ( => "C"; )
  if (frame == 3) ( => "D"; )
  if (frame == 4) ( => "E"; )
  if (frame == 5) ( => "F"; )
  if (frame == 6) ( => "G"; )
  if (frame == 7) ( => "H"; )
  => "";
)

private op doom_texture_standard_sprite_spec [base, letter, rotation] (
  if (rotation == 1) ( => { ok: 1, name: "^{base}^{letter}1", flip: 0 }; )
  if (rotation == 2) ( => { ok: 1, name: "^{base}^{letter}2^{letter}8", flip: 0 }; )
  if (rotation == 3) ( => { ok: 1, name: "^{base}^{letter}3^{letter}7", flip: 0 }; )
  if (rotation == 4) ( => { ok: 1, name: "^{base}^{letter}4^{letter}6", flip: 0 }; )
  if (rotation == 5) ( => { ok: 1, name: "^{base}^{letter}5", flip: 0 }; )
  if (rotation == 6) ( => { ok: 1, name: "^{base}^{letter}4^{letter}6", flip: 1 }; )
  if (rotation == 7) ( => { ok: 1, name: "^{base}^{letter}3^{letter}7", flip: 1 }; )
  if (rotation == 8) ( => { ok: 1, name: "^{base}^{letter}2^{letter}8", flip: 1 }; )
  => { ok: 0, name: "", flip: 0 };
)

private op doom_texture_skull_sprite_spec [letter, rotation] (
  if (rotation == 1) ( => { ok: 1, name: "SKUL^{letter}1", flip: 0 }; )
  if (rotation == 2) ( => { ok: 1, name: "SKUL^{letter}8^{letter}2", flip: 1 }; )
  if (rotation == 3) ( => { ok: 1, name: "SKUL^{letter}7^{letter}3", flip: 1 }; )
  if (rotation == 4) ( => { ok: 1, name: "SKUL^{letter}6^{letter}4", flip: 1 }; )
  if (rotation == 5) ( => { ok: 1, name: "SKUL^{letter}5", flip: 0 }; )
  if (rotation == 6) ( => { ok: 1, name: "SKUL^{letter}6^{letter}4", flip: 0 }; )
  if (rotation == 7) ( => { ok: 1, name: "SKUL^{letter}7^{letter}3", flip: 0 }; )
  if (rotation == 8) ( => { ok: 1, name: "SKUL^{letter}8^{letter}2", flip: 0 }; )
  => { ok: 0, name: "", flip: 0 };
)

// SPID reuses its A/B/C rotation-one and rotation-five lumps as D/E/F.
// Frame seven is reserved for the independent-rotation I pain witness; the
// shorter Freelang attack animation uses G while retaining the whole cast.
private op doom_texture_spider_sprite_spec [frame, rotation] (
  if ((frame >= 0) and (frame <= 2)) (
    let letter = doom_texture_sprite_frame[frame];
    let partner = doom_texture_sprite_frame[frame + 3];
    if (rotation == 1) (
      => { ok: 1, name: "SPID^{letter}1^{partner}1", flip: 0 };
    )
    if (rotation == 5) (
      => { ok: 1, name: "SPID^{letter}5^{partner}5", flip: 0 };
    )
    => doom_texture_standard_sprite_spec["SPID", letter, rotation];
  )
  if ((frame >= 3) and (frame <= 5)) (
    let letter = doom_texture_sprite_frame[frame];
    let source = doom_texture_sprite_frame[frame - 3];
    if (rotation == 1) (
      => { ok: 1, name: "SPID^{source}1^{letter}1", flip: 0 };
    )
    if (rotation == 5) (
      => { ok: 1, name: "SPID^{source}5^{letter}5", flip: 0 };
    )
    => doom_texture_standard_sprite_spec["SPID", letter, rotation];
  )
  if (frame == 6) (
    => doom_texture_standard_sprite_spec["SPID", "G", rotation];
  )
  if ((frame == 7) and (rotation >= 1) and (rotation <= 8)) (
    => { ok: 1, name: "SPIDI^{rotation}", flip: 0 };
  )
  => { ok: 0, name: "", flip: 0 };
)

private op doom_texture_sprite_spec [family, frame, rotation] (
  let base = doom_texture_sprite_base[family];
  let letter = doom_texture_sprite_frame[frame];
  if ((str_len[base] == 4) and (str_len[letter] == 1)) () else (
    => { ok: 0, name: "", flip: 0 };
  )
  if (family == 5) (
    => doom_texture_skull_sprite_spec[letter, rotation];
  )
  if (family == 8) (
    => doom_texture_spider_sprite_spec[frame, rotation];
  )
  // SARG/BOSS attack frames and every CYBR frame publish eight independent
  // rotations rather than mirrored-pair spellings.
  if (((family == 3) and (frame >= 4)) or
      ((family == 6) and (frame >= 4)) or (family == 7)) (
    if ((rotation >= 1) and (rotation <= 8)) (
      => { ok: 1, name: "^{base}^{letter}^{rotation}", flip: 0 };
    )
    => { ok: 0, name: "", flip: 0 };
  )
  => doom_texture_standard_sprite_spec[base, letter, rotation];
)

// Lost Souls own vanilla's full SKULF0--SKULK0 terminal sequence. Every
// ordinary family retains the five sampled death frames that end in a corpse.
op doom_texture_sprite_death_frame_count [family] (
  if ((family >= 0) and (family < 9)) () else (
    fall "doom_texture_sprite_death_frame_count: family outside bounded atlas";
  )
  if (family == 5) ( => 6; )
  => 5;
)

private op doom_texture_sprite_death_frame [family, frame] (
  if ((family >= 0) and (family < 9) and (frame >= 0) and
      (frame < doom_texture_sprite_death_frame_count[family])) () else (
    => "";
  )
  if ((family == 0) or (family == 1)) (
    if (frame == 0) ( => "H"; ) if (frame == 1) ( => "I"; )
    if (frame == 2) ( => "J"; ) if (frame == 3) ( => "K"; )
    => "L";
  )
  if (family == 2) (
    if (frame == 0) ( => "I"; ) if (frame == 1) ( => "J"; )
    if (frame == 2) ( => "K"; ) if (frame == 3) ( => "L"; )
    => "M";
  )
  if (family == 3) (
    if (frame == 0) ( => "I"; ) if (frame == 1) ( => "J"; )
    if (frame == 2) ( => "K"; ) if (frame == 3) ( => "M"; )
    => "N";
  )
  if (family == 4) (
    if (frame == 0) ( => "G"; ) if (frame == 1) ( => "H"; )
    if (frame == 2) ( => "I"; ) if (frame == 3) ( => "K"; )
    => "L";
  )
  if (family == 5) (
    if (frame == 0) ( => "F"; ) if (frame == 1) ( => "G"; )
    if (frame == 2) ( => "H"; ) if (frame == 3) ( => "I"; )
    if (frame == 4) ( => "J"; )
    => "K";
  )
  if (family == 6) (
    if (frame == 0) ( => "I"; ) if (frame == 1) ( => "J"; )
    if (frame == 2) ( => "L"; ) if (frame == 3) ( => "N"; )
    => "O";
  )
  if (family == 7) (
    if (frame == 0) ( => "H"; ) if (frame == 1) ( => "J"; )
    if (frame == 2) ( => "L"; ) if (frame == 3) ( => "N"; )
    => "P";
  )
  if (frame == 0) ( => "J"; ) if (frame == 1) ( => "L"; )
  if (frame == 2) ( => "N"; ) if (frame == 3) ( => "Q"; )
  if (frame == 4) ( => "S"; )
  => "";
)

private op doom_texture_sprite_frame_count [family] (
  if ((family == 0) or (family == 1) or (family == 7)) ( => 7; )
  if ((family == 2) or (family == 3) or
      (family == 6) or (family == 8)) ( => 8; )
  if (family == 4) ( => 6; )
  if (family == 5) ( => 5; )
  => 0;
)

private op doom_texture_sprite_death_spec [family, frame] (
  let base = doom_texture_sprite_base[family];
  let letter = doom_texture_sprite_death_frame[family, frame];
  if ((str_len[base] == 4) and (str_len[letter] == 1)) (
    => { ok: 1, name: "^{base}^{letter}0", flip: 0 };
  )
  => { ok: 0, name: "", flip: 0 };
)

private op doom_texture_weapon_name [weapon, frame] (
  if (weapon == 1) (
    if (frame == 0) ( => "SAWGA0"; )
    if (frame == 1) ( => "SAWGB0"; )
    if (frame == 2) ( => "SAWGC0"; )
    if (frame == 3) ( => "SAWGD0"; )
  )
  if (weapon == 2) (
    if (frame == 0) ( => "PISGA0"; )
    if (frame == 1) ( => "PISGB0"; )
    if (frame == 2) ( => "PISGC0"; )
    if (frame == 3) ( => "PISGD0"; )
    if (frame == 4) ( => "PISGE0"; )
  )
  if (weapon == 3) (
    if (frame == 0) ( => "SHTGA0"; )
    if (frame == 1) ( => "SHTGB0"; )
    if (frame == 2) ( => "SHTGC0"; )
    if (frame == 3) ( => "SHTGD0"; )
  )
  if (weapon == 4) (
    if (frame == 0) ( => "CHGGA0"; )
    if (frame == 1) ( => "CHGGB0"; )
  )
  if (weapon == 5) (
    if (frame == 0) ( => "MISGA0"; )
    if (frame == 1) ( => "MISGB0"; )
  )
  if (weapon == 6) (
    if (frame == 0) ( => "PLSGA0"; )
    if (frame == 1) ( => "PLSGB0"; )
  )
  if (weapon == 7) (
    if (frame == 0) ( => "BFGGA0"; )
    if (frame == 1) ( => "BFGGB0"; )
    if (frame == 2) ( => "BFGGC0"; )
  )
  => "";
)

// The first-person weapon body and its flash are separate Doom psprites.
// Keeping them in distinct immutable atlas ranges lets combat decide exactly
// when a flash exists without synthesizing screen-space fire geometry.
private op doom_texture_muzzle_name [weapon, frame] (
  if ((weapon == 2) and (frame == 0)) ( => "PISFA0"; )
  if (weapon == 3) (
    if (frame == 0) ( => "SHTFA0"; )
    if (frame == 1) ( => "SHTFB0"; )
  )
  if (weapon == 4) (
    if (frame == 0) ( => "CHGFA0"; )
    if (frame == 1) ( => "CHGFB0"; )
  )
  if (weapon == 5) (
    if (frame == 0) ( => "MISFA0"; )
    if (frame == 1) ( => "MISFB0"; )
    if (frame == 2) ( => "MISFC0"; )
    if (frame == 3) ( => "MISFD0"; )
  )
  if (weapon == 6) (
    if (frame == 0) ( => "PLSFA0"; )
    if (frame == 1) ( => "PLSFB0"; )
  )
  if (weapon == 7) (
    if (frame == 0) ( => "BFGFA0"; )
    if (frame == 1) ( => "BFGFB0"; )
  )
  => "";
)

op doom_texture_muzzle_frame_count [weapon] (
  if (weapon == 2) ( => 1; )
  if ((weapon == 3) or (weapon == 4)) ( => 2; )
  if (weapon == 5) ( => 4; )
  if ((weapon == 6) or (weapon == 7)) ( => 2; )
  => 0;
)

private op doom_texture_muzzle_offset [weapon] (
  if (weapon == 2) ( => 0; )
  if (weapon == 3) ( => 1; )
  if (weapon == 4) ( => 3; )
  if (weapon == 5) ( => 5; )
  if (weapon == 6) ( => 9; )
  if (weapon == 7) ( => 11; )
  => 0 - 1;
)

// MISLA publishes the live rocket's eight rotations through four mirrored
// pairs plus the direct front/back witnesses. MISLB-D are its rotation-zero
// impact sequence. The flip bit follows Doom's second-frame convention.
private op doom_texture_rocket_spec [frame, rotation] (
  if (frame == 0) (
    if (rotation == 1) ( => { ok: 1, name: "MISLA1", flip: 0 }; )
    if (rotation == 2) ( => { ok: 1, name: "MISLA8A2", flip: 1 }; )
    if (rotation == 3) ( => { ok: 1, name: "MISLA7A3", flip: 1 }; )
    if (rotation == 4) ( => { ok: 1, name: "MISLA6A4", flip: 1 }; )
    if (rotation == 5) ( => { ok: 1, name: "MISLA5", flip: 0 }; )
    if (rotation == 6) ( => { ok: 1, name: "MISLA6A4", flip: 0 }; )
    if (rotation == 7) ( => { ok: 1, name: "MISLA7A3", flip: 0 }; )
    if (rotation == 8) ( => { ok: 1, name: "MISLA8A2", flip: 0 }; )
  )
  if (frame == 1) ( => { ok: 1, name: "MISLB0", flip: 0 }; )
  if (frame == 2) ( => { ok: 1, name: "MISLC0", flip: 0 }; )
  if (frame == 3) ( => { ok: 1, name: "MISLD0", flip: 0 }; )
  => { ok: 0, name: "", flip: 0 };
)

private op doom_texture_imp_ball_name [frame] (
  if (frame == 0) ( => "BAL1A0"; )
  if (frame == 1) ( => "BAL1B0"; )
  if (frame == 2) ( => "BAL1C0"; )
  if (frame == 3) ( => "BAL1D0"; )
  if (frame == 4) ( => "BAL1E0"; )
  => "";
)

private op doom_texture_caco_ball_name [frame] (
  if (frame == 0) ( => "BAL2A0"; )
  if (frame == 1) ( => "BAL2B0"; )
  if (frame == 2) ( => "BAL2C0"; )
  if (frame == 3) ( => "BAL2D0"; )
  if (frame == 4) ( => "BAL2E0"; )
  => "";
)

private op doom_texture_baron_ball_name [frame] (
  if (frame == 0) ( => "BAL7A1A5"; )
  if (frame == 1) ( => "BAL7C0"; )
  if (frame == 2) ( => "BAL7D0"; )
  if (frame == 3) ( => "BAL7E0"; )
  => "";
)

private op doom_texture_plasma_ball_name [frame] (
  if (frame == 0) ( => "PLSSA0"; )
  if (frame == 1) ( => "PLSSB0"; )
  if (frame == 2) ( => "PLSEA0"; )
  if (frame == 3) ( => "PLSEB0"; )
  if (frame == 4) ( => "PLSEC0"; )
  if (frame == 5) ( => "PLSED0"; )
  if (frame == 6) ( => "PLSEE0"; )
  => "";
)

private op doom_texture_bfg_ball_name [frame] (
  if (frame == 0) ( => "BFS1A0"; )
  if (frame == 1) ( => "BFS1B0"; )
  if (frame == 2) ( => "BFE1A0"; )
  if (frame == 3) ( => "BFE1B0"; )
  if (frame == 4) ( => "BFE1C0"; )
  if (frame == 5) ( => "BFE1D0"; )
  if (frame == 6) ( => "BFE1E0"; )
  if (frame == 7) ( => "BFE1F0"; )
  => "";
)

op doom_texture_weapon_frame_count [weapon] (
  if (weapon == 1) ( => 4; )
  if (weapon == 2) ( => 5; )
  if (weapon == 3) ( => 4; )
  if ((weapon == 4) or (weapon == 5)) ( => 2; )
  if (weapon == 6) ( => 2; )
  if (weapon == 7) ( => 3; )
  => 0;
)

private op doom_texture_weapon_offset [weapon] (
  if (weapon == 1) ( => 0; )
  if (weapon == 2) ( => 4; )
  if (weapon == 3) ( => 9; )
  if (weapon == 4) ( => 13; )
  if (weapon == 5) ( => 15; )
  if (weapon == 6) ( => 17; )
  if (weapon == 7) ( => 19; )
  => 0 - 1;
)

// Each family owns eight directional frame ranges (A..H) and the five-frame
// regular death sequence. Lost Soul's sixth and terminal death frame lives in
// one append-only atlas slot so existing actor, weapon and effect IDs stay
// stable. The following alphabetic frames begin the separate extreme-death
// sequence and must never become the stable corpse. POSS/SPOS deliberately
// leave directional H empty; TROO uses it for pain.
op doom_texture_sprite_family_stride [] ( => 69; )
op doom_texture_sprite_family_slots [] ( => 621; )
op doom_texture_weapon_slots [] ( => 22; )
op doom_texture_pickup_slots [] ( => 34; )
op doom_texture_prop_families [] ( => 41; )
op doom_texture_prop_stride [] ( => 7; )
op doom_texture_prop_slots [] (
  => doom_texture_prop_families[] * doom_texture_prop_stride[];
)
op doom_texture_teleport_frames [] ( => 10; )
op doom_texture_muzzle_slots [] ( => 13; )
op doom_texture_rocket_slots [] ( => 11; )
op doom_texture_imp_ball_slots [] ( => 5; )
op doom_texture_caco_ball_slots [] ( => 5; )
op doom_texture_baron_ball_slots [] ( => 4; )
op doom_texture_plasma_ball_slots [] ( => 7; )
op doom_texture_bfg_ball_slots [] ( => 8; )
op doom_texture_lost_soul_terminal_slot [] ( => 1027; )
op doom_texture_sprite_slots [] ( => 1028; )

// WAD-native status, font and episode-menu patches occupy a separate immutable
// atlas. The old new-game/options/quit/pause art is deliberately absent: the
// menu exposes only the two admitted Episode One maps.
// Slots are stable so the UI renderer never searches strings in the frame loop.
op doom_texture_ui_slots [] ( => 126; )
op doom_texture_ui_status_slot [] ( => 0; )
op doom_texture_ui_face_slot [] ( => 1; )
op doom_texture_ui_face_straight_slot [tier, frame] (
  if ((tier >= 0) and (tier <= 4) and
      (frame >= 0) and (frame <= 2)) () else (
    fall "doom_texture_ui_face_straight_slot: face outside 5x3 atlas";
  )
  let flat = tier * 3 + frame;
  if (flat == 0) ( => doom_texture_ui_face_slot[]; )
  => 99 + flat;
)
op doom_texture_ui_face_ouch_slot [tier] (
  if ((tier >= 0) and (tier <= 4)) () else (
    fall "doom_texture_ui_face_ouch_slot: tier outside 0..4";
  )
  => 114 + tier;
)
op doom_texture_ui_face_dead_slot [] ( => 119; )
op doom_texture_ui_key_slot [colour, skull] (
  if ((colour >= 0) and (colour <= 2) and
      ((skull == 0) or (skull == 1))) () else (
    fall "doom_texture_ui_key_slot: key outside colour/style atlas";
  )
  => 120 + colour + skull * 3;
)
op doom_texture_ui_big_number_slot [digit] (
  if ((digit >= 0) and (digit <= 9)) () else (
    fall "doom_texture_ui_big_number_slot: digit outside 0..9";
  )
  => 2 + digit;
)
op doom_texture_ui_percent_slot [] ( => 12; )
op doom_texture_ui_arms_slot [] ( => 13; )
op doom_texture_ui_gray_number_slot [digit] (
  if ((digit >= 0) and (digit <= 9)) () else (
    fall "doom_texture_ui_gray_number_slot: digit outside 0..9";
  )
  => 14 + digit;
)
op doom_texture_ui_yellow_number_slot [digit] (
  if ((digit >= 0) and (digit <= 9)) () else (
    fall "doom_texture_ui_yellow_number_slot: digit outside 0..9";
  )
  => 24 + digit;
)
op doom_texture_ui_font_slot [codepoint] (
  if ((codepoint >= 33) and (codepoint <= 95)) () else (
    fall "doom_texture_ui_font_slot: codepoint outside 33..95";
  )
  => 34 + codepoint - 33;
)
op doom_texture_ui_logo_slot [] ( => 97; )
op doom_texture_ui_skull1_slot [] ( => 98; )
op doom_texture_ui_skull2_slot [] ( => 99; )

private op doom_texture_ui_name [slot] (
  if (slot == 0) ( => "STBAR"; )
  if (slot == 1) ( => "STFST00"; )
  if ((slot >= 2) and (slot <= 11)) (
    => "STTNUM" + int_to_string[slot - 2];
  )
  if (slot == 12) ( => "STTPRCNT"; )
  if (slot == 13) ( => "STARMS"; )
  if ((slot >= 14) and (slot <= 23)) (
    => "STGNUM" + int_to_string[slot - 14];
  )
  if ((slot >= 24) and (slot <= 33)) (
    => "STYSNUM" + int_to_string[slot - 24];
  )
  if ((slot >= 34) and (slot <= 96)) (
    => "STCFN0" + int_to_string[slot - 34 + 33];
  )
  if (slot == 97) ( => "M_DOOM"; )
  if (slot == 98) ( => "M_SKULL1"; )
  if (slot == 99) ( => "M_SKULL2"; )
  if ((slot >= 100) and (slot <= 113)) (
    let flat = slot - 99;
    => "STFST" + int_to_string[flat / 3] + int_to_string[flat % 3];
  )
  if ((slot >= 114) and (slot <= 118)) (
    => "STFOUCH" + int_to_string[slot - 114];
  )
  if (slot == 119) ( => "STFDEAD0"; )
  if ((slot >= 120) and (slot <= 125)) (
    => "STKEYS" + int_to_string[slot - 120];
  )
  => "";
)

op doom_texture_sprite_directional_slot [family, frame, rotation] (
  if ((family >= 0) and (family < 9) and
      (frame >= 0) and (frame < 8) and
      (rotation >= 1) and (rotation <= 8)) () else (
    fall "doom_texture_sprite_directional_slot: index outside bounded atlas";
  )
  => family * doom_texture_sprite_family_stride[] + frame * 8 + rotation - 1;
)

op doom_texture_sprite_death_slot [family, frame] (
  if ((family >= 0) and (family < 9) and
      (frame >= 0) and
      (frame < doom_texture_sprite_death_frame_count[family])) () else (
    fall "doom_texture_sprite_death_slot: index outside bounded atlas";
  )
  if ((family == 5) and (frame == 5)) (
    => doom_texture_lost_soul_terminal_slot[];
  )
  => family * doom_texture_sprite_family_stride[] + 64 + frame;
)

op doom_texture_weapon_slot [frame] (
  => doom_texture_weapon_slot_for[2, frame];
)

op doom_texture_weapon_slot_for [weapon, frame] (
  let offset = doom_texture_weapon_offset[weapon];
  let count = doom_texture_weapon_frame_count[weapon];
  if ((offset >= 0) and (frame >= 0) and (frame < count)) () else (
    fall "doom_texture_weapon_slot_for: weapon/frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + offset + frame;
)

op doom_texture_pickup_slot [kind] (
  let family = doom_texture_pickup_family[kind];
  if (family >= 0) () else (
    fall "doom_texture_pickup_slot: unsupported pickup kind";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] + family;
)

op doom_texture_prop_slot [kind] (
  => doom_texture_prop_slot_for[kind, 0];
)

op doom_texture_prop_slot_for [kind, frame] (
  let family = doom_texture_prop_family[kind];
  if ((family >= 0) and (family < doom_texture_prop_families[]) and
      (frame >= 0) and
      (frame < doom_texture_prop_frame_count[family])) () else (
    fall "doom_texture_prop_slot_for: unsupported prop/frame";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] +
    family * doom_texture_prop_stride[] + frame;
)

op doom_texture_teleport_slot [frame] (
  if ((frame >= 0) and (frame < doom_texture_teleport_frames[])) () else (
    fall "doom_texture_teleport_slot: frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] + doom_texture_prop_slots[] + frame;
)

op doom_texture_muzzle_slot_for [weapon, frame] (
  let offset = doom_texture_muzzle_offset[weapon];
  let count = doom_texture_muzzle_frame_count[weapon];
  if ((offset >= 0) and (frame >= 0) and (frame < count)) () else (
    fall "doom_texture_muzzle_slot_for: weapon/frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] + doom_texture_prop_slots[] +
    doom_texture_teleport_frames[] + offset + frame;
)

op doom_texture_rocket_slot [frame, rotation] (
  if ((frame >= 0) and (frame <= 3)) () else (
    fall "doom_texture_rocket_slot: frame outside bounded atlas";
  )
  let base = doom_texture_sprite_family_slots[] +
    doom_texture_weapon_slots[] + doom_texture_pickup_slots[] +
    doom_texture_prop_slots[] + doom_texture_teleport_frames[] +
    doom_texture_muzzle_slots[];
  if (frame == 0) (
    if ((rotation >= 1) and (rotation <= 8)) () else (
      fall "doom_texture_rocket_slot: live rotation outside 1..8";
    )
    => base + rotation - 1;
  )
  => base + 8 + frame - 1;
)

op doom_texture_imp_ball_slot [frame] (
  if ((frame >= 0) and (frame < doom_texture_imp_ball_slots[])) () else (
    fall "doom_texture_imp_ball_slot: frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] + doom_texture_prop_slots[] +
    doom_texture_teleport_frames[] + doom_texture_muzzle_slots[] +
    doom_texture_rocket_slots[] + frame;
)

op doom_texture_caco_ball_slot [frame] (
  if ((frame >= 0) and (frame < doom_texture_caco_ball_slots[])) () else (
    fall "doom_texture_caco_ball_slot: frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] + doom_texture_prop_slots[] +
    doom_texture_teleport_frames[] + doom_texture_muzzle_slots[] +
    doom_texture_rocket_slots[] + doom_texture_imp_ball_slots[] + frame;
)

op doom_texture_baron_ball_slot [frame] (
  if ((frame >= 0) and (frame < doom_texture_baron_ball_slots[])) () else (
    fall "doom_texture_baron_ball_slot: frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] + doom_texture_prop_slots[] +
    doom_texture_teleport_frames[] + doom_texture_muzzle_slots[] +
    doom_texture_rocket_slots[] + doom_texture_imp_ball_slots[] +
    doom_texture_caco_ball_slots[] + frame;
)

op doom_texture_plasma_ball_slot [frame] (
  if ((frame >= 0) and (frame < doom_texture_plasma_ball_slots[])) () else (
    fall "doom_texture_plasma_ball_slot: frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] + doom_texture_prop_slots[] +
    doom_texture_teleport_frames[] + doom_texture_muzzle_slots[] +
    doom_texture_rocket_slots[] + doom_texture_imp_ball_slots[] +
    doom_texture_caco_ball_slots[] + doom_texture_baron_ball_slots[] + frame;
)

op doom_texture_bfg_ball_slot [frame] (
  if ((frame >= 0) and (frame < doom_texture_bfg_ball_slots[])) () else (
    fall "doom_texture_bfg_ball_slot: frame outside bounded atlas";
  )
  => doom_texture_sprite_family_slots[] + doom_texture_weapon_slots[] +
    doom_texture_pickup_slots[] + doom_texture_prop_slots[] +
    doom_texture_teleport_frames[] + doom_texture_muzzle_slots[] +
    doom_texture_rocket_slots[] + doom_texture_imp_ball_slots[] +
    doom_texture_caco_ball_slots[] + doom_texture_baron_ball_slots[] +
    doom_texture_plasma_ball_slots[] + frame;
)

private op doom_texture_teleport_name [frame] (
  if (frame == 0) ( => "TFOGA0"; )
  if (frame == 1) ( => "TFOGB0"; )
  if (frame == 2) ( => "TFOGC0"; )
  if (frame == 3) ( => "TFOGD0"; )
  if (frame == 4) ( => "TFOGE0"; )
  if (frame == 5) ( => "TFOGF0"; )
  if (frame == 6) ( => "TFOGG0"; )
  if (frame == 7) ( => "TFOGH0"; )
  if (frame == 8) ( => "TFOGI0"; )
  if (frame == 9) ( => "TFOGJ0"; )
  => "";
)

private op doom_texture_find_lump_between [directory, first, last, name] (
  let i = last - 1;
  while (i > first) (
    if (doom_texture_name_is[directory, i * 16 + 8, name] == 1) ( => i; )
    i = i - 1;
  )
  => 0 - 1;
)

private op doom_texture_sprite_error [message] (
  => {
    ok: 0, error: message, slots: 0, loaded: 0,
    meta: %32[], pixels: bytes_new[0], opaque: bytes_new[0]
  };
)

op doom_texture_validate_sprite_namespace [directory, lump_count] (
  if ((lump_count >= 0) and (lump_count <= 65536) and
      (bytes_len[directory] == lump_count * 16)) () else (
    => { ok: 0, error: "sprite directory length/count disagree",
         first: 0 - 1, last: 0 - 1 };
  )
  let first = doom_texture_find_lump[directory, lump_count, "S_START"];
  let last = doom_texture_find_lump[directory, lump_count, "S_END"];
  if ((first >= 0) and (last > first + 1)) () else (
    => {
      ok: 0, error: "S_START/S_END do not bound a sprite namespace",
      first: first, last: last
    };
  )
  let first_entry = doom_texture_entry[directory, first];
  let last_entry = doom_texture_entry[directory, last];
  if ((first_entry\bytes == 0) and (last_entry\bytes == 0)) () else (
    => { ok: 0, error: "sprite namespace markers are not empty",
         first: first, last: last };
  )
  let ni = first + 1;
  while (ni < last) (
    if (doom_texture_sprite_name_valid_at[directory, ni * 16 + 8] == 1) () else (
      => {
        ok: 0,
        error: "sprite namespace entry ^{ni} has an invalid frame/rotation name",
        first: first, last: last
      };
    )
    ni = ni + 1;
  )
  => { ok: 1, error: "", first: first, last: last };
)

private op doom_texture_load_sprite_patch [path, directory, first, last,
                                           file_bytes, name] (
  let lump = doom_texture_find_lump_between[
    directory, first, last, name
  ];
  if (lump >= 0) () else (
    => { ok: 0, error: "missing sprite ^{name}", data: bytes_new[0] };
  )
  if (doom_texture_sprite_name_valid_at[directory, lump * 16 + 8] == 1) () else (
    => { ok: 0, error: "sprite ^{name} has an invalid frame name",
         data: bytes_new[0] };
  )
  let entry = doom_texture_entry[directory, lump];
  if (doom_texture_entry_fits[entry, file_bytes] == 1) () else (
    => { ok: 0, error: "sprite ^{name} exceeds the current WAD",
         data: bytes_new[0] };
  )
  let data = doom_texture_read_wad[path, entry\offset, entry\bytes];
  if (bytes_len[data] == entry\bytes) () else (
    => { ok: 0, error: "short sprite ^{name} read", data: bytes_new[0] };
  )
  let valid = doom_texture_validate_patch[data];
  if (valid\ok == 1) () else (
    => { ok: 0, error: "invalid sprite ^{name}: ^{valid\error}",
         data: bytes_new[0] };
  )
  => { ok: 1, error: "", data: data };
)

// One canonical interpretation of the fixed sprite atlas. Both the sizing
// pass and the composition pass consume this operation, so a slot can no
// longer drift to a different WAD patch between allocation and drawing.
private op doom_texture_sprite_slot_spec [slot] (
  let spec = { ok: 0, name: "", flip: 0 };
  let actor_end = doom_texture_sprite_family_slots[];
  let weapon_end = actor_end + doom_texture_weapon_slots[];
  let pickup_end = weapon_end + doom_texture_pickup_slots[];
  let prop_end = pickup_end + doom_texture_prop_slots[];
  let teleport_end = prop_end + doom_texture_teleport_frames[];
  let muzzle_end = teleport_end + doom_texture_muzzle_slots[];
  let rocket_end = muzzle_end + doom_texture_rocket_slots[];
  let imp_end = rocket_end + doom_texture_imp_ball_slots[];
  let caco_end = imp_end + doom_texture_caco_ball_slots[];
  let baron_end = caco_end + doom_texture_baron_ball_slots[];
  let plasma_end = baron_end + doom_texture_plasma_ball_slots[];
  let bfg_end = plasma_end + doom_texture_bfg_ball_slots[];
  if ((slot < 0) or (slot >= doom_texture_sprite_slots[])) ( => spec; )
  if (slot < actor_end) (
    let family = slot / doom_texture_sprite_family_stride[];
    let within = slot % doom_texture_sprite_family_stride[];
    if (within < 64) (
      => doom_texture_sprite_spec[
        family, within / 8, within % 8 + 1
      ];
    )
    => doom_texture_sprite_death_spec[family, within - 64];
  )
  if (slot < weapon_end) (
    let relative = slot - actor_end;
    let weapon = 1;
    if (relative >= 19) ( weapon = 7; )
    else if (relative >= 17) ( weapon = 6; )
    else if (relative >= 15) ( weapon = 5; )
    else if (relative >= 13) ( weapon = 4; )
    else if (relative >= 9) ( weapon = 3; )
    else if (relative >= 4) ( weapon = 2; )
    let name = doom_texture_weapon_name[
      weapon, relative - doom_texture_weapon_offset[weapon]
    ];
    if (str_len[name] == 6) ( => { ok: 1, name: name, flip: 0 }; )
    => spec;
  )
  if (slot < pickup_end) (
    let name = doom_texture_pickup_name[slot - weapon_end];
    if (str_len[name] == 6) ( => { ok: 1, name: name, flip: 0 }; )
    => spec;
  )
  if (slot < prop_end) (
    let relative = slot - pickup_end;
    let name = doom_texture_prop_name[
      relative / doom_texture_prop_stride[],
      relative % doom_texture_prop_stride[]
    ];
    if (str_len[name] == 6) ( => { ok: 1, name: name, flip: 0 }; )
    => spec;
  )
  if (slot < teleport_end) (
    let name = doom_texture_teleport_name[slot - prop_end];
    if (str_len[name] == 6) ( => { ok: 1, name: name, flip: 0 }; )
    => spec;
  )
  if (slot < muzzle_end) (
    let relative = slot - teleport_end;
    let weapon = 2;
    if (relative >= 11) ( weapon = 7; )
    else if (relative >= 9) ( weapon = 6; )
    else if (relative >= 5) ( weapon = 5; )
    else if (relative >= 3) ( weapon = 4; )
    else if (relative >= 1) ( weapon = 3; )
    let name = doom_texture_muzzle_name[
      weapon, relative - doom_texture_muzzle_offset[weapon]
    ];
    if (str_len[name] == 6) ( => { ok: 1, name: name, flip: 0 }; )
    => spec;
  )
  if (slot < rocket_end) (
    let relative = slot - muzzle_end;
    let frame = 0;
    let rotation = relative + 1;
    if (relative >= 8) (
      frame = relative - 7;
      rotation = 1;
    )
    => doom_texture_rocket_spec[frame, rotation];
  )
  let frame = 0;
  let name = "";
  if (slot < imp_end) (
    frame = slot - rocket_end;
    name = doom_texture_imp_ball_name[frame];
  ) else if (slot < caco_end) (
    frame = slot - imp_end;
    name = doom_texture_caco_ball_name[frame];
  ) else if (slot < baron_end) (
    frame = slot - caco_end;
    name = doom_texture_baron_ball_name[frame];
  ) else if (slot < plasma_end) (
    frame = slot - baron_end;
    name = doom_texture_plasma_ball_name[frame];
  ) else if (slot < bfg_end) (
    frame = slot - plasma_end;
    name = doom_texture_bfg_ball_name[frame];
  ) else (
    => doom_texture_sprite_death_spec[5, 5];
  )
  if (str_len[name] > 0) ( => { ok: 1, name: name, flip: 0 }; )
  => spec;
)

private op doom_texture_load_sprites [path, directory, lump_count,
                                      file_bytes, map] (
  let namespace = doom_texture_validate_sprite_namespace[
    directory, lump_count
  ];
  if (namespace\ok == 1) () else (
    => doom_texture_sprite_error[namespace\error];
  )
  let first = namespace\first;
  let last = namespace\last;

  let needed = bytes_new[9];
  let needed_pickups = bytes_new[doom_texture_pickup_slots[]];
  let needed_props = bytes_new[doom_texture_prop_families[]];
  let needed_teleport = 0;
  let ti = 0;
  while (ti < map\thing_count) (
    let family = doom_texture_sprite_family[
      buf_get[map\things, ti * 4 + 2]
    ];
    if (family >= 0) (
      bytes_set[needed, family, 1];
      if (family == 0) ( bytes_set[needed_pickups, 0, 1]; )
      if (family == 1) ( bytes_set[needed_pickups, 8, 1]; )
    )
    let pickup = doom_texture_pickup_family[
      buf_get[map\things, ti * 4 + 2]
    ];
    if (pickup >= 0) ( bytes_set[needed_pickups, pickup, 1]; )
    let prop = doom_texture_prop_family[
      buf_get[map\things, ti * 4 + 2]
    ];
    if (prop >= 0) ( bytes_set[needed_props, prop, 1]; )
    ti = ti + 1;
  )
  // Every combat map adds a synthetic laser entrance pickup. Admit its reused
  // WAD witness even though no caller WAD THING can carry the out-of-band
  // synthetic kind. The shield is a code-native bracelet and needs no lump.
  bytes_set[
    needed_pickups,
    doom_texture_pickup_family[doom_laser_pickup_kind[]], 1
  ];
  let li = 0;
  while (li < map\line_count) (
    let special = buf_get[map\line_actions, li * 2];
    if ((special == 39) or (special == 97)) ( needed_teleport = 1; )
    li = li + 1;
  )

  // Nine fixed family ranges hold directional/action views plus five sampled
  // regular-death frames; the first-person weapon frames follow.
  // Metadata is width, height, atlas offset, left offset, top offset and flip.
  let slots = doom_texture_sprite_slots[];
  let required = bytes_new[slots];
  let meta = buf_new[32, slots * 6];

  // Translate map/game policy into a fixed set of atlas slots. The following
  // sizing and composition passes then share one slot-to-patch authority.
  let family = 0;
  while (family < 9) (
    if (bytes_get[needed, family] == 1) (
      let frame = 0;
      while (frame < doom_texture_sprite_frame_count[family]) (
        let rotation = 1;
        while (rotation <= 8) (
          bytes_set[
            required,
            doom_texture_sprite_directional_slot[family, frame, rotation],
            1
          ];
          rotation = rotation + 1;
        )
        frame = frame + 1;
      )
      let death = 0;
      while (death < doom_texture_sprite_death_frame_count[family]) (
        bytes_set[
          required, doom_texture_sprite_death_slot[family, death], 1
        ];
        death = death + 1;
      )
    )
    family = family + 1;
  )
  // Only load the seven WAD-native weapon families. Modular weapons reuse a
  // declared source family (the laser uses the plasma-rifle slots).
  let weapon = 1;
  while (weapon <= 7) (
    let frame = 0;
    while (frame < doom_texture_weapon_frame_count[weapon]) (
      bytes_set[required, doom_texture_weapon_slot_for[weapon, frame], 1];
      frame = frame + 1;
    )
    weapon = weapon + 1;
  )
  let pickup = 0;
  while (pickup < doom_texture_pickup_slots[]) (
    if (bytes_get[needed_pickups, pickup] == 1) (
      let slot = doom_texture_sprite_family_slots[] +
        doom_texture_weapon_slots[] + pickup;
      bytes_set[required, slot, 1];
    )
    pickup = pickup + 1;
  )
  let prop = 0;
  while (prop < doom_texture_prop_families[]) (
    if (bytes_get[needed_props, prop] == 1) (
      let frame = 0;
      while (frame < doom_texture_prop_frame_count[prop]) (
        let slot = doom_texture_sprite_family_slots[] +
          doom_texture_weapon_slots[] + doom_texture_pickup_slots[] +
          prop * doom_texture_prop_stride[] + frame;
        bytes_set[required, slot, 1];
        frame = frame + 1;
      )
    )
    prop = prop + 1;
  )
  if (needed_teleport == 1) (
    let frame = 0;
    while (frame < doom_texture_teleport_frames[]) (
      bytes_set[required, doom_texture_teleport_slot[frame], 1];
      frame = frame + 1;
    )
  )
  // Muzzle art follows the same source-family rule as weapon body art.
  weapon = 2;
  while (weapon <= 7) (
    let frame = 0;
    while (frame < doom_texture_muzzle_frame_count[weapon]) (
      bytes_set[required, doom_texture_muzzle_slot_for[weapon, frame], 1];
      frame = frame + 1;
    )
    weapon = weapon + 1;
  )
  let rocket_frame = 0;
  while (rocket_frame <= 3) (
    let rotation = 1;
    let last_rotation = 8;
    if (rocket_frame > 0) ( last_rotation = 1; )
    while (rotation <= last_rotation) (
      bytes_set[
        required, doom_texture_rocket_slot[rocket_frame, rotation], 1
      ];
      rotation = rotation + 1;
    )
    rocket_frame = rocket_frame + 1;
  )
  if (bytes_get[needed, 2] == 1) (
    let frame = 0;
    while (frame < doom_texture_imp_ball_slots[]) (
      bytes_set[required, doom_texture_imp_ball_slot[frame], 1];
      frame = frame + 1;
    )
  )
  if (bytes_get[needed, 4] == 1) (
    let frame = 0;
    while (frame < doom_texture_caco_ball_slots[]) (
      bytes_set[required, doom_texture_caco_ball_slot[frame], 1];
      frame = frame + 1;
    )
  )
  if (bytes_get[needed, 6] == 1) (
    let frame = 0;
    while (frame < doom_texture_baron_ball_slots[]) (
      bytes_set[required, doom_texture_baron_ball_slot[frame], 1];
      frame = frame + 1;
    )
  )
  let frame = 0;
  while (frame < doom_texture_plasma_ball_slots[]) (
    bytes_set[required, doom_texture_plasma_ball_slot[frame], 1];
    frame = frame + 1;
  )
  frame = 0;
  while (frame < doom_texture_bfg_ball_slots[]) (
    bytes_set[required, doom_texture_bfg_ball_slot[frame], 1];
    frame = frame + 1;
  )

  let texels = 0;
  let loaded = 0;
  let slot = 0;
  while (slot < slots) (
    if (bytes_get[required, slot] == 1) (
      let spec = doom_texture_sprite_slot_spec[slot];
      if (spec\ok == 1) () else (
        => doom_texture_sprite_error["invalid required sprite atlas slot"];
      )
      let patch = doom_texture_load_sprite_patch[
        path, directory, first, last, file_bytes, spec\name
      ];
      if (patch\ok == 1) () else (
        => doom_texture_sprite_error[patch\error];
      )
      let width = doom_wad_u16le[patch\data, 0];
      let height = doom_wad_u16le[patch\data, 2];
      if (width * height <= 8388608 - texels) () else (
        => doom_texture_sprite_error["sprite atlas exceeds 8 MiB"];
      )
      let mb = slot * 6;
      buf_set[meta, mb, width];
      buf_set[meta, mb + 1, height];
      buf_set[meta, mb + 2, texels];
      buf_set[meta, mb + 3, doom_texture_s16[patch\data, 4]];
      buf_set[meta, mb + 4, doom_texture_s16[patch\data, 6]];
      buf_set[meta, mb + 5, spec\flip];
      texels = texels + width * height;
      loaded = loaded + 1;
    )
    slot = slot + 1;
  )
  let pixels = bytes_new[texels];
  let opaque = bytes_new[texels];
  doom_texture_zero[pixels];
  doom_texture_zero[opaque];
  slot = 0;
  while (slot < slots) (
    let mb = slot * 6;
    let width = buf_get[meta, mb];
    if (width > 0) (
      let spec = doom_texture_sprite_slot_spec[slot];
      if (spec\ok == 1) () else (
        => doom_texture_sprite_error["invalid populated sprite atlas slot"];
      )
      let patch = doom_texture_load_sprite_patch[
        path, directory, first, last, file_bytes, spec\name
      ];
      if (patch\ok == 1) () else (
        => doom_texture_sprite_error[patch\error];
      )
      let composed = doom_texture_compose_patch[
        pixels, opaque, buf_get[meta, mb + 2],
        width, buf_get[meta, mb + 1], patch\data, 0, 0
      ];
      if (composed\ok == 1) () else (
        => doom_texture_sprite_error[
          "sprite ^{spec\name} composition failed: ^{composed\error}"
        ];
      )
    )
    slot = slot + 1;
  )
  => {
    ok: 1, error: "", slots: slots, loaded: loaded,
    meta: meta, pixels: pixels, opaque: opaque
  };
)

private op doom_texture_zero [b] (
  let i = 0;
  while (i < bytes_len[b]) (
    bytes_set[b, i, 0];
    i = i + 1;
  )
  => 0;
)

private op doom_texture_compact_find [names, count, source, source_offset] (
  let i = 0;
  while (i < count) (
    if (doom_texture_name_equal[names, i * 8, source, source_offset] == 1) (
      => i;
    )
    i = i + 1;
  )
  => 0 - 1;
)

private op doom_texture_copy_prefix [source, count] (
  let out = bytes_new[count];
  let i = 0;
  while (i < count) (
    bytes_set[out, i, bytes_get[source, i]];
    i = i + 1;
  )
  => out;
)

private op doom_texture_copy_meta [source, count] (
  let out = buf_new[32, count];
  let i = 0;
  while (i < count) (
    buf_set[out, i, buf_get[source, i]];
    i = i + 1;
  )
  => out;
)

private op doom_texture_load_named [path, directory, lump_count, file_bytes,
                                    name, name_offset] (
  let lump = doom_texture_find_lump_raw[
    directory, lump_count, name, name_offset
  ];
  if (lump >= 0) () else (
    => { ok: 0, error: "named lump is absent", data: bytes_new[0] };
  )
  let entry = doom_texture_entry[directory, lump];
  if (doom_texture_entry_fits[entry, file_bytes] == 1) () else (
    => { ok: 0, error: "named lump exceeds the current WAD", data: bytes_new[0] };
  )
  let data = doom_texture_read_wad[path, entry\offset, entry\bytes];
  if (bytes_len[data] == entry\bytes) () else (
    => { ok: 0, error: "short named lump read", data: bytes_new[0] };
  )
  => { ok: 1, error: "", data: data };
)

private op doom_texture_load_catalog_lump [path, directory, lump_count,
                                           file_bytes, name, required] (
  let lump = doom_texture_find_lump[directory, lump_count, name];
  if (lump >= 0) () else (
    if (required == 1) (
      => { ok: 0, error: "missing ^{name}", index: 0 - 1,
           data: bytes_new[0] };
    )
    => { ok: 1, error: "", index: 0 - 1, data: bytes_new[0] };
  )
  let entry = doom_texture_entry[directory, lump];
  if (doom_texture_entry_fits[entry, file_bytes] == 1) () else (
    => { ok: 0, error: "^{name} exceeds the current WAD", index: lump,
         data: bytes_new[0] };
  )
  let data = doom_texture_read_wad[path, entry\offset, entry\bytes];
  if (bytes_len[data] == entry\bytes) () else (
    => { ok: 0, error: "short ^{name} read", index: lump,
         data: bytes_new[0] };
  )
  => { ok: 1, error: "", index: lump, data: data };
)

private op doom_texture_ui_error [message] (
  => {
    ok: 0, error: message, slots: 0,
    meta: %32[], pixels: bytes_new[0], opaque: bytes_new[0]
  };
)

private op doom_texture_load_ui_patch [path, directory, lump_count,
                                       file_bytes, name] (
  let loaded = doom_texture_load_catalog_lump[
    path, directory, lump_count, file_bytes, name, 1
  ];
  if (loaded\ok == 1) () else (
    => { ok: 0, error: loaded\error, data: bytes_new[0] };
  )
  let valid = doom_texture_validate_patch[loaded\data];
  if (valid\ok == 1) () else (
    => { ok: 0, error: "invalid UI patch ^{name}: ^{valid\error}",
         data: bytes_new[0] };
  )
  => { ok: 1, error: "", data: loaded\data };
)

private op doom_texture_load_ui [path, directory, lump_count, file_bytes] (
  let slots = doom_texture_ui_slots[];
  let meta = buf_new[32, slots * 5];
  let texels = 0;
  let slot = 0;
  while (slot < slots) (
    let name = doom_texture_ui_name[slot];
    if ((str_len[name] > 0) and (str_len[name] <= 8)) () else (
      => doom_texture_ui_error["invalid UI slot name"];
    )
    let patch = doom_texture_load_ui_patch[
      path, directory, lump_count, file_bytes, name
    ];
    if (patch\ok == 1) () else ( => doom_texture_ui_error[patch\error]; )
    let width = doom_wad_u16le[patch\data, 0];
    let height = doom_wad_u16le[patch\data, 2];
    if (width * height <= 2097152 - texels) () else (
      => doom_texture_ui_error["UI atlas exceeds 2 MiB"];
    )
    let mb = slot * 5;
    buf_set[meta, mb, width];
    buf_set[meta, mb + 1, height];
    buf_set[meta, mb + 2, texels];
    buf_set[meta, mb + 3, doom_texture_s16[patch\data, 4]];
    buf_set[meta, mb + 4, doom_texture_s16[patch\data, 6]];
    texels = texels + width * height;
    slot = slot + 1;
  )

  let pixels = bytes_new[texels];
  let opaque = bytes_new[texels];
  doom_texture_zero[pixels];
  doom_texture_zero[opaque];
  slot = 0;
  while (slot < slots) (
    let name = doom_texture_ui_name[slot];
    let patch = doom_texture_load_ui_patch[
      path, directory, lump_count, file_bytes, name
    ];
    if (patch\ok == 1) () else ( => doom_texture_ui_error[patch\error]; )
    let mb = slot * 5;
    let composed = doom_texture_compose_patch[
      pixels, opaque, buf_get[meta, mb + 2],
      buf_get[meta, mb], buf_get[meta, mb + 1], patch\data, 0, 0
    ];
    if (composed\ok == 1) () else (
      => doom_texture_ui_error["UI patch ^{name} composition failed"];
    )
    slot = slot + 1;
  )
  => { ok: 1, error: "", slots: slots,
       meta: meta, pixels: pixels, opaque: opaque };
)

private op doom_texture_flat_error [message] (
  => {
    ok: 0, error: message, count: 0, names: bytes_new[0],
    pixels: bytes_new[0], sky: 0 - 1
  };
)

// Sector-flat discovery and loading is one cold, independently checked
// catalog stage. It mutates only the map's validated name-to-slot table.
private op doom_texture_load_flats [path, directory, lump_count,
                                    file_bytes, map] (
  let first = doom_texture_find_lump[directory, lump_count, "F_START"];
  let last = doom_texture_find_lump[directory, lump_count, "F_END"];
  if ((first >= 0) and (last > first)) () else (
    => doom_texture_flat_error[
      "F_START/F_END do not bound a flat namespace"
    ];
  )
  let maximum = map\sector_count * 2;
  let scratch_names = bytes_new[maximum * 8];
  doom_texture_zero[scratch_names];
  let count = 0;
  let slot = 0;
  while (slot < maximum) (
    buf_set[map\sector_flats, slot, 0 - 1];
    let name_offset = slot * 8;
    if (doom_texture_name_valid_at[map\sector_names, name_offset] == 1) ()
    else (
      => doom_texture_flat_error[
        "SECTORS flat slot ^{slot} is not a canonical WAD name"
      ];
    )
    let flat = doom_texture_compact_find[
      scratch_names, count, map\sector_names, name_offset
    ];
    if (flat < 0) (
      if (count < 2048) () else (
        => doom_texture_flat_error["map requires more than 2048 flats"];
      )
      let lump = doom_texture_find_lump_raw[
        directory, lump_count, map\sector_names, name_offset
      ];
      if ((lump > first) and (lump < last)) () else (
        => doom_texture_flat_error[
          "SECTORS references a flat outside F_START/F_END"
        ];
      )
      let entry = doom_texture_entry[directory, lump];
      if ((doom_texture_entry_fits[entry, file_bytes] == 1) and
          (entry\bytes == 4096)) () else (
        => doom_texture_flat_error[
          "sector flat is not one bounded 64x64 span"
        ];
      )
      flat = count;
      doom_texture_name_copy[
        map\sector_names, name_offset, scratch_names, flat * 8
      ];
      count = count + 1;
    )
    buf_set[map\sector_flats, slot, flat];
    slot = slot + 1;
  )
  if (count * 4096 <= 8388608) () else (
    => doom_texture_flat_error["map flat atlas exceeds 8 MiB"];
  )
  let names = doom_texture_copy_prefix[scratch_names, count * 8];
  let pixels = bytes_new[count * 4096];
  let sky = 0 - 1;
  let flat = 0;
  while (flat < count) (
    let lump = doom_texture_find_lump_raw[
      directory, lump_count, names, flat * 8
    ];
    let entry = doom_texture_entry[directory, lump];
    let data = doom_texture_read_wad[path, entry\offset, 4096];
    if (bytes_len[data] == 4096) () else (
      => doom_texture_flat_error["short sector flat read"];
    )
    let i = 0;
    while (i < 4096) (
      bytes_set[pixels, flat * 4096 + i, bytes_get[data, i]];
      i = i + 1;
    )
    if (doom_texture_name_is[names, flat * 8, "F_SKY1"] == 1) (
      sky = flat;
    )
    flat = flat + 1;
  )
  => {
    ok: 1, error: "", count: count, names: names,
    pixels: pixels, sky: sky
  };
)

private op doom_texture_colour_error [message] (
  => {
    ok: 0, error: message, palette: bytes_new[0],
    colormap: bytes_new[0], colours: %32[], rgbx: %32[]
  };
)

private op doom_texture_load_colours [path, directory, lump_count,
                                      file_bytes] (
  let palette_lump = doom_texture_load_catalog_lump[
    path, directory, lump_count, file_bytes, "PLAYPAL", 1
  ];
  if (palette_lump\ok == 1) () else (
    => doom_texture_colour_error[palette_lump\error];
  )
  if ((bytes_len[palette_lump\data] >= 768) and
      (bytes_len[palette_lump\data] <= 10752) and
      (bytes_len[palette_lump\data] % 768 == 0)) () else (
    => doom_texture_colour_error[
      "PLAYPAL is not 1..14 complete palettes"
    ];
  )
  let palette = doom_texture_copy_prefix[palette_lump\data, 768];
  let colormap_lump = doom_texture_load_catalog_lump[
    path, directory, lump_count, file_bytes, "COLORMAP", 1
  ];
  if (colormap_lump\ok == 1) () else (
    => doom_texture_colour_error[colormap_lump\error];
  )
  if ((bytes_len[colormap_lump\data] >= 8192) and
      (bytes_len[colormap_lump\data] <= 16384) and
      (bytes_len[colormap_lump\data] % 256 == 0)) () else (
    => doom_texture_colour_error[
      "COLORMAP does not contain 32 bounded maps"
    ];
  )
  let colormap = doom_texture_copy_prefix[colormap_lump\data, 8192];
  let colours = buf_new[32, 8192];
  let rgbx = buf_new[32, 8192];
  let shade = 0;
  while (shade < 32) (
    let colour = 0;
    while (colour < 256) (
      let mapped = bytes_get[colormap, shade * 256 + colour];
      let offset = mapped * 3;
      let red = bytes_get[palette, offset];
      let green = bytes_get[palette, offset + 1];
      let blue = bytes_get[palette, offset + 2];
      buf_set[
        colours, shade * 256 + colour,
        red * 65536 + green * 256 + blue
      ];
      // GUI buffers are RGBA bytes, hence little-endian 0x00BBGGRR.
      buf_set[
        rgbx, shade * 256 + colour,
        red + green * 256 + blue * 65536
      ];
      colour = colour + 1;
    )
    shade = shade + 1;
  )
  => {
    ok: 1, error: "", palette: palette, colormap: colormap,
    colours: colours, rgbx: rgbx
  };
)

// This is the cold-load asset pipeline. It validates the effective catalog
// lumps, computes bounded atlas sizes before allocation, composes indexed
// pixels once, then binds map side/sector names to immutable atlas slots. The
// source is one measured WAD owner; the per-frame renderer therefore performs
// no filesystem access or patch parsing.  `complete` admits the sprite/UI
// catalogs used by the native game.  The first browser frame deliberately
// selects the world-only bank, which proves walls, flats and colour tables
// without requiring unrelated status/weapon art from a synthetic oracle WAD.
private op doom_texture_load_bank_mode [path, directory, lump_count,
                                        file_bytes, map, complete] (
  let colour_bank = doom_texture_load_colours[
    path, directory, lump_count, file_bytes
  ];
  if (colour_bank\ok == 1) () else (
    => doom_texture_bank_error[colour_bank\error];
  )
  let palette = colour_bank\palette;
  let colormap = colour_bank\colormap;
  let colours = colour_bank\colours;
  let rgbx_colours = colour_bank\rgbx;
  let pnames_lump = doom_texture_load_catalog_lump[
    path, directory, lump_count, file_bytes, "PNAMES", 1
  ];
  if (pnames_lump\ok == 1) () else (
    => doom_texture_bank_error[pnames_lump\error];
  )
  let pnames_result = doom_texture_parse_pnames[pnames_lump\data];
  if (pnames_result\ok == 1) () else (
    => doom_texture_bank_error[pnames_result\error];
  )

  let texture1_lump = doom_texture_load_catalog_lump[
    path, directory, lump_count, file_bytes, "TEXTURE1", 1
  ];
  if (texture1_lump\ok == 1) () else (
    => doom_texture_bank_error[texture1_lump\error];
  )
  let texture2_lump = doom_texture_load_catalog_lump[
    path, directory, lump_count, file_bytes, "TEXTURE2", 0
  ];
  if (texture2_lump\ok == 1) () else (
    => doom_texture_bank_error[texture2_lump\error];
  )
  let defs1 = doom_texture_validate_definitions[
    "TEXTURE1", texture1_lump\data, pnames_result\count
  ];
  if (defs1\ok == 1) () else ( => doom_texture_bank_error[defs1\error]; )
  if (texture2_lump\index >= 0) (
    let defs2 = doom_texture_validate_definitions[
      "TEXTURE2", texture2_lump\data, pnames_result\count
    ];
    if (defs2\ok == 1) () else ( => doom_texture_bank_error[defs2\error]; )
  )

  // Wall slots are map-driven. Each referenced SW1/SW2 definition may admit
  // one partner, plus one bounded panoramic texture when the map names SKY.
  let map_texture_slots = map\side_count * 3;
  let maximum_textures = map_texture_slots * 2 + 1;
  let scratch_names = bytes_new[maximum_textures * 8];
  doom_texture_zero[scratch_names];
  let scratch_meta = buf_new[32, maximum_textures * 3];
  let texture_count = 0;
  let texels = 0;
  let slot = 0;
  while (slot < map_texture_slots) (
    buf_set[map\side_textures, slot, 0 - 1];
    let name_offset = slot * 8;
    if (doom_texture_name_is[map\side_names, name_offset, "-"] == 0) (
      if (doom_texture_name_valid_at[map\side_names, name_offset] == 1) () else (
        => doom_texture_bank_error[
          "SIDEDEFS texture slot ^{slot} is not a canonical WAD name"
        ];
      )
      let texture = doom_texture_compact_find[
        scratch_names, texture_count, map\side_names, name_offset
      ];
      if (texture < 0) (
        let definition = doom_texture_find_definition[
          texture1_lump\data, texture1_lump\index,
          texture2_lump\data, texture2_lump\index,
          map\side_names, name_offset
        ];
        if (definition\found == 1) () else (
          => doom_texture_bank_error["SIDEDEFS references an absent wall texture"];
        )
        if (texture_count < 2048) () else (
          => doom_texture_bank_error["map requires more than 2048 wall textures"];
        )
        if (definition\width * definition\height <= 8388608 - texels) () else (
          => doom_texture_bank_error["map wall atlas exceeds 8 MiB"];
        )
        texture = texture_count;
        doom_texture_name_copy[
          map\side_names, name_offset, scratch_names, texture * 8
        ];
        buf_set[scratch_meta, texture * 3, definition\width];
        buf_set[scratch_meta, texture * 3 + 1, definition\height];
        buf_set[scratch_meta, texture * 3 + 2, texels];
        texels = texels + definition\width * definition\height;
        texture_count = texture_count + 1;
      )
      buf_set[map\side_textures, slot, texture];

      // Classic switch state lives in the alternate wall definition even
      // when the current map references only one half of the pair.
      let switch_name = bytes_new[8];
      doom_texture_zero[switch_name];
      if (doom_texture_switch_name_into[
            map\side_names, name_offset, switch_name
          ] == 1) (
        let partner = doom_texture_compact_find[
          scratch_names, texture_count, switch_name, 0
        ];
        if (partner < 0) (
          let partner_definition = doom_texture_find_definition[
            texture1_lump\data, texture1_lump\index,
            texture2_lump\data, texture2_lump\index,
            switch_name, 0
          ];
          // A custom WAD may deliberately provide a one-state SW* texture.
          // Keep it renderable; it simply has no admitted flip partner.
          if (partner_definition\found == 1) (
            if ((texture_count < maximum_textures) and
                (texture_count < 2048)) () else (
              => doom_texture_bank_error[
                "map switch pairs exceed the bounded wall catalog"
              ];
            )
            if (partner_definition\width * partner_definition\height <=
                8388608 - texels) () else (
              => doom_texture_bank_error[
                "map switch pairs exceed the bounded wall atlas"
              ];
            )
            partner = texture_count;
            doom_texture_name_copy[
              switch_name, 0, scratch_names, partner * 8
            ];
            buf_set[scratch_meta, partner * 3, partner_definition\width];
            buf_set[scratch_meta, partner * 3 + 1, partner_definition\height];
            buf_set[scratch_meta, partner * 3 + 2, texels];
            texels = texels +
              partner_definition\width * partner_definition\height;
            texture_count = texture_count + 1;
          )
        )
      )
    )
    slot = slot + 1;
  )

  let sky_texture = 0 - 1;
  let has_sky = 0;
  slot = 0;
  while (slot < map\sector_count * 2) (
    if (doom_texture_name_is[map\sector_names, slot * 8, "F_SKY1"] == 1) (
      has_sky = 1;
    )
    slot = slot + 1;
  )
  if (has_sky == 1) (
    let sky_name = bytes_new[8];
    doom_texture_zero[sky_name];
    bytes_set[sky_name, 0, 83];
    bytes_set[sky_name, 1, 75];
    bytes_set[sky_name, 2, 89];
    bytes_set[sky_name, 3, 49];
    sky_texture = doom_texture_compact_find[
      scratch_names, texture_count, sky_name, 0
    ];
    if (sky_texture < 0) (
      let definition = doom_texture_find_definition[
        texture1_lump\data, texture1_lump\index,
        texture2_lump\data, texture2_lump\index,
        sky_name, 0
      ];
      if (definition\found == 1) () else (
        => doom_texture_bank_error["F_SKY1 requires the SKY1 wall texture"];
      )
      if (definition\width * definition\height <= 8388608 - texels) () else (
        => doom_texture_bank_error["SKY1 exceeds the bounded wall atlas"];
      )
      sky_texture = texture_count;
      doom_texture_name_copy[sky_name, 0, scratch_names, sky_texture * 8];
      buf_set[scratch_meta, sky_texture * 3, definition\width];
      buf_set[scratch_meta, sky_texture * 3 + 1, definition\height];
      buf_set[scratch_meta, sky_texture * 3 + 2, texels];
      texels = texels + definition\width * definition\height;
      texture_count = texture_count + 1;
    )
  )

  let texture_names = doom_texture_copy_prefix[
    scratch_names, texture_count * 8
  ];
  let texture_meta = doom_texture_copy_meta[scratch_meta, texture_count * 3];
  let texture_pixels = bytes_new[texels];
  let texture_opaque = bytes_new[texels];
  doom_texture_zero[texture_pixels];
  doom_texture_zero[texture_opaque];

  let ti = 0;
  while (ti < texture_count) (
    let definition = doom_texture_find_definition[
      texture1_lump\data, texture1_lump\index,
      texture2_lump\data, texture2_lump\index,
      texture_names, ti * 8
    ];
    let definitions = texture1_lump\data;
    if (definition\source == 2) ( definitions = texture2_lump\data; )
    let p = 0;
    while (p < definition\patches) (
      let po = definition\offset + 22 + p * 10;
      let origin_x = doom_texture_s16[definitions, po];
      let origin_y = doom_texture_s16[definitions, po + 2];
      let patch_number = doom_wad_u16le[definitions, po + 4];
      let patch_name_offset = 4 + patch_number * 8;
      let loaded = doom_texture_load_named[
        path, directory, lump_count, file_bytes,
        pnames_lump\data, patch_name_offset
      ];
      if (loaded\ok == 1) () else (
        => doom_texture_bank_error[
          "wall texture patch is absent or unreadable"
        ];
      )
      let valid_patch = doom_texture_validate_patch[loaded\data];
      if (valid_patch\ok == 1) () else (
        => doom_texture_bank_error[
          "invalid patch in wall texture: ^{valid_patch\error}"
        ];
      )
      doom_texture_compose_patch[
        texture_pixels, texture_opaque,
        buf_get[texture_meta, ti * 3 + 2],
        buf_get[texture_meta, ti * 3],
        buf_get[texture_meta, ti * 3 + 1],
        loaded\data, origin_x, origin_y
      ];
      p = p + 1;
    )
    ti = ti + 1;
  )

  let flats = doom_texture_load_flats[
    path, directory, lump_count, file_bytes, map
  ];
  if (flats\ok == 1) () else (
    => doom_texture_bank_error[flats\error];
  )
  let flat_count = flats\count;
  let flat_names = flats\names;
  let flat_pixels = flats\pixels;
  let sky_flat = flats\sky;
  let sprites = {
    ok: 1, error: "", slots: 0, loaded: 0,
    meta: %32[], pixels: bytes_new[0], opaque: bytes_new[0]
  };
  let ui = {
    ok: 1, error: "", slots: 0,
    meta: %32[], pixels: bytes_new[0], opaque: bytes_new[0]
  };
  if (complete == 1) (
    sprites = doom_texture_load_sprites[
      path, directory, lump_count, file_bytes, map
    ];
    if (sprites\ok == 1) () else (
      => doom_texture_bank_error[sprites\error];
    )
    ui = doom_texture_load_ui[
      path, directory, lump_count, file_bytes
    ];
    if (ui\ok == 1) () else (
      => doom_texture_bank_error[ui\error];
    )
  )

  => {
    ready: 1, error: "", texture_count: texture_count,
    texture_names: texture_names, texture_meta: texture_meta,
    texture_pixels: texture_pixels, texture_opaque: texture_opaque,
    flat_count: flat_count, flat_names: flat_names,
    flat_pixels: flat_pixels, sky_flat: sky_flat, sky_texture: sky_texture,
    sprite_ready: complete, sprite_slots: sprites\slots,
    sprite_loaded: sprites\loaded, sprite_meta: sprites\meta,
    sprite_pixels: sprites\pixels, sprite_opaque: sprites\opaque,
    ui_ready: complete, ui_slots: ui\slots, ui_meta: ui\meta,
    ui_pixels: ui\pixels, ui_opaque: ui\opaque,
    palette: palette, colormap: colormap,
    colours: colours, rgbx_colours: rgbx_colours
  };
)

op doom_texture_load_bank [wad, directory, lump_count, file_bytes, map] (
  => doom_texture_load_bank_mode[
    wad, directory, lump_count, file_bytes, map, 1
  ];
)

op doom_texture_colour [bank, palette_index, light] (
  let level = (255 - light) / 8;
  if (level < 0) ( level = 0; )
  if (level > 31) ( level = 31; )
  => buf_get[bank\colours, level * 256 + palette_index];
)

// Texture loading is intentionally separate from doom_map_load: the automap
// keeps its geometry-only cost, while the first-person application explicitly
// asks for the asset authority it uses.  Parsing below is authority-free: one
// measured bytes owner supplies every checked directory/lump slice.
private op doom_texture_load_map_bytes_mode [wad, map, complete] (
  if (map\ok == 1) () else ( => map; )
  if (is_bytes[wad] == 1) () else (
    => map + { ok: 0, error: "textures: WAD source is not bytes" };
  )
  let file_bytes = bytes_len[wad];
  let header = doom_texture_read_wad[wad, 0, 12];
  if (bytes_len[header] == 12) () else (
    => map + { ok: 0, error: "textures: short WAD header read" };
  )
  if (((bytes_get[header, 0] == 73) or (bytes_get[header, 0] == 80)) and
      (bytes_get[header, 1] == 87) and (bytes_get[header, 2] == 65) and
      (bytes_get[header, 3] == 68)) () else (
    => map + { ok: 0, error: "textures: bad WAD magic" };
  )
  let lump_count = doom_wad_u32le[header, 4];
  let directory_offset = doom_wad_u32le[header, 8];
  if ((file_bytes >= 12) and (lump_count <= 65536)) () else (
    => map + { ok: 0, error: "textures: invalid WAD size or lump count" };
  )
  let directory_bytes = lump_count * 16;
  if ((directory_offset <= file_bytes) and
      (directory_bytes <= file_bytes - directory_offset)) () else (
    => map + { ok: 0, error: "textures: WAD directory exceeds the file" };
  )
  let directory = doom_texture_read_wad[
    wad, directory_offset, directory_bytes
  ];
  if (bytes_len[directory] == directory_bytes) () else (
    => map + { ok: 0, error: "textures: short WAD directory read" };
  )
  let bank = doom_texture_load_bank_mode[
    wad, directory, lump_count, file_bytes, map, complete
  ];
  if (bank\ready == 1) () else (
    => map + {
      ok: 0, error: "textures: ^{bank\error}", texture_bank: bank
    };
  )
  => map + { texture_bank: bank };
)

// Complete native/browser asset bank, including sprites and UI art.
op doom_texture_load_map_bytes [wad, map] (
  => doom_texture_load_map_bytes_mode[wad, map, 1];
)

// World-only first-frame bank: checked PLAYPAL/COLORMAP, wall patches and
// sector flats.  Sprite and UI readiness remain explicitly false rather than
// pretending that synthetic evidence contains the whole game catalog.
op doom_texture_load_map_bytes_world [wad, map] (
  => doom_texture_load_map_bytes_mode[wad, map, 0];
)

// Native path authority is confined to one measured whole-file acquisition;
// all catalog validation and composition then takes the same bytes path as
// WASM.  The file operation is unreachable when only the browser entry point
// above is rooted, so the reduced-authority target does not credit filesystem
// access merely because this source module also supports native Doom.
op doom_texture_load_map [path, map] (
  if (map\ok == 1) () else ( => map; )
  let file_bytes = size[path] with chaos { _ => 0 - 1 };
  if (file_bytes >= 12) () else (
    => map + { ok: 0, error: "textures: invalid WAD size" };
  )
  let wad = doom_texture_read_range[path, 0, file_bytes];
  if (bytes_len[wad] == file_bytes) () else (
    => map + { ok: 0, error: "textures: short WAD read" };
  )
  => doom_texture_load_map_bytes[wad, map];
)
